---
import { ViewTransitions } from 'astro:transitions'
// ONE header for the whole site. The bar used to be written out here AND again
// on the landing; the two drifted. Both now render this component.
import SiteHeader from '../components/SiteHeader.astro'

interface Props {
  title?: string
  description?: string
  ogImage?: string
}

const { title = 'Divya — Artist Portfolio', description = 'Portfolio of Divya — artist, maker, collaborator. A space for work and the people I create with.', ogImage } = Astro.props

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const siteUrl = 'https://divyatak.art'
const pathname = Astro.url.pathname
const canonicalUrl = `${siteUrl}${pathname}`
const ogImageUrl = ogImage ? `${siteUrl}${ogImage}` : `${siteUrl}/og-image.png`
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${base}/favicon-512.png`} sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- One family for the whole site, loaded once, in the head. The pages used to
         pull Sora in from their own body while this bar sat in Montserrat, which is
         why the shell read as a different site to the page under it. -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Divya Tak",
      "url": siteUrl,
      "jobTitle": "Multidisciplinary Creative",
      "sameAs": [
        "https://www.instagram.com/divyatakart/",
        "https://www.linkedin.com/in/divya-tak-56019522/",
        "https://divyatak.substack.com"
      ]
    })} />
    <ViewTransitions />
  </head>
  <body>
    <div class="layout">
      <a href="#main-content" class="skip-link">Skip to main content</a>
      <!-- transition:persist is declared inside the component, on its root
           element — Astro will not forward it from this tag. -->
      <SiteHeader variant="ink" />
      <main class="content" id="main-content">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  function initAnimations() {
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    // NOTE: the top bar used to run a first-visit entrance here. It added a class
    // and removed it inside the same requestAnimationFrame, so the stagger never
    // painted — all it ever left behind were transition-delays on the links (up to
    // 0.54s) and a transition list that overrode their hover colour. The bar is
    // wayfinding; it is present from the first frame now.

    // Scroll-triggered animations
    if (prefersReduced) {
      document.querySelectorAll('.animate-in').forEach(el => el.classList.add('visible'))
      return
    }

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return

        const el = entry.target

        // If this is a stagger parent, reveal children with stagger delays
        if (el.dataset.staggerChildren !== undefined) {
          const children = el.querySelectorAll('.animate-in:not(.visible)')
          const staggerMs = parseInt(el.dataset.staggerMs || '80')
          const cap = 6
          children.forEach((child, i) => {
            const delay = Math.min(i, cap - 1) * staggerMs
            child.style.setProperty('--enter-delay', `${delay}ms`)
            child.classList.add('visible')
          })
          if (el.classList.contains('animate-in')) {
            el.classList.add('visible')
          }
        } else {
          el.classList.add('visible')
        }

        observer.unobserve(el)
      })
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' })

    document.querySelectorAll('.animate-in').forEach(el => {
      // Don't observe children that will be stagger-revealed by their parent
      if (el.closest('[data-stagger-children]') && !el.hasAttribute('data-stagger-children')) return
      observer.observe(el)
    })

    // Also observe stagger parents that aren't .animate-in themselves
    document.querySelectorAll('[data-stagger-children]:not(.animate-in)').forEach(el => {
      observer.observe(el)
    })
  }

  // Update top bar active state on navigation
  function updateNavActive() {
    const path = window.location.pathname
    document.querySelectorAll('.nav-link').forEach(item => {
      const href = item.getAttribute('href') || ''
      const isActive = !href.startsWith('mailto:') && path.startsWith(href)
      item.classList.toggle('active', isActive)
      if (isActive) {
        item.setAttribute('aria-current', 'page')
      } else {
        item.removeAttribute('aria-current')
      }
    })
  }

  // Run on initial load
  initAnimations()

  // Re-run after Astro page transitions
  document.addEventListener('astro:after-swap', () => {
    updateNavActive()
    initAnimations()
  })
</script>

<style is:global>
  @import '../styles/global.css';
  @import '../styles/app.css';
</style>
