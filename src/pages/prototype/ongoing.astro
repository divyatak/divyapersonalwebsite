<!-- PROTOTYPE — canonical direction: "ongoing", type system C (grid-locked). Promote to real pages next. -->
---
// PROTOTYPE — landing rebuild after the design interview.
// Dark act = two snap screens over the fixed video. White act = the folio, free scroll.
// One name element travels from screen 1 into the slot on screen 2. One nav bar for the whole page.
// Works are read from the build pipeline (generated-projects.json) plus five entries that live outside it.

import generated from '../../data/generated-projects.json';

const isExt = (h) => typeof h === 'string' && h.indexOf('http') === 0;

/* ---------- buckets: derived from the pipeline's categories ---------- */
const ON_PAPER = ['comic', 'zine', 'illustration', 'photocomics'];
const bucketFor = (cats = []) => {
  if (cats.indexOf('game') !== -1) return 'games';
  if (cats.some((c) => ON_PAPER.indexOf(c) !== -1)) return 'on paper';
  return 'none'; // e.g. Mixed meanings (ai / conceptual) — visible under "all" only
};

// the pipeline groups by year, and buckets everything pre-2020 into a label:"earlier"
// group whose year is 0, so the real year comes off the cover path.
const yearOf = (p, group) => {
  const m = /\/projects\/(\d{4})\//.exec(p.cover || '');
  return m ? Number(m[1]) : group.year;
};

// credits are kept in the data but are NOT shown in the folio any more —
// they belong on the work detail pages.
const WITH_CHARU = [
  'ai-quit', 'boneyard', 'mark', 'misplaced', 'proximity', 'ruh-and-the-glow',
  'the-titli-effect',
];

const CURRENT_YEAR = 2026;

/* ---------- the five that are not in the pipeline ---------- */
const bazaar = 'https://everythingbazaar.netlify.app';
const flow = 'https://divyatak.github.io/creative-visuals/particles/';
const webcam = 'https://divyatak.github.io/creative-visuals/webcam/';
const lineBefore = 'https://divya.studiotypo.xyz';

const additions = [
  {
    id: 'metro-museum',
    title: 'Metro Museum of the Forgotten',
    year: 2026,
    status: 'in progress',
    bucket: 'games',
    img: '/clips/poster-7.jpg',
    alt: 'A 3D museum interior with mannequin figures at sunset, from the Metro Museum build',
    clip: '/clips/cut-7a.mp4',
    href: null,
    with: '',
  },
  {
    id: 'everything-bazaar',
    title: 'Everything Bazaar',
    year: 2026,
    status: 'ongoing',
    bucket: 'games',
    img: '/clips/poster-6.jpg',
    alt: 'A dark shop screen with a product box, from Everything Bazaar',
    clip: null,
    href: bazaar,
    with: '',
  },
  {
    id: 'bioluminescent-flow',
    title: 'Bioluminescent Flow',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/bioluminescent-flow.webp',
    alt: 'Glowing particle trails on a dark field, from Bioluminescent Flow',
    clip: '/clips/cut-2a.mp4',
    href: flow,
    with: '',
  },
  {
    id: 'webcam-magic',
    title: 'Webcam Magic',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/webcam-magic.webp',
    alt: 'A face rendered as a pixel mirror, from Webcam Magic',
    clip: '/clips/cut-1a.mp4',
    href: webcam,
    with: '',
  },
  {
    id: 'the-line-before',
    title: 'The Line Before',
    year: 2025,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/the-line-before.webp',
    alt: 'A scene from The Line Before',
    clip: null,
    href: lineBefore,
    with: 'with Kahran Singh',
  },
];

/* ---------- everything the pipeline knows about ---------- */
const fromPipeline = generated.flatMap((group) =>
  group.projects.map((p) => {
    const year = yearOf(p, group);
    return {
      id: p.slug,
      title: p.title,
      year,
      // only the current year's (un)seen edition is still being added to;
      // every earlier edition is closed, like everything else in the pipeline
      status:
        p.slug.indexOf('unseen') === 0 && year === CURRENT_YEAR ? 'ongoing' : 'finished',
      bucket: bucketFor(p.categories),
      img: p.cover,
      alt: `Cover image for ${p.title}`,
      clip: null,
      href: `/works/${p.slug}/`,
      with: WITH_CHARU.indexOf(p.slug) !== -1 ? 'with Charu' : '',
    };
  })
);

// newest first; the sort is stable, so the additions sit ahead of pipeline entries
// from the same year.
const works = [...additions, ...fromPipeline].sort((a, b) => b.year - a.year);

const navLinks = [
  { label: 'works', href: '#works' },
  { label: 'friends', href: '/friends/' },
  { label: 'about', href: '/about/' },
  { label: 'contact', href: 'mailto:hello@divyatak.art' },
];
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;700&display=swap" rel="stylesheet" />
<style>
  /* =====================================================================
     TYPE SYSTEM — GRID-LOCKED. Nothing on this page has a size or a space
     that isn't derived from one of three things: the columns, the mono
     ruler, or the rhythm unit. There are no round numbers left.

     ---------------------------------------------------------------------
     1. THE SEED.  --r = 1.5rem = 24px.
     It is the folio's column gap. It is also the row gap, the vertical
     rhythm unit, and exactly one line of body text. Every vertical space on
     the page is a multiple or a simple fraction of it, and every horizontal
     gap is it. The grid measures the same in both directions.

     2. THE COLUMNS.  Three of them, edge to edge, gutter --r, outer edge
     1.25×--r. The dark act has no measurements of its own — it borrows
     these, so the name, the intro, the reserved slot, the nav, the chapter
     word, the lenses, the captions and the footer all start on one of three
     vertical lines. You can feel where the tiles will be before an image
     has loaded.

     3. DISPLAY TYPE IS MEASURED IN COLUMNS. Three strings are sized so that
     their ink spans an exact number of columns — no rems involved:
         the name at rest   = 3 columns (the whole row)
         the name docked    = 1 column  (one tile)
         "works"            = 3 columns (a full row of type, where a row of
                                         tiles is about to be)
     so the name's journey is a division of the grid, not a shrink to an
     arbitrary size, and it pivots on column 1's left line, which it never
     leaves. The sizes come off the real ink runs, computed from the TTFs
     (advances + kerning − first glyph's left sidebearing − last glyph's
     right one + the letter-spacing between them):
         "divya tak"                  SG 700, ls -0.035em →  4.158 em
         "works"                      SG 400, ls -0.040em →  2.575 em
         "I make interactive things." SG 500, ls -0.020em → 11.534 em
     font-size = (the span it must fill) ÷ (that number). Each also carries a
     negative text-indent equal to its first glyph's left sidebearing (d .046,
     w .053, I .073) so the INK, not the invisible box, hangs on the line.
     Optical alignment is what makes a grid feel true rather than merely be
     true. Their line-heights (1, 0.98, 0.78) are ink crops, not rhythm
     multiples — display type hugs its own ink; only text stacks on a module.

     4. THE MONO RULER — CHARACTERS PER COLUMN. JetBrains Mono has a fixed
     0.600em advance, so a character is a unit of measurement and N of them
     fill a column at col ÷ (N × 0.6). Each role gets its own N, chosen for
     what it has to hold, and the ladder is the hierarchy:

         N = 50   tile titles      col/30      content, read as words
         N = 56   nav + wordmark   col/33.6    wayfinding
         N = 62   lenses, foot,    col/37.2    controls and the empty state
                  empty state
         N = 68   micro labels     col/40.8    lately · pause · more · cue
         N = 74   status lenses,   col/44.4    the quietest row on the page
                  separators

     Tracking runs inverse to the ruler — the smaller the step, the more air —
     and the uppercase micro labels take double, because caps set flush read
     as a lump. Every clamp keeps the ladder in order at every breakpoint.

     5. THE RHYTHM. Body: one line = --r exactly, so paragraphs stack on the
     24px module. Mono: one line = 0.75×--r, so four mono lines equal three
     body lines and the label layer interleaves with the reading layer instead
     of fighting it. The nav bar is three mono line-boxes tall. The tile's
     caption band is exactly 3×--r. Section paddings are 2, 3, 4 and 5 --r.
     ===================================================================== */

  :root {
    /* ---------- the seed ---------- */
    --r: 1.5rem;

    /* ---------- the grid ---------- */
    --gutter: var(--r);
    --edge: calc(var(--r) * 1.25);
    --span-all: calc(100vw - 2 * var(--edge));
    --col: calc((var(--span-all) - 2 * var(--gutter)) / 3);
    --span-2: calc(2 * var(--col) + var(--gutter));
    --dock-w: var(--col);              /* the name shrinks to exactly one column */
    --dock-gap: calc(var(--r) * 1.25); /* shared: the lately rule hangs off it too */

    /* ---------- display, measured in columns ---------- */
    --t-name:  calc(var(--span-all) / 4.158);
    --t-dock:  calc(var(--dock-w) / 4.158);
    --t-works: calc(var(--span-all) / 2.575);
    --t-lead:  calc(var(--span-2) / 11.534);

    /* ---------- the mono ruler: N characters to a column ---------- */
    --t-title: clamp(12px,   calc(var(--col) / 30),   16px);  /* N = 50 */
    --t-nav:   clamp(11px,   calc(var(--col) / 33.6), 14px);  /* N = 56 */
    --t-label: clamp(10.5px, calc(var(--col) / 37.2), 13px);  /* N = 62 */
    --t-micro: clamp(10px,   calc(var(--col) / 40.8), 12px);  /* N = 68 */
    --t-quiet: clamp(9.5px,  calc(var(--col) / 44.4), 11px);  /* N = 74 */

    /* ---------- reading ---------- */
    /* Sized against the column it sits in, leading locked to the module, and
       capped at a real measure. Space Grotesk averages ~0.465em per character
       in this copy, so 26em is ~56 characters — the line length the eye tracks
       without losing its return. Where the column is narrower than that the
       paragraph simply fills it; where it is wider, the measure governs and the
       column merely hosts. The left edge stays on the grid line either way. */
    --t-body: clamp(14px, calc(var(--col) / 28), 16px);
    --measure: 26em;
    --lh-body: var(--r);                 /* one body line  = one rhythm unit  */
    --lh-mono: calc(var(--r) * 0.75);    /* four mono lines = three body lines */

    --sans: 'Space Grotesk', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    /* the dark act snaps; the white folio has no snap points, so it scrolls free */
    scroll-snap-type: y proximity;
  }
  body {
    font-family: var(--sans);
    color: #222;
    background: #111;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  /* THE INSTRUMENT VOICE — one rule, everywhere the page labels itself.
     It also sets the mono line box, so every label, control and caption on the
     page stacks on the same 0.75×--r baseline. */
  .bar, .lens, .lens-row .sep, .lately .label, .entry h3, .motion-toggle,
  .more, .empty, .foot, .scroll-cue {
    font-family: var(--mono);
    line-height: var(--lh-mono);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  /* hairline mono over moving video blooms; hold the strokes thin */
  .bar, .lately .label, .motion-toggle, .scroll-cue, .intro, .name {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* ---------- the video layer: fixed, behind everything, never scrolls away ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #111 url('/clips/poster-2.jpg') center / cover no-repeat;
  }
  .backdrop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* the montage is uniform 1920x1080; cover keeps it honest anyway */
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .backdrop video.on { opacity: 1; }
  .backdrop .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.14) 42%, rgba(0,0,0,0.34) 100%);
  }

  /* ---------- one nav bar, hung on the same three columns ----------
     wordmark on column 1; the four links spread across columns 2–3 so the first
     opens exactly on column 2's line and the last closes on column 3's right.
     Padding is 0.75×--r top and bottom, which is the mono line box — so the bar
     is exactly three mono lines tall. */
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-items: baseline;
    padding: calc(var(--r) * 0.75) var(--edge);
    font-size: var(--t-nav);
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: lowercase;
    transition: background-color 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .bar .wordmark {
    grid-column: 1;
    font-size: var(--t-nav);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #fff;
    opacity: 1;
    transition: opacity 0.3s ease, color 0.25s ease;
  }
  /* on screen 1 the big name is the wordmark, so the bar keeps quiet */
  body:not(.docked) .bar .wordmark { opacity: 0; pointer-events: none; }
  .bar .links {
    grid-column: 2 / -1;
    display: flex;
    justify-content: space-between;
  }
  .bar a { color: rgba(255,255,255,0.72); transition: color 0.25s ease; }
  .bar a:hover { color: #fff; }
  /* once the white ground is under the bar, the bar turns to ink */
  .bar.ink {
    background: rgba(255,255,255,0.86);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: #eee;
  }
  .bar.ink .wordmark { color: #222; }
  .bar.ink a { color: #999; }
  .bar.ink a:hover { color: #222; }

  /* ---------- the one name: a full row of type that divides down to one column ----------
     The box is 100vw − 2×edge, which is what makes the morph script's centring
     maths ((innerWidth − width) / 2) land on --edge — column 1's line — so the
     name's left edge is nailed to that line for the whole flight and only the
     scale changes. Everything here is em-based, so it survives the scale. */
  .name {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2; /* above the stage, under the white ground */
    width: calc(100vw - 2 * var(--edge));
    white-space: nowrap;
    transform-origin: 0 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--t-name);
    line-height: 1;
    letter-spacing: -0.035em;
    text-indent: -0.046em;
    color: #fff;
    text-transform: lowercase;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }
  .name.ready { opacity: 1; }

  /* ---------- the stage: everything that sits over the video ---------- */
  .stage { position: relative; z-index: 1; }
  .stage a { color: #fff; }

  /* the dark act has no measurements of its own — it borrows the folio's */
  .shell {
    max-width: none;
    margin: 0;
    padding: 0 var(--edge);
  }
  .shell.narrow { max-width: none; }

  /* ---------- screen 1 ---------- */
  .opening {
    position: relative;
    height: 100vh;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-content: end;
    padding: 0 var(--edge) calc(var(--r) * 2);
  }
  /* the cue is not centred any more: it marks column 3's line, the last one the
     name reaches */
  .scroll-cue {
    grid-column: 3;
    justify-self: start;
    color: rgba(255,255,255,0.7);
    font-size: var(--t-micro);
    transition: opacity 0.3s ease;
  }
  .scroll-cue:hover { color: #fff; }
  body.docked .scroll-cue { opacity: 0; pointer-events: none; }

  /* ---------- screen 2: the docked name + the intro ---------- */
  .overlay {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--r) * 5) 0 calc(var(--r) * 4);
    scroll-snap-align: start;
    /* a measured, nowrap line's trailing sidebearing is a few px of empty space
       past the last grid line; clip it so it never becomes document scroll.
       clip (not hidden/auto) so no scroll container is created — and
       .video-chrome is a sibling, not a descendant, so stickiness is untouched. */
    overflow-x: clip;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.66) 20%,
      rgba(0,0,0,0.86) 55%,
      rgba(0,0,0,0.95) 100%
    );
  }
  /* the folio's three columns, borrowed whole: intro on 1–2, reserved slot on 3 */
  .intro-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-items: start;
    max-width: none;
  }
  /* the intro subdivides its two columns into the same two columns */
  .intro {
    grid-column: 1 / span 2;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--gutter);
    align-content: start;
    max-width: none;
    color: rgba(255,255,255,0.76);
    font-size: var(--t-body);
    line-height: var(--lh-body);
  }
  /* a nowrap measured line would otherwise force its own track wider than the
     column it is measured against — min-content must not win here */
  .intro > * { min-width: 0; }
  .intro p { margin-bottom: 0; }
  /* the reading paragraphs fill their column up to a 30em ceiling, so the measure
     holds near 56 characters instead of stretching with a very wide viewport */
  .intro > p:nth-of-type(3),
  .intro > p:nth-of-type(4),
  .intro > .coda { max-width: var(--measure); }

  /* name docks on column 1 · lead spans 1–2 · the two body paragraphs take one
     column each · the coda returns to column 1 */
  @media (min-width: 701px) {
    .intro > .name-slot        { grid-column: 1;      grid-row: 1; }
    .intro > .lead             { grid-column: 1 / -1; grid-row: 2; }
    .intro > p:nth-of-type(3)  { grid-column: 1;      grid-row: 3; }
    .intro > p:nth-of-type(4)  { grid-column: 2;      grid-row: 3; }
    .intro > .coda             { grid-column: 1;      grid-row: 4; }
  }

  /* ---------- the reserved slot: held space, on purpose ----------
     Column 3, and its rule starts exactly where the lead's line does, so the
     emptiness is obviously measured rather than missing. Its depth and its far
     hairline are both counted in rhythm units. */
  .lately {
    grid-column: 3;
    margin-top: calc(var(--t-dock) + var(--dock-gap));
    padding-top: calc(var(--r) * 0.5);
    min-height: calc(var(--r) * 13);
    border-top: 1px solid rgba(255,255,255,0.28);
  }
  .lately .label {
    display: block;
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }
  /* one hairline far below, one gutter wide — even the tick is a grid unit */
  .lately::after {
    content: '';
    display: block;
    width: var(--r);
    height: 1px;
    margin-top: calc(var(--r) * 8);
    background: rgba(255,255,255,0.16);
  }
  .intro a {
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.35);
  }
  .intro a:hover { border-bottom-color: #fff; }

  /* the slot the big name lands in — invisible, it only holds the position.
     TYPOGRAPHICALLY IDENTICAL to .name in every respect except size, which is
     the one thing the morph script is allowed to read as a difference. */
  .name-slot {
    font-family: var(--sans);
    font-size: var(--t-dock);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    text-indent: -0.046em;
    text-transform: lowercase;
    white-space: nowrap;
    visibility: hidden;
    margin-bottom: var(--dock-gap);
  }

  /* the human sentence, set to fill columns 1–2 exactly */
  .intro .lead {
    font-family: var(--sans);
    font-size: var(--t-lead);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-indent: -0.073em;
    white-space: nowrap;
    color: #fff;
    margin-bottom: calc(var(--r) * 1.5);
  }
  .intro .coda {
    margin-top: calc(var(--r) * 2);
    font-size: calc(var(--t-body) * 0.9);
    color: rgba(255,255,255,0.55);
  }

  /* ---------- video chrome: the only right-aligned thing, closing column 3 ---------- */
  .video-chrome {
    position: sticky;
    bottom: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0 var(--edge) var(--r);
    margin-top: calc(var(--r) * -2);
    pointer-events: none;
  }
  .video-chrome > * { pointer-events: auto; }
  .motion-toggle {
    background: none;
    color: rgba(255,255,255,0.6);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    padding: 0 0 calc(var(--r) / 8);
    cursor: pointer;
  }
  .motion-toggle:hover { color: #fff; border-bottom-color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .backdrop video { transition: none; }
    .scroll-cue, .tile, .tile .media video, .bar, .bar .wordmark { transition: none !important; }
  }

  /* ---------- solid ground: the folio slides over the video ---------- */
  .ground {
    position: relative;
    z-index: 2;
    background: #fff;
  }

  .works {
    padding: calc(var(--r) * 3) var(--edge) 0;
    scroll-margin-top: calc(var(--r) * 2.25); /* the bar is three mono lines tall */
    /* guard: a measured run's trailing sidebearing can sit a few px past the last
       grid line. clip, not scroll — and it never reaches the ink. */
    overflow-x: clip;
  }
  .works-head {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    padding-bottom: calc(var(--r) * 2);
  }
  /* a whole row of type where a whole row of tiles is about to be. Sized from the
     grid, weighted DOWN to 400 so it stays quieter than the name despite being
     larger — size comes from the columns, hierarchy from the weight. */
  .works-head h2 {
    grid-column: 1 / -1;
    font-family: var(--sans);
    font-size: var(--t-works);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.04em;
    text-indent: -0.053em;
    white-space: nowrap;
    text-transform: lowercase;
    color: #222;
  }

  /* ---------- lenses: two rows, opening on columns 1 and 2 ---------- */
  .lenses {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    /* the two rows are different sizes; they share a baseline, not a box top */
    align-items: baseline;
    margin-top: calc(var(--r) * 1.5);
  }
  .lens-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(var(--r) / 3);
  }
  .lens-row:first-child { grid-column: 1; }
  .lens-row.quiet { grid-column: 2; }
  .lens-row + .lens-row { margin-top: 0; }
  .lens {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.1em;
    color: #999;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 calc(var(--r) / 8);
    cursor: pointer;
  }
  .lens:hover { color: #222; }
  .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  /* a weight change costs zero width in a monospace, so the active state never
     shifts the row off its column line */
  .lens[aria-pressed="true"] { font-weight: 500; }
  .lens-row.quiet .lens { font-size: var(--t-quiet); letter-spacing: 0.12em; color: #bbb; }
  .lens-row.quiet .lens:hover { color: #636363; }
  .lens-row.quiet .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .lens-row .sep { color: #ddd; font-size: var(--t-quiet); }

  /* ---------- the grid: the only view. Gutter is the same in both axes. ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    column-gap: var(--gutter);
    row-gap: var(--gutter);
    padding-bottom: calc(var(--r) * 2);
  }
  .entry[hidden] { display: none; }

  .tile { position: relative; display: block; transition: transform 0.35s ease; }
  .entry:hover .tile, .entry:focus-within .tile {
    transform: translateY(calc(var(--r) / -6));
    transition-duration: 0.2s;
  }
  .tile .media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f4f4f4;
    box-shadow: 0 1px 8px rgba(0,0,0,0.10);
  }
  .tile .media img,
  .tile .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* nothing stretches, ever */
  }
  .tile .media video {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tile .media video.on { opacity: 1; transition-duration: 0.2s; }

  /* TITLE ↔ IMAGE: the title lives inside the frame, flush on the tile's own
     column line (padding-left 0 — deliberately asymmetric, because only the left
     edge is a grid line) and held off the right frame by one gutter. Title and
     image are one object, so every row is an unbroken band of 16:10.
     The band is exactly 3×--r tall: 1.75 ramp + one mono line (0.75) + 0.5 base.
     At N=50 the longest title in the set is one line at every breakpoint. */
  .entry h3 {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    padding: calc(var(--r) * 1.75) var(--r) calc(var(--r) * 0.5) 0;
    font-size: var(--t-title);
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    color: #fff;
    /* weighted for the palest covers in the set, where white mono on a bright
       frame is the hardest read */
    text-shadow: 0 1px 3px rgba(0,0,0,0.55);
    background: linear-gradient(
      to top,
      rgba(0,0,0,0.86) 0%,
      rgba(0,0,0,0.60) 30%,
      rgba(0,0,0,0.20) 64%,
      rgba(0,0,0,0) 100%
    );
  }
  .entry.seen h3::after { content: ' \00b7'; color: rgba(255,255,255,0.6); }

  /* ---------- nine at a time: opens on column 1, like the first tile ---------- */
  .more-wrap {
    text-align: left;
    padding-bottom: calc(var(--r) * 5);
  }
  .more {
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #bbb;
    background: none;
    border: none;
    border-bottom: 1px solid #eee;
    padding: 0 0 calc(var(--r) / 8);
    cursor: pointer;
  }
  .more:hover { color: #222; border-bottom-color: #222; }
  .more[hidden] { display: none; }

  .empty {
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    color: #999;
    padding: calc(var(--r) * 1.5) 0;
  }
  .empty[hidden] { display: none; }

  /* ---------- foot: three links, one per column — the grid's closing ruler ---------- */
  .foot {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    padding: 0 var(--edge) calc(var(--r) * 4);
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    color: #999;
  }
  .foot a { color: #999; }
  .foot a:hover { color: #222; }
  /* the separators were doing the grid's job; the columns do it better */
  .foot .dot { display: none; }

  /* ================= the grid narrows; the type narrows with it =================
     --r never changes, so the rhythm is constant at every width; only the
     columns (and therefore the ruler that reads them) redraw. */
  @media (max-width: 1100px) {
    :root {
      --col: calc((var(--span-all) - var(--gutter)) / 2);
      --span-2: var(--span-all);   /* the lead now fills the whole measure */
      --dock-w: var(--col);        /* still exactly one column */
    }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .bar { grid-template-columns: repeat(2, 1fr); }
    .opening { grid-template-columns: repeat(2, 1fr); }
    .scroll-cue { grid-column: 2; }
    .intro-cols { grid-template-columns: repeat(2, 1fr); }
    .intro { grid-column: 1 / -1; }
    .lately {
      grid-column: 1 / -1;
      margin-top: calc(var(--r) * 2.5);
      min-height: calc(var(--r) * 8);
    }
    .lately::after { margin-top: calc(var(--r) * 5); }
    .works-head, .lenses { grid-template-columns: repeat(2, 1fr); }
    .foot { grid-template-columns: repeat(2, 1fr); row-gap: calc(var(--r) * 0.5); }
  }

  @media (max-width: 900px) {
    :root { --edge: calc(var(--r) * 0.75); }
    html { scroll-snap-type: none; }
    .overlay { padding: calc(var(--r) * 4) 0 calc(var(--r) * 3); }
    .works { padding-top: calc(var(--r) * 2.5); }
  }

  @media (max-width: 700px) {
    :root {
      --col: var(--span-all);
      --span-2: var(--span-all);
      /* one column is now the whole width, so the dock is set as a fraction of it
         — otherwise the name would have nowhere to shrink to */
      --dock-w: calc(var(--span-all) * 0.42);
    }
    .grid { grid-template-columns: 1fr; }
    .bar { display: flex; gap: calc(var(--r) * 0.75); align-items: baseline; letter-spacing: 0.04em; }
    .bar .links { flex: 1; }
    .opening { grid-template-columns: 1fr; }
    .scroll-cue { grid-column: 1; }
    .intro-cols, .intro { grid-template-columns: 1fr; }
    .intro > p { grid-column: 1; }
    /* stacked now, so they need the module between them */
    .intro > p:nth-of-type(3), .intro > p:nth-of-type(4) { margin-bottom: var(--r); }
    .works-head, .lenses, .foot { grid-template-columns: 1fr; }
    .lens-row.quiet { grid-column: 1; margin-top: calc(var(--r) * 0.5); }
    .foot { row-gap: calc(var(--r) * 0.25); }
  }
</style>
</head>
<body>

  <!-- ============ the video, fixed behind everything ============ -->
  <div class="backdrop" aria-hidden="true">
    <video id="vid" muted playsinline loop preload="auto" poster="/clips/poster-2.jpg" src="/clips/montage.mp4"></video>
    <div class="scrim"></div>
  </div>

  <!-- ============ one nav bar, white over the video, ink over the folio ============ -->
  <header class="bar" id="bar">
    <a class="wordmark" href="/prototype/ongoing/">divya tak</a>
    <nav class="links" aria-label="site">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>

  <!-- ============ the name: one element, it becomes the docked title ============ -->
  <h1 class="name" id="name">divya tak</h1>

  <div class="stage">

    <!-- ============ screen 1 ============ -->
    <div class="opening" id="top">
      <a class="scroll-cue" href="#intro" aria-label="scroll down to the introduction">&#8595;</a>
    </div>

    <!-- ============ screen 2: docked name + intro ============ -->
    <section class="overlay" id="intro">
      <div class="shell narrow">
        <div class="intro-cols">
          <div class="intro">
            <!-- the slot the fixed name lands in; it holds space and nothing else -->
            <p class="name-slot" id="name-slot" aria-hidden="true">divya tak</p>
            <p class="lead">I make interactive things.</p>
            <p>Hi! Hello! I'm Divya. I am a cross domain creative human. I love making many things with many people.</p>
            <p>
              I run a storytelling studio called <a href="https://joyus.studio" target="_blank" rel="noopener">Joyus</a>
              with my friend <a href="https://kahransingh.com" target="_blank" rel="noopener">Kahran</a>.
              I make games with <a href="https://charutak.xyz" target="_blank" rel="noopener">Charu</a>.
              I often collaborate with <a href="https://varuns.work" target="_blank" rel="noopener">Varun Ramanna</a> on VFX projects.
            </p>
            <p class="coda">You are at the home of some of my creations.</p>
          </div>

          <!-- RESERVED SLOT — "lately / new stuff".
               The space is intentional and stays empty until its design exists.
               Do not fill this with a list, a feed, or placeholder content. -->
          <aside class="lately" aria-label="lately">
            <span class="label">lately</span>
          </aside>
        </div>
      </div>
    </section>

    <div class="video-chrome">
      <button class="motion-toggle" id="motion-toggle" aria-pressed="false" aria-label="pause background clips">pause</button>
    </div>
  </div>

  <!-- ============ the folio: white ground slides over the video ============ -->
  <main class="ground" id="ground">

    <section class="works" id="works" aria-label="works">
      <div class="works-head">
        <h2>works</h2>

        <div class="lenses">
          <div class="lens-row" role="group" aria-label="filter by kind">
            <button class="lens" data-bucket="all" aria-pressed="true">all</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="games" aria-pressed="false">games</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="interactive pieces" aria-pressed="false">interactive pieces</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="on paper" aria-pressed="false">on paper</button>
          </div>
          <div class="lens-row quiet" role="group" aria-label="filter by status">
            <button class="lens" data-status="latest" aria-pressed="true">latest</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="in progress" aria-pressed="false">in progress</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="ongoing" aria-pressed="false">ongoing</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="finished" aria-pressed="false">finished</button>
          </div>
        </div>
      </div>

      <!-- ---- the grid: image + title, nothing else ---- -->
      <div class="grid" id="grid">
        {works.map((w) => (
          <article class="entry" data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
            {w.href ? (
              <a
                class="tile"
                href={w.href}
                target={isExt(w.href) ? '_blank' : undefined}
                rel={isExt(w.href) ? 'noopener' : undefined}
              >
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </a>
            ) : (
              <div class="tile">
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </div>
            )}
          </article>
        ))}
      </div>

      <p class="empty" id="empty" hidden>nothing under this lens yet.</p>

      <div class="more-wrap">
        <button class="more" id="more" type="button" hidden>more</button>
      </div>
    </section>

    <footer class="foot">
      <a href="/friends/">friends</a><span class="dot" aria-hidden="true">&middot;</span>
      <a href="/about/">about</a><span class="dot" aria-hidden="true">&middot;</span>
      <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
    </footer>

  </main>

<script is:inline>
(function () {
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 12 cuts of 5.2s each, composed offline with ffmpeg at a uniform 1920x1080.
  // Kept here so anything that needs to reason about playback time still can.
  // Sources 5 and 6 no longer exist in /clips/, so they are not in the order.
  var order = ['2a','7a','1a','4a','8b','3a','2b','7b','1b','4b','8a','3b'];
  var MONTAGE_SECONDS = 62.4;
  var CUT = MONTAGE_SECONDS / order.length; // 5.2s

  var vid = document.getElementById('vid');
  var toggle = document.getElementById('motion-toggle');
  var paused = prefersReduced;
  var started = false;

  function start() {
    started = true;
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  function setToggleUi() {
    toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
    toggle.setAttribute('aria-label', paused ? 'play background clips' : 'pause background clips');
    toggle.textContent = paused ? 'play' : 'pause';
  }

  toggle.addEventListener('click', function () {
    paused = !paused;
    setToggleUi();
    if (paused) {
      vid.pause();
    } else if (!started) {
      start(); // reduced-motion visitors opt in here
    } else {
      vid.play().catch(function () {});
    }
  });

  setToggleUi();
  if (!prefersReduced) start();
  // under reduced motion nothing plays: the poster still shows via the
  // backdrop's CSS background and the untouched poster attribute.

  /* ---------- the name: ONE element travelling from screen 1 into its slot ----------
     Start = centred in the viewport at full size. End = the invisible .name-slot that
     sits above the intro lead. We measure both, then interpolate transform against
     scroll progress across the dark act. No crossfade, no second element.
     Because the name's box is exactly the grid's full span, "centred" resolves to
     column 1's left line, and the slot sits on that same line — the horizontal term
     cancels out and the name only ever changes size. */
  var nameEl = document.getElementById('name');
  var slotEl = document.getElementById('name-slot');
  var overlayEl = document.getElementById('intro');
  var groundEl = document.getElementById('ground');
  var barEl = document.getElementById('bar');

  var M = { x0: 0, y0: 0, x1: 0, yDoc: 0, s1: 0.2, end: 1 };
  var docked = null;
  var inked = null;

  function measure() {
    nameEl.style.transform = 'none';
    var nr = nameEl.getBoundingClientRect();       // left:0 / top:0, so this is its natural size
    var sr = slotEl.getBoundingClientRect();
    var nf = parseFloat(getComputedStyle(nameEl).fontSize) || 1;
    var sf = parseFloat(getComputedStyle(slotEl).fontSize) || 1;

    M.x0 = (window.innerWidth - nr.width) / 2;
    M.y0 = (window.innerHeight - nr.height) / 2;
    M.x1 = sr.left + (window.pageXOffset || 0);
    M.yDoc = sr.top + (window.pageYOffset || 0);   // the slot's position in the document
    M.s1 = sf / nf;                                // both use line-height 1, so top-left aligns
    // scroll distance between the two snap points, measured from the document
    M.end = Math.max(1, overlayEl.getBoundingClientRect().top + (window.pageYOffset || 0));
    paint();
    nameEl.classList.add('ready');
  }

  function paint() {
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    var p = y / M.end;
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    if (prefersReduced) p = p > 0.35 ? 1 : 0; // jump between states, never tween

    var tx = M.x0 + (M.x1 - M.x0) * p;
    var yEnd = M.yDoc - y;                    // where the slot is on screen right now
    var ty = M.y0 + (yEnd - M.y0) * p;        // past p=1 this tracks the slot, so it scrolls away
    var s = 1 + (M.s1 - 1) * p;
    nameEl.style.transform =
      'translate3d(' + tx.toFixed(2) + 'px,' + ty.toFixed(2) + 'px,0) scale(' + s.toFixed(4) + ')';

    var d = p > 0.5;
    if (d !== docked) { docked = d; document.body.classList.toggle('docked', d); }

    // the bar turns to ink once the white ground has slid under it
    var ink = groundEl.getBoundingClientRect().top <= barEl.offsetHeight;
    if (ink !== inked) { inked = ink; barEl.classList.toggle('ink', ink); }
  }

  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () { ticking = false; paint(); });
  }, { passive: true });

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(measure, 120);
  });

  measure();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  window.addEventListener('load', measure);

  /* ---------- wheel assist: the dark act's two screens snap decisively ----------
     CSS scroll-snap stays as the fallback; this just makes one gesture land. */
  var coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!prefersReduced && !coarse) {
    var lockUntil = 0;
    var THRESHOLD = 8;
    window.addEventListener('wheel', function (e) {
      if (e.ctrlKey) return;                       // pinch zoom
      var y = window.pageYOffset || 0;
      var end = M.end;
      if (y > end + 4) return;                     // in the folio: hands off
      var now = Date.now();
      if (now < lockUntil) { e.preventDefault(); return; } // swallow the tail of a gesture
      if (e.deltaY > THRESHOLD && y < end - 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: end, behavior: 'smooth' });
      } else if (e.deltaY < -THRESHOLD && y > 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }, { passive: false });
  }

  /* ---------- folio: lenses (bucket, status) + nine at a time ---------- */
  var bucketBtns = document.querySelectorAll('.lens[data-bucket]');
  var statusBtns = document.querySelectorAll('.lens[data-status]');
  var items = document.querySelectorAll('.entry');
  var emptyEl = document.getElementById('empty');
  var moreBtn = document.getElementById('more');
  var bucket = 'all';
  var status = 'latest';

  var PAGE = 9;
  var shown = PAGE;

  // keepPage=true when the visitor asked for more; any lens change starts over
  function apply(keepPage) {
    if (!keepPage) shown = PAGE;
    var matched = 0;
    items.forEach(function (el) {
      var bOk = bucket === 'all' || el.dataset.bucket === bucket;
      var sOk = status === 'latest' || el.dataset.status === status;
      var hit = bOk && sOk;
      if (hit) matched++;
      el.hidden = !(hit && matched <= shown);
    });
    emptyEl.hidden = matched > 0;
    moreBtn.hidden = matched <= shown; // no counts, it just goes quiet when done
  }

  bucketBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      bucket = b.dataset.bucket;
      bucketBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.bucket === bucket ? 'true' : 'false');
      });
      apply(false);
    });
  });

  statusBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      status = b.dataset.status;
      statusBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.status === status ? 'true' : 'false');
      });
      apply(false);
    });
  });

  moreBtn.addEventListener('click', function () {
    shown += PAGE;
    apply(true);
  });

  apply(false);

  /* ---------- hover footage: only where a real clip exists ---------- */
  if (!prefersReduced) {
    document.querySelectorAll('.tile .clip').forEach(function (v) {
      var tile = v.closest('.tile');
      function enter() {
        if (!v.src) v.src = v.dataset.src;
        v.classList.add('on');
        v.play().catch(function () {});
      }
      function leave() {
        v.classList.remove('on');
        v.pause();
        try { v.currentTime = 0; } catch (err) {}
      }
      tile.addEventListener('mouseenter', enter);
      tile.addEventListener('focusin', enter);
      tile.addEventListener('mouseleave', leave);
      tile.addEventListener('focusout', leave);
    });
  }

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  function mark(id) {
    if (seen.indexOf(id) === -1) {
      seen.push(id);
      try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
    }
    document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
      el.classList.add('seen');
    });
  }
  seen.forEach(mark);
  items.forEach(function (el) {
    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { mark(el.dataset.id); });
    });
  });
})();
</script>
</body>
</html>
