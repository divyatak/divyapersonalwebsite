---
// PROTOTYPE — landing rebuild after the design interview.
// Dark act = two snap screens over the fixed video. White act = the folio, free scroll.
// One name element travels from screen 1 into the slot on screen 2. One nav bar for the whole page.
// Works are read from the build pipeline (generated-projects.json) plus five entries that live outside it.

import generated from '../../data/generated-projects.json';

const isExt = (h) => typeof h === 'string' && h.indexOf('http') === 0;

/* ---------- buckets: derived from the pipeline's categories ---------- */
const ON_PAPER = ['comic', 'zine', 'illustration', 'photocomics'];
const bucketFor = (cats = []) => {
  if (cats.indexOf('game') !== -1) return 'games';
  if (cats.some((c) => ON_PAPER.indexOf(c) !== -1)) return 'comics';
  return 'none'; // e.g. Mixed meanings (ai / conceptual) — visible under "all" only
};

// the pipeline groups by year, and buckets everything pre-2020 into a label:"earlier"
// group whose year is 0, so the real year comes off the cover path.
const yearOf = (p, group) => {
  const m = /\/projects\/(\d{4})\//.exec(p.cover || '');
  return m ? Number(m[1]) : group.year;
};

// credits are kept in the data but are NOT shown in the folio any more —
// they belong on the work detail pages.
const WITH_CHARU = [
  'ai-quit', 'boneyard', 'mark', 'misplaced', 'proximity', 'ruh-and-the-glow',
  'the-titli-effect',
];

const CURRENT_YEAR = 2026;

/* ---------- the five that are not in the pipeline ---------- */
const bazaar = 'https://everythingbazaar.netlify.app';
const flow = 'https://divyatak.github.io/creative-visuals/particles/';
const webcam = 'https://divyatak.github.io/creative-visuals/webcam/';
const lineBefore = 'https://divya.studiotypo.xyz';

const additions = [
  {
    id: 'metro-museum',
    title: 'Metro Museum of the Forgotten',
    year: 2026,
    status: 'in progress',
    bucket: 'games',
    img: '/clips/poster-7.jpg',
    alt: 'A 3D museum interior with mannequin figures at sunset, from the Metro Museum build',
    clip: '/clips/cut-7a.mp4',
    href: null,
    with: '',
  },
  {
    id: 'everything-bazaar',
    title: 'Everything Bazaar',
    year: 2026,
    status: 'ongoing',
    bucket: 'games',
    img: '/clips/poster-6.jpg',
    alt: 'A dark shop screen with a product box, from Everything Bazaar',
    clip: null,
    href: bazaar,
    with: '',
  },
  {
    id: 'bioluminescent-flow',
    title: 'Bioluminescent Flow',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/bioluminescent-flow.webp',
    alt: 'Glowing particle trails on a dark field, from Bioluminescent Flow',
    clip: '/clips/cut-2a.mp4',
    href: flow,
    with: '',
  },
  {
    id: 'webcam-magic',
    title: 'Webcam Magic',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/webcam-magic.webp',
    alt: 'A face rendered as a pixel mirror, from Webcam Magic',
    clip: '/clips/cut-1a.mp4',
    href: webcam,
    with: '',
  },
  {
    id: 'the-line-before',
    title: 'The Line Before',
    year: 2025,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/the-line-before.webp',
    alt: 'A scene from The Line Before',
    clip: null,
    href: lineBefore,
    with: 'with Kahran Singh',
  },
];

/* ---------- everything the pipeline knows about ---------- */
const fromPipeline = generated.flatMap((group) =>
  group.projects.map((p) => {
    const year = yearOf(p, group);
    return {
      id: p.slug,
      title: p.title,
      year,
      // only the current year's (un)seen edition is still being added to;
      // every earlier edition is closed, like everything else in the pipeline
      status:
        p.slug.indexOf('unseen') === 0 && year === CURRENT_YEAR ? 'ongoing' : 'finished',
      bucket: bucketFor(p.categories),
      img: p.cover,
      alt: `Cover image for ${p.title}`,
      clip: null,
      href: `/works/${p.slug}/`,
      with: WITH_CHARU.indexOf(p.slug) !== -1 ? 'with Charu' : '',
    };
  })
);

// newest first; the sort is stable, so the additions sit ahead of pipeline entries
// from the same year.
const works = [...additions, ...fromPipeline].sort((a, b) => b.year - a.year);

const navLinks = [
  { label: 'works', href: '#works' },
  { label: 'friends', href: '/friends/' },
  { label: 'about', href: '/about/' },
  { label: 'contact', href: 'mailto:hello@divyatak.art' },
];
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- All eight picker candidates. Only the weights the page actually uses are
     requested: 400/500/700 for the voice faces, 400/500 for the label faces —
     except Space Mono (no 500 exists) and Fragment Mono (400 only), so those
     ask for 400 and let the browser resolve 500 down. When a pair is chosen for
     real, this collapses back to two families. -->
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Schibsted+Grotesk:wght@400;500;700&family=Instrument+Sans:wght@400;500;700&family=Sora:wght@400;500;700&family=JetBrains+Mono:wght@400;500&family=IBM+Plex+Mono:wght@400;500&family=Space+Mono&family=Fragment+Mono&display=swap" rel="stylesheet" />
<style>
  /* =====================================================================
     TYPE SYSTEM — GRID-LOCKED. Nothing on this page has a size or a space
     that isn't derived from one of three things: the columns, the mono
     ruler, or the rhythm unit. There are no round numbers left.

     ---------------------------------------------------------------------
     1. THE SEED.  --r = 1.5rem = 24px.
     It is the folio's column gap. It is also the row gap, the vertical
     rhythm unit, and exactly one line of body text. Every vertical space on
     the page is a multiple or a simple fraction of it, and every horizontal
     gap is it. The grid measures the same in both directions.

     2. THE COLUMNS.  Three of them, edge to edge, gutter --r, outer edge
     1.25×--r. The dark act has no measurements of its own — it borrows
     these, so the name, the intro, the lately card, the nav, the chapter
     word and the lenses all start on one of three vertical lines.

     3. TWO AXES, AND WHERE THEY CHANGE HANDS. Everything above the tiles
     hangs off the columns' LEFT lines. From the tiles down, the folio turns
     to the columns' CENTRE lines: the tile captions are centred under their
     covers, and the more control and the email follow the same axis to the
     bottom of the page. Both are grid lines — the folio just stops reading
     left-to-right and starts reading column-by-column, which is what a
     caption under a picture actually is.

     4. DISPLAY TYPE IS MEASURED IN COLUMNS. Three strings are sized so that
     their ink spans an exact number of columns — no rems involved:
         the name at rest   = 3 columns (the whole row)
         the name docked    = 1 column  (one tile)
         "works"            = 3 columns (a full row of type, where a row of
                                         tiles is about to be)
     ...plus the subtitle, which fills columns 1–2. So the name's journey is a
     division of the grid, not a shrink to an arbitrary size, and it pivots on
     column 1's left line, which it never leaves.

     The divisors are real ink runs computed from the TTFs (advances +
     kerning − first glyph's left sidebearing − last glyph's right one + the
     letter-spacing between them). Because the voice face is switchable, they
     are VARIABLES, and the picker rewrites the run and the sidebearing
     together — otherwise a font swap would silently break the column fit:

         face                name(700)      works(400)     subtitle(500)
         Space Grotesk       4.158 / .046   2.575 / .053   14.692 / .055
         Schibsted Grotesk   4.188 / .031   2.636 / .030   14.074 / .041
         Instrument Sans     3.998 / .024   2.518 / .028   13.976 / .043
         Sora                4.346 / .039   2.792 / .026   15.480 / .052

     font-size = (the span it must fill) ÷ (the run). The negative text-indent
     is the first glyph's left sidebearing, so the INK, not the invisible box,
     hangs on the line. Optical alignment is what makes a grid feel true
     rather than merely be true. Display line-heights (1, 1.02, 0.78) are ink
     crops, not rhythm multiples — display type hugs its own ink; only text
     stacks on a module.

     5. THE MONO RULER — CHARACTERS PER COLUMN. A monospace advance is a unit
     of measurement: N characters fill a column at col ÷ N ÷ advance. Each
     role gets its own N, chosen for what it has to hold, and the ladder is
     the hierarchy:

         N = 50   tile captions    content, read as words
         N = 56   nav + wordmark   wayfinding
         N = 62   lenses, email,   controls, the empty state, card identifiers
                  empty state
         N = 68   micro labels     lately · more · scroll cue · card sources
         N = 74   separators, dates

     CAREFUL: the four label candidates are NOT all 0.600em. JetBrains Mono
     and IBM Plex Mono are; Space Mono is 0.612 and Fragment Mono 0.618. So
     the advance is a variable too and the picker sets it — otherwise
     "62 characters to a column" would quietly become 60 on two of the four.
     Space Mono has no 500 weight and Fragment Mono ships 400 only, so on
     those two the wordmark and the active lens lose their weight step and
     lean on colour alone. Tracking runs inverse to the ruler — the smaller
     the step, the more air — and uppercase micro labels take double.

     6. THE RHYTHM. Body: one line = --r exactly, so paragraphs stack on the
     24px module. Mono: one line = 0.75×--r, so four mono lines equal three
     body lines. The nav bar is three mono line-boxes tall. Each tile reserves
     a caption band of exactly 1.5×--r — two mono lines — so a title that
     wraps can never knock its row out of alignment with the next.
     ===================================================================== */

  :root {
    /* ---------- the seed ---------- */
    --r: 1.5rem;

    /* ---------- the grid ---------- */
    --gutter: var(--r);
    --edge: calc(var(--r) * 1.25);
    --span-all: calc(100vw - 2 * var(--edge));
    --col: calc((var(--span-all) - 2 * var(--gutter)) / 3);
    --span-2: calc(2 * var(--col) + var(--gutter));
    --dock-w: var(--col);              /* the name shrinks to exactly one column */
    --dock-gap: calc(var(--r) * 1.25); /* shared: the lately rule hangs off it too */

    /* ---------- the voice face, and the metrics that belong to it ----------
       the picker rewrites all seven of these together */
    --sans: 'Space Grotesk', system-ui, sans-serif;
    --run-name: 4.158;   --ti-name: 0.046;
    --run-works: 2.575;  --ti-works: 0.053;
    --run-sub: 14.692;   --ti-sub: 0.055;

    /* ---------- the label face, and its advance ---------- */
    --mono: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', monospace;
    --mono-adv: 0.600;

    /* ---------- display, measured in columns ---------- */
    --t-name:  calc(var(--span-all) / var(--run-name));
    --t-dock:  calc(var(--dock-w) / var(--run-name));
    --t-works: calc(var(--span-all) / var(--run-works));
    --t-sub:   calc(var(--span-2) / var(--run-sub));

    /* ---------- the mono ruler: N characters to a column ---------- */
    --n-title: 50;
    --n-nav: 56;
    --n-label: 62;
    --n-micro: 68;
    --n-quiet: 74;
    --t-title: clamp(12px,   calc(var(--col) / var(--n-title) / var(--mono-adv)), 16px);
    --t-nav:   clamp(11px,   calc(var(--col) / var(--n-nav)   / var(--mono-adv)), 14px);
    --t-label: clamp(10.5px, calc(var(--col) / var(--n-label) / var(--mono-adv)), 13px);
    --t-micro: clamp(10px,   calc(var(--col) / var(--n-micro) / var(--mono-adv)), 12px);
    --t-quiet: clamp(9.5px,  calc(var(--col) / var(--n-quiet) / var(--mono-adv)), 11px);

    /* ---------- reading ----------
       Sized against the column it sits in, leading locked to the module, and
       capped at a real measure — 26em is ~51 characters, which is what this
       copy actually renders at, at every breakpoint. Where the column is
       narrower the paragraph fills it; where it is wider the measure governs
       and the column merely hosts. The left edge stays on the line either way. */
    --t-body: clamp(14px, calc(var(--col) / 28), 16px);
    --measure: 26em;
    --lh-body: var(--r);                 /* one body line  = one rhythm unit  */
    --lh-mono: calc(var(--r) * 0.75);    /* four mono lines = three body lines */
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    /* the dark act snaps; the white folio has no snap points, so it scrolls free */
    scroll-snap-type: y proximity;
  }
  body {
    font-family: var(--sans);
    color: #222;
    background: #111;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  /* THE INSTRUMENT VOICE — one rule, everywhere the page labels itself.
     It also sets the mono line box, so every label, control and caption on the
     page stacks on the same 0.75×--r baseline. */
  .bar, .lens, .lens-row .sep, .lately .label, .entry h3,
  .more, .empty, .foot, .scroll-cue,
  .card .src, .card .card-date, .card .repo, .card .commit {
    font-family: var(--mono);
    line-height: var(--lh-mono);
    font-variant-numeric: tabular-nums;
    font-feature-settings: 'tnum' 1;
  }
  /* hairline mono over moving video blooms; hold the strokes thin */
  .bar, .lately, .scroll-cue, .intro, .name {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* ---------- the video layer: fixed, behind everything, never scrolls away ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #111 url('/clips/poster-2.jpg') center / cover no-repeat;
  }
  .backdrop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* the montage is uniform 1920x1080; cover keeps it honest anyway */
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .backdrop video.on { opacity: 1; }
  .backdrop .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.14) 42%, rgba(0,0,0,0.34) 100%);
  }

  /* ---------- one nav bar, hung on the same three columns ----------
     wordmark on column 1; the four links spread across columns 2–3 so the first
     opens exactly on column 2's line and the last closes on column 3's right.
     Padding is 0.75×--r top and bottom, which is the mono line box — so the bar
     is exactly three mono lines tall. */
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-items: baseline;
    padding: calc(var(--r) * 0.75) var(--edge);
    font-size: var(--t-nav);
    font-weight: 400;
    letter-spacing: 0.09em;
    text-transform: lowercase;
    transition: background-color 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  .bar .wordmark {
    grid-column: 1;
    font-size: var(--t-nav);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: #fff;
    opacity: 1;
    transition: opacity 0.3s ease, color 0.25s ease;
  }
  /* on screen 1 the big name is the wordmark, so the bar keeps quiet */
  body:not(.docked) .bar .wordmark { opacity: 0; pointer-events: none; }
  .bar .links {
    grid-column: 2 / -1;
    display: flex;
    justify-content: space-between;
  }
  .bar a { color: rgba(255,255,255,0.72); transition: color 0.25s ease; }
  .bar a:hover { color: #fff; }
  /* once the white ground is under the bar, the bar turns to ink */
  .bar.ink {
    background: rgba(255,255,255,0.86);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: #eee;
  }
  .bar.ink .wordmark { color: #222; }
  .bar.ink a { color: #999; }
  .bar.ink a:hover { color: #222; }

  /* ---------- the one name: a full row of type that divides down to one column ----------
     The box is 100vw − 2×edge, which is what makes the morph script's centring
     maths ((innerWidth − width) / 2) land on --edge — column 1's line — so the
     name's left edge is nailed to that line for the whole flight and only the
     scale changes. Everything here is em-based, so it survives the scale. */
  .name {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2; /* above the stage, under the white ground */
    width: calc(100vw - 2 * var(--edge));
    white-space: nowrap;
    transform-origin: 0 0;
    font-family: var(--sans);
    font-weight: 700;
    font-size: var(--t-name);
    line-height: 1;
    letter-spacing: -0.035em;
    text-indent: calc(var(--ti-name) * -1em);
    color: #fff;
    text-transform: lowercase;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }
  .name.ready { opacity: 1; }

  /* ---------- the stage: everything that sits over the video ---------- */
  .stage { position: relative; z-index: 1; }
  .stage a { color: #fff; }

  /* the dark act has no measurements of its own — it borrows the folio's */
  .shell {
    max-width: none;
    margin: 0;
    padding: 0 var(--edge);
  }
  .shell.narrow { max-width: none; }

  /* ---------- screen 1 ---------- */
  .opening {
    position: relative;
    height: 100vh;
    scroll-snap-align: start;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-content: end;
    padding: 0 var(--edge) calc(var(--r) * 2);
  }
  /* the cue is not centred: it marks column 3's line, the last one the name reaches */
  .scroll-cue {
    grid-column: 3;
    justify-self: start;
    color: rgba(255,255,255,0.7);
    font-size: var(--t-micro);
    transition: opacity 0.3s ease;
  }
  .scroll-cue:hover { color: #fff; }
  body.docked .scroll-cue { opacity: 0; pointer-events: none; }

  /* ---------- screen 2: the docked name + the intro ---------- */
  .overlay {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--r) * 5) 0 calc(var(--r) * 4);
    scroll-snap-align: start;
    /* a measured, nowrap line's trailing sidebearing is a few px of empty space
       past the last grid line; clip it so it never becomes document scroll.
       clip (not hidden/auto) so no scroll container is created. */
    overflow-x: clip;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.66) 20%,
      rgba(0,0,0,0.86) 55%,
      rgba(0,0,0,0.95) 100%
    );
  }
  /* the folio's three columns, borrowed whole: intro on 1–2, lately on 3 */
  .intro-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-items: start;
    max-width: none;
  }
  /* the intro subdivides its two columns into the same two columns */
  .intro {
    grid-column: 1 / span 2;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--gutter);
    align-content: start;
    max-width: none;
    color: rgba(255,255,255,0.76);
    font-size: var(--t-body);
    line-height: var(--lh-body);
  }
  /* a nowrap measured line would otherwise force its own track wider than the
     column it is measured against — min-content must not win here */
  .intro > * { min-width: 0; }
  .intro p { margin-bottom: 0; }
  .intro > p:nth-of-type(3),
  .intro > p:nth-of-type(4) { max-width: var(--measure); }

  /* name docks on column 1 · subtitle spans 1–2 · the two body paragraphs take
     one column each */
  @media (min-width: 701px) {
    .intro > .name-slot        { grid-column: 1;      grid-row: 1; }
    .intro > .subtitle         { grid-column: 1 / -1; grid-row: 2; }
    .intro > p:nth-of-type(3)  { grid-column: 1;      grid-row: 3; }
    .intro > p:nth-of-type(4)  { grid-column: 2;      grid-row: 3; }
  }

  /* the slot the big name lands in — invisible, it only holds the position.
     TYPOGRAPHICALLY IDENTICAL to .name in every respect except size, which is
     the one thing the morph script is allowed to read as a difference. */
  .name-slot {
    font-family: var(--sans);
    font-size: var(--t-dock);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    text-indent: calc(var(--ti-name) * -1em);
    text-transform: lowercase;
    white-space: nowrap;
    visibility: hidden;
    margin-bottom: var(--dock-gap);
  }

  /* the claim, set to fill columns 1–2 exactly — one rank under the docked name */
  .intro .subtitle {
    font-family: var(--sans);
    font-size: var(--t-sub);
    font-weight: 500;
    line-height: 1.02;
    letter-spacing: -0.02em;
    text-indent: calc(var(--ti-sub) * -1em);
    white-space: nowrap;
    color: #fff;
    margin-bottom: calc(var(--r) * 1.5);
  }

  .intro a {
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.35);
  }
  .intro a:hover { border-bottom-color: #fff; }

  /* ---------- the lately slot: column 3, one living update ----------
     The rule starts exactly where the subtitle's line does. Depth is fixed at
     10×--r so switching sources never shifts the column. */
  .lately {
    grid-column: 3;
    margin-top: calc(var(--t-dock) + var(--dock-gap));
    padding-top: calc(var(--r) * 0.5);
    min-height: calc(var(--r) * 10);
    border-top: 1px solid rgba(255,255,255,0.28);
  }
  .lately .label {
    display: block;
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.5);
  }

  /* one card, never a feed. The three sources differ in WHICH VOICE carries the
     payload, which is the whole question: an essay speaks in the voice face, a
     commit speaks in the label face, a photograph barely speaks at all. */
  .card { margin-top: calc(var(--r) * 1.5); }
  .card[hidden] { display: none; }
  .card .src {
    display: block;
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.42);
    margin-bottom: calc(var(--r) * 0.75);
  }
  .card .src em { font-style: normal; color: rgba(255,255,255,0.22); }
  .card .card-date {
    display: block;
    font-size: var(--t-quiet);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.35);
  }
  /* SUBSTACK — an essay, so the title takes the voice face and the largest rank
     in the card */
  .card .card-title {
    font-family: var(--sans);
    font-size: calc(var(--t-body) * 1.35);
    font-weight: 500;
    line-height: calc(var(--r) * 1.25);
    letter-spacing: -0.01em;
    color: #fff;
    margin-bottom: calc(var(--r) * 0.5);
  }
  .card .card-line {
    font-size: calc(var(--t-body) * 0.9);
    line-height: var(--lh-body);
    color: rgba(255,255,255,0.6);
    margin-bottom: calc(var(--r) * 0.75);
    max-width: var(--measure);
  }
  /* GITHUB — a repo and a commit subject are identifiers, not prose, so the card
     stays in the label face throughout and reads as instrumentation */
  .card .repo {
    font-size: var(--t-label);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: #fff;
    margin-bottom: calc(var(--r) * 0.25);
  }
  .card .commit {
    font-size: var(--t-label);
    letter-spacing: 0.04em;
    color: rgba(255,255,255,0.6);
    margin-bottom: calc(var(--r) * 0.75);
  }
  /* the activity count folds into the date readout so the whole github card
     stays in the label face — nothing here is prose, so nothing takes the voice */
  /* INSTAGRAM — the picture is the payload; type gets out of the way and runs
     beside it. The thumbnail is 5×--r square, so it sits on the rhythm too. */
  .card .shot {
    display: flex;
    gap: var(--r);
    align-items: flex-start;
  }
  .card .shot img {
    flex: none;
    width: calc(var(--r) * 5);
    height: calc(var(--r) * 5);
    object-fit: cover;
  }
  .card .shot .card-line { margin-bottom: calc(var(--r) * 0.5); }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .backdrop video { transition: none; }
    .scroll-cue, .tile, .tile .media video, .bar, .bar .wordmark { transition: none !important; }
  }

  /* ---------- solid ground: the folio slides over the video ---------- */
  .ground {
    position: relative;
    z-index: 2;
    background: #fff;
  }

  .works {
    padding: calc(var(--r) * 3) var(--edge) 0;
    scroll-margin-top: calc(var(--r) * 2.25); /* the bar is three mono lines tall */
    /* guard: a measured run's trailing sidebearing can sit a few px past the last
       grid line. clip, not scroll — and it never reaches the ink. */
    overflow-x: clip;
  }
  .works-head {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    padding-bottom: calc(var(--r) * 2);
  }
  /* a whole row of type where a whole row of tiles is about to be. Sized from the
     grid, weighted DOWN to 400 so it stays quieter than the name despite being
     larger — size comes from the columns, hierarchy from the weight. */
  .works-head h2 {
    grid-column: 1 / -1;
    font-family: var(--sans);
    font-size: var(--t-works);
    font-weight: 400;
    line-height: 0.78;
    letter-spacing: -0.04em;
    text-indent: calc(var(--ti-works) * -1em);
    white-space: nowrap;
    text-transform: lowercase;
    color: #222;
  }

  /* ---------- lenses: buckets open on column 1's line, status closes on
       column 3's right. One size for both rows — the quiet row stays quiet on
       colour alone, so the two share a baseline and a step. ---------- */
  .lenses {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: calc(var(--r) * 0.5) var(--r);
    margin-top: calc(var(--r) * 1.5);
  }
  .lens-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: calc(var(--r) / 3);
  }
  .lens-row.quiet { justify-content: flex-end; }
  .lens {
    font-family: var(--mono);
    font-size: var(--t-label);
    font-weight: 400;
    text-transform: lowercase;
    letter-spacing: 0.1em;
    color: #999;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 calc(var(--r) / 8);
    cursor: pointer;
  }
  .lens:hover { color: #222; }
  .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  /* a weight change costs zero width in a monospace, so the active state never
     shifts the row off its line (Space Mono / Fragment Mono have no 500 — there
     the colour and the rule carry it alone) */
  .lens[aria-pressed="true"] { font-weight: 500; }
  .lens-row.quiet .lens { color: #bbb; }
  .lens-row.quiet .lens:hover { color: #636363; }
  .lens-row.quiet .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .lens-row .sep { color: #ddd; font-size: var(--t-quiet); }

  /* ---------- the grid: the only view. Gutter is the same in both axes. ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    column-gap: var(--gutter);
    row-gap: var(--gutter);
    padding-bottom: calc(var(--r) * 2);
  }
  .entry[hidden] { display: none; }

  .tile { display: block; transition: transform 0.35s ease; }
  .entry:hover .tile, .entry:focus-within .tile {
    transform: translateY(calc(var(--r) / -6));
    transition-duration: 0.2s;
  }
  .tile .media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f4f4f4;
    box-shadow: 0 1px 8px rgba(0,0,0,0.10);
  }
  .tile .media img,
  .tile .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* nothing stretches, ever */
  }
  .tile .media video {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tile .media video.on { opacity: 1; transition-duration: 0.2s; }

  /* CAPTION UNDER THE COVER, centred on the column's centre line. The band is
     reserved at 1.5×--r — two mono lines — so a title that wraps cannot knock
     its row out of step with the row beneath. 0.75×--r of air above it, which
     is one mono line, so the caption sits a line clear of its picture. */
  .entry h3 {
    margin-top: calc(var(--r) * 0.75);
    min-height: calc(var(--r) * 1.5);
    text-align: center;
    font-size: var(--t-title);
    font-weight: 400;
    letter-spacing: 0.01em;
    text-transform: lowercase;
    color: #222;
  }
  .entry.seen h3::after { content: ' \00b7'; color: #ccc; }

  /* ---------- nine at a time — on the same centre axis as the captions ---------- */
  .more-wrap {
    text-align: center;
    padding-bottom: calc(var(--r) * 4);
  }
  .more {
    font-family: var(--mono);
    font-size: var(--t-micro);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #bbb;
    background: none;
    border: none;
    border-bottom: 1px solid #eee;
    padding: 0 0 calc(var(--r) / 8);
    cursor: pointer;
  }
  .more:hover { color: #222; border-bottom-color: #222; }
  .more[hidden] { display: none; }

  .empty {
    text-align: center;
    font-size: var(--t-label);
    letter-spacing: 0.06em;
    color: #999;
    padding: calc(var(--r) * 1.5) 0;
  }
  .empty[hidden] { display: none; }

  /* ---------- foot: one line, the quiet end of the centre axis ---------- */
  .foot {
    text-align: center;
    padding: 0 var(--edge) calc(var(--r) * 5);
    font-size: var(--t-label);
    letter-spacing: 0.1em;
    color: #bbb;
  }
  .foot a { color: #bbb; transition: color 0.25s ease; }
  .foot a:hover { color: #222; }

  /* ================= the grid narrows; the type narrows with it =================
     --r never changes, so the rhythm is constant at every width; only the
     columns (and therefore the ruler that reads them) redraw. */
  @media (max-width: 1100px) {
    :root {
      --col: calc((var(--span-all) - var(--gutter)) / 2);
      --span-2: var(--span-all);   /* the subtitle now fills the whole measure */
      --dock-w: var(--col);        /* still exactly one column */
    }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .bar { grid-template-columns: repeat(2, 1fr); }
    .opening { grid-template-columns: repeat(2, 1fr); }
    .scroll-cue { grid-column: 2; }
    .intro-cols { grid-template-columns: repeat(2, 1fr); }
    .intro { grid-column: 1 / -1; }
    .lately {
      grid-column: 1 / -1;
      margin-top: calc(var(--r) * 2.5);
      min-height: 0;
    }
    .works-head { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    :root { --edge: calc(var(--r) * 0.75); }
    html { scroll-snap-type: none; }
    .overlay { padding: calc(var(--r) * 4) 0 calc(var(--r) * 3); }
    .works { padding-top: calc(var(--r) * 2.5); }
  }

  @media (max-width: 700px) {
    :root {
      --col: var(--span-all);
      --span-2: var(--span-all);
      /* one column is now the whole width, so the dock is set as a fraction of it
         — otherwise the name would have nowhere to shrink to */
      --dock-w: calc(var(--span-all) * 0.42);
    }
    .grid { grid-template-columns: 1fr; }
    .bar { display: flex; gap: calc(var(--r) * 0.75); align-items: baseline; letter-spacing: 0.04em; }
    .bar .links { flex: 1; }
    .opening { grid-template-columns: 1fr; }
    .scroll-cue { grid-column: 1; }
    .intro-cols, .intro { grid-template-columns: 1fr; }
    .intro > p { grid-column: 1; }
    /* stacked now, so they need the module between them */
    .intro > p:nth-of-type(3) { margin-bottom: var(--r); }
    .works-head { grid-template-columns: 1fr; }
    /* the two lens rows stop being ends of a line and become a stack */
    .lenses { justify-content: flex-start; }
    .lens-row.quiet { justify-content: flex-start; }
  }

  /* =====================================================================
     TOOLING ONLY — the three pickers. Not part of the design: fixed to the
     bottom-left in a system monospace so they can never be mistaken for it.
     ===================================================================== */
  .proto-tools {
    position: fixed;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 99;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    font-family: ui-monospace, 'SFMono-Regular', Menlo, monospace;
    font-size: 11px;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
  }
  .proto-tools .pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: #111;
    color: #fff;
    box-shadow: 0 1px 6px rgba(0,0,0,0.35);
  }
  .proto-tools .k { color: rgba(255,255,255,0.35); }
  .proto-tools button {
    font: inherit;
    background: none;
    border: none;
    padding: 0;
    color: rgba(255,255,255,0.55);
    cursor: pointer;
  }
  .proto-tools button:hover { color: #fff; }
  .proto-tools button[aria-pressed="true"] { color: #fff; font-weight: 700; }
  .proto-tools .d { color: rgba(255,255,255,0.2); }
</style>
</head>
<body>

  <!-- ============ the video, fixed behind everything ============ -->
  <div class="backdrop" aria-hidden="true">
    <video id="vid" muted playsinline loop preload="auto" poster="/clips/poster-2.jpg" src="/clips/montage.mp4"></video>
    <div class="scrim"></div>
  </div>

  <!-- ============ one nav bar, white over the video, ink over the folio ============ -->
  <header class="bar" id="bar">
    <a class="wordmark" href="/prototype/ongoing/">divya tak</a>
    <nav class="links" aria-label="site">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>

  <!-- ============ the name: one element, it becomes the docked title ============ -->
  <h1 class="name" id="name">divya tak</h1>

  <div class="stage">

    <!-- ============ screen 1 ============ -->
    <div class="opening" id="top">
      <a class="scroll-cue" href="#intro" aria-label="scroll down to the introduction">&#8595;</a>
    </div>

    <!-- ============ screen 2: docked name + intro ============ -->
    <section class="overlay" id="intro">
      <div class="shell narrow">
        <div class="intro-cols">
          <div class="intro">
            <!-- the slot the fixed name lands in; it holds space and nothing else -->
            <p class="name-slot" id="name-slot" aria-hidden="true">divya tak</p>
            <p class="subtitle">Creative technologist and artist</p>
            <p>Hi! Hello! I'm Divya. I am a cross domain creative human. I love making many things with many people.</p>
            <p>
              I run a storytelling studio called <a href="https://joyus.studio" target="_blank" rel="noopener">Joyus</a>
              with my friend <a href="https://kahransingh.com" target="_blank" rel="noopener">Kahran</a>.
              I make games with <a href="https://charutak.xyz" target="_blank" rel="noopener">Charu</a>.
              I often collaborate with <a href="https://varuns.work" target="_blank" rel="noopener">Varun Ramanna</a> on VFX projects.
            </p>
          </div>

          <!-- LATELY — three mocked update cards, one visible at a time, switched
               from the tooling picker. All content is SAMPLE: the "mock" tag on
               each source label says so on the page itself. -->
          <aside class="lately" aria-label="lately">
            <span class="label">lately</span>

            <article class="card" id="card-substack" data-card="substack">
              <span class="src">substack <em>&middot; mock</em></span>
              <p class="card-title">notes from the metro museum build</p>
              <p class="card-line">On drawing a station that never existed, and why the fog had to arrive before the light did.</p>
              <span class="card-date">09 aug 2026</span>
            </article>

            <article class="card" id="card-github" data-card="github" hidden>
              <span class="src">github <em>&middot; mock</em></span>
              <p class="repo">divyatak/metro-museum</p>
              <p class="commit">art direction sandbox: fog and light pass</p>
              <span class="card-date">7 commits this week &middot; 11 aug 2026</span>
            </article>

            <article class="card" id="card-insta" data-card="insta" hidden>
              <span class="src">instagram <em>&middot; mock</em></span>
              <div class="shot">
                <img src="/playground/lenticular.webp" alt="A lenticular print test, sample image standing in for a recent post" width="240" height="240" loading="lazy" />
                <div class="shot-text">
                  <p class="card-line">lenticular tests, finally behaving themselves</p>
                  <span class="card-date">06 aug 2026</span>
                </div>
              </div>
            </article>
          </aside>
        </div>
      </div>
    </section>
  </div>

  <!-- ============ the folio: white ground slides over the video ============ -->
  <main class="ground" id="ground">

    <section class="works" id="works" aria-label="works">
      <div class="works-head">
        <h2>works</h2>

        <div class="lenses">
          <div class="lens-row" role="group" aria-label="filter by kind">
            <button class="lens" data-bucket="all" aria-pressed="true">all</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="games" aria-pressed="false">games</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="interactive pieces" aria-pressed="false">interactive pieces</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="comics" aria-pressed="false">comics</button>
          </div>
          <div class="lens-row quiet" role="group" aria-label="filter by status">
            <button class="lens" data-status="latest" aria-pressed="true">latest</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="in progress" aria-pressed="false">in progress</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="ongoing" aria-pressed="false">ongoing</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="finished" aria-pressed="false">finished</button>
          </div>
        </div>
      </div>

      <!-- ---- the grid: image + caption, nothing else ---- -->
      <div class="grid" id="grid">
        {works.map((w) => (
          <article class="entry" data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
            {w.href ? (
              <a
                class="tile"
                href={w.href}
                target={isExt(w.href) ? '_blank' : undefined}
                rel={isExt(w.href) ? 'noopener' : undefined}
              >
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </a>
            ) : (
              <div class="tile">
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </div>
            )}
          </article>
        ))}
      </div>

      <p class="empty" id="empty" hidden>nothing under this lens yet.</p>

      <div class="more-wrap">
        <button class="more" id="more" type="button" hidden>more</button>
      </div>
    </section>

    <footer class="foot">
      <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
    </footer>

  </main>

  <!-- ============ tooling only — face and lately pickers ============ -->
  <div class="proto-tools" id="tools">
    <div class="pill" id="pick-voice">
      <span class="k">voice</span>
      <button type="button" data-voice="Space Grotesk" aria-pressed="true">grotesk</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-voice="Schibsted Grotesk" aria-pressed="false">schibsted</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-voice="Instrument Sans" aria-pressed="false">instrument</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-voice="Sora" aria-pressed="false">sora</button>
    </div>
    <div class="pill" id="pick-label">
      <span class="k">label</span>
      <button type="button" data-label="JetBrains Mono" aria-pressed="true">jetbrains</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-label="IBM Plex Mono" aria-pressed="false">plex</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-label="Space Mono" aria-pressed="false">spacemono</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-label="Fragment Mono" aria-pressed="false">fragment</button>
    </div>
    <div class="pill" id="pick-lately">
      <span class="k">lately</span>
      <button type="button" data-lately="substack" aria-pressed="true">substack</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-lately="github" aria-pressed="false">github</button><span class="d" aria-hidden="true">&middot;</span>
      <button type="button" data-lately="insta" aria-pressed="false">insta</button>
    </div>
  </div>

<script is:inline>
(function () {
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 12 cuts of 5.2s each, composed offline with ffmpeg at a uniform 1920x1080.
  // Kept here so anything that needs to reason about playback time still can.
  // Sources 5 and 6 no longer exist in /clips/, so they are not in the order.
  var order = ['2a','7a','1a','4a','8b','3a','2b','7b','1b','4b','8a','3b'];
  var MONTAGE_SECONDS = 62.4;
  var CUT = MONTAGE_SECONDS / order.length; // 5.2s

  var vid = document.getElementById('vid');

  // Under reduced motion nothing plays and nothing is offered: the poster still
  // shows, via the backdrop's CSS background and the untouched poster attribute.
  if (!prefersReduced) {
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  /* ---------- the name: ONE element travelling from screen 1 into its slot ----------
     Start = centred in the viewport at full size. End = the invisible .name-slot that
     sits above the intro subtitle. We measure both, then interpolate transform against
     scroll progress across the dark act. No crossfade, no second element.
     Because the name's box is exactly the grid's full span, "centred" resolves to
     column 1's left line, and the slot sits on that same line — the horizontal term
     cancels out and the name only ever changes size. */
  var nameEl = document.getElementById('name');
  var slotEl = document.getElementById('name-slot');
  var overlayEl = document.getElementById('intro');
  var groundEl = document.getElementById('ground');
  var barEl = document.getElementById('bar');

  var M = { x0: 0, y0: 0, x1: 0, yDoc: 0, s1: 0.2, end: 1 };
  var docked = null;
  var inked = null;

  function measure() {
    nameEl.style.transform = 'none';
    var nr = nameEl.getBoundingClientRect();       // left:0 / top:0, so this is its natural size
    var sr = slotEl.getBoundingClientRect();
    var nf = parseFloat(getComputedStyle(nameEl).fontSize) || 1;
    var sf = parseFloat(getComputedStyle(slotEl).fontSize) || 1;

    M.x0 = (window.innerWidth - nr.width) / 2;
    M.y0 = (window.innerHeight - nr.height) / 2;
    M.x1 = sr.left + (window.pageXOffset || 0);
    M.yDoc = sr.top + (window.pageYOffset || 0);   // the slot's position in the document
    M.s1 = sf / nf;                                // both use line-height 1, so top-left aligns
    // scroll distance between the two snap points, measured from the document
    M.end = Math.max(1, overlayEl.getBoundingClientRect().top + (window.pageYOffset || 0));
    paint();
    nameEl.classList.add('ready');
  }

  function paint() {
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    var p = y / M.end;
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    if (prefersReduced) p = p > 0.35 ? 1 : 0; // jump between states, never tween

    var tx = M.x0 + (M.x1 - M.x0) * p;
    var yEnd = M.yDoc - y;                    // where the slot is on screen right now
    var ty = M.y0 + (yEnd - M.y0) * p;        // past p=1 this tracks the slot, so it scrolls away
    var s = 1 + (M.s1 - 1) * p;
    nameEl.style.transform =
      'translate3d(' + tx.toFixed(2) + 'px,' + ty.toFixed(2) + 'px,0) scale(' + s.toFixed(4) + ')';

    var d = p > 0.5;
    if (d !== docked) { docked = d; document.body.classList.toggle('docked', d); }

    // the bar turns to ink once the white ground has slid under it
    var ink = groundEl.getBoundingClientRect().top <= barEl.offsetHeight;
    if (ink !== inked) { inked = ink; barEl.classList.toggle('ink', ink); }
  }

  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () { ticking = false; paint(); });
  }, { passive: true });

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(measure, 120);
  });

  measure();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  window.addEventListener('load', measure);

  /* ---------- wheel assist: the dark act's two screens snap decisively ----------
     CSS scroll-snap stays as the fallback; this just makes one gesture land. */
  var coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!prefersReduced && !coarse) {
    var lockUntil = 0;
    var THRESHOLD = 8;
    window.addEventListener('wheel', function (e) {
      if (e.ctrlKey) return;                       // pinch zoom
      var y = window.pageYOffset || 0;
      var end = M.end;
      if (y > end + 4) return;                     // in the folio: hands off
      var now = Date.now();
      if (now < lockUntil) { e.preventDefault(); return; } // swallow the tail of a gesture
      if (e.deltaY > THRESHOLD && y < end - 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: end, behavior: 'smooth' });
      } else if (e.deltaY < -THRESHOLD && y > 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }, { passive: false });
  }

  /* ---------- folio: lenses (bucket, status) + nine at a time ---------- */
  var bucketBtns = document.querySelectorAll('.lens[data-bucket]');
  var statusBtns = document.querySelectorAll('.lens[data-status]');
  var items = document.querySelectorAll('.entry');
  var emptyEl = document.getElementById('empty');
  var moreBtn = document.getElementById('more');
  var bucket = 'all';
  var status = 'latest';

  var PAGE = 9;
  var shown = PAGE;

  // keepPage=true when the visitor asked for more; any lens change starts over
  function apply(keepPage) {
    if (!keepPage) shown = PAGE;
    var matched = 0;
    items.forEach(function (el) {
      var bOk = bucket === 'all' || el.dataset.bucket === bucket;
      var sOk = status === 'latest' || el.dataset.status === status;
      var hit = bOk && sOk;
      if (hit) matched++;
      el.hidden = !(hit && matched <= shown);
    });
    emptyEl.hidden = matched > 0;
    moreBtn.hidden = matched <= shown; // no counts, it just goes quiet when done
  }

  bucketBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      bucket = b.dataset.bucket;
      bucketBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.bucket === bucket ? 'true' : 'false');
      });
      apply(false);
    });
  });

  statusBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      status = b.dataset.status;
      statusBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.status === status ? 'true' : 'false');
      });
      apply(false);
    });
  });

  moreBtn.addEventListener('click', function () {
    shown += PAGE;
    apply(true);
  });

  apply(false);

  /* ---------- hover footage: only where a real clip exists ---------- */
  if (!prefersReduced) {
    document.querySelectorAll('.tile .clip').forEach(function (v) {
      var tile = v.closest('.tile');
      function enter() {
        if (!v.src) v.src = v.dataset.src;
        v.classList.add('on');
        v.play().catch(function () {});
      }
      function leave() {
        v.classList.remove('on');
        v.pause();
        try { v.currentTime = 0; } catch (err) {}
      }
      tile.addEventListener('mouseenter', enter);
      tile.addEventListener('focusin', enter);
      tile.addEventListener('mouseleave', leave);
      tile.addEventListener('focusout', leave);
    });
  }

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  function mark(id) {
    if (seen.indexOf(id) === -1) {
      seen.push(id);
      try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
    }
    document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
      el.classList.add('seen');
    });
  }
  seen.forEach(mark);
  items.forEach(function (el) {
    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { mark(el.dataset.id); });
    });
  });

  /* ==================================================================
     TOOLING — face pickers and the lately switcher.

     A voice face cannot be swapped on its own. The display sizes are
     (column span ÷ the string's ink run), and the optical indent is that
     string's first-glyph sidebearing — both are properties of the FACE, so
     changing the family without changing them would leave the display type
     sized for the wrong font and it would stop fitting its columns.

     Rather than trust a hard-coded table, the page MEASURES each face when
     it is selected. Canvas TextMetrics reports real ink bounds after real
     shaping — kerning included — which is the only way to be right: the
     offline numbers below were computed from the TTFs and two of the four
     faces kern via GPOS, which a font parser reading only the legacy `kern`
     table misses, leaving those faces ~1.5% short of the last grid line.
     The table survives as the pre-JS default (and as a sanity check); the
     canvas has the last word. Same for the label face's advance, which the
     mono ruler divides by.
     ================================================================== */
  var VOICE = {
    'Space Grotesk':     "'Space Grotesk', system-ui, sans-serif",
    'Schibsted Grotesk': "'Schibsted Grotesk', system-ui, sans-serif",
    'Instrument Sans':   "'Instrument Sans', system-ui, sans-serif",
    'Sora':              "'Sora', system-ui, sans-serif"
  };
  var LABEL = {
    'JetBrains Mono': "'JetBrains Mono', ui-monospace, monospace",
    'IBM Plex Mono':  "'IBM Plex Mono', ui-monospace, monospace",
    'Space Mono':     "'Space Mono', ui-monospace, monospace",
    'Fragment Mono':  "'Fragment Mono', ui-monospace, monospace"
  };

  // the three strings whose ink is measured against the columns, and the
  // tracking each carries — these MUST match the stylesheet
  var MEASURED = [
    { v: 'name',  weight: 700, text: 'divya tak',                        ls: -0.035 },
    { v: 'works', weight: 400, text: 'works',                            ls: -0.040 },
    { v: 'sub',   weight: 500, text: 'Creative technologist and artist',  ls: -0.020 }
  ];

  var PROBE = 200; // measure big, divide down: keeps rounding out of the em value
  var cx = document.createElement('canvas').getContext('2d');

  // ink run in em, and the first glyph's left sidebearing in em
  function inkOf(family, weight, text, ls) {
    cx.font = weight + ' ' + PROBE + 'px ' + family;
    var m = cx.measureText(text);
    if (!m || typeof m.actualBoundingBoxRight !== 'number') return null;
    var lsb = -m.actualBoundingBoxLeft / PROBE;
    var ink = (m.actualBoundingBoxRight + m.actualBoundingBoxLeft) / PROBE;
    // CSS puts the tracking between glyphs; the ink run spans n-1 of those gaps
    return { run: ink + (text.length - 1) * ls, lsb: lsb };
  }

  // a monospace's advance, straight off ten identical cells
  function advOf(family) {
    cx.font = '400 ' + PROBE + 'px ' + family;
    var w = cx.measureText('MMMMMMMMMM').width;
    return w ? w / 10 / PROBE : null;
  }

  var root = document.documentElement;
  function store(k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
  function read(k) { try { return sessionStorage.getItem(k); } catch (e) { return null; } }

  function press(container, attr, value) {
    container.querySelectorAll('button[' + attr + ']').forEach(function (b) {
      b.setAttribute('aria-pressed', b.getAttribute(attr) === value ? 'true' : 'false');
    });
  }

  function remeasure() {
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
    else measure();
  }

  // load the weights we are about to measure, THEN measure — otherwise the
  // canvas hands back the fallback face's metrics and the fit is silently wrong
  function whenReady(key, weights) {
    var q = '"' + key + '"';
    var jobs = [];
    if (document.fonts && document.fonts.load) {
      for (var i = 0; i < weights.length; i++) {
        jobs.push(document.fonts.load(weights[i] + ' ' + PROBE + 'px ' + q));
      }
    }
    return Promise.all(jobs).catch(function () {});
  }

  function setVoice(key) {
    var stack = VOICE[key];
    if (!stack) return;
    root.style.setProperty('--sans', stack);
    press(document.getElementById('pick-voice'), 'data-voice', key);
    store('proto-voice', key);
    whenReady(key, [700, 400, 500]).then(function () {
      for (var i = 0; i < MEASURED.length; i++) {
        var s = MEASURED[i];
        var m = inkOf('"' + key + '"', s.weight, s.text, s.ls);
        if (!m || !(m.run > 0)) continue; // keep the stylesheet default
        root.style.setProperty('--run-' + s.v, m.run.toFixed(4));
        root.style.setProperty('--ti-' + s.v, m.lsb.toFixed(4));
      }
      measure();
    });
  }

  function setLabel(key) {
    var stack = LABEL[key];
    if (!stack) return;
    root.style.setProperty('--mono', stack);
    press(document.getElementById('pick-label'), 'data-label', key);
    store('proto-label', key);
    whenReady(key, [400, 500]).then(function () {
      var a = advOf('"' + key + '"');
      if (a > 0) root.style.setProperty('--mono-adv', a.toFixed(4));
      measure();
    });
  }

  var cards = document.querySelectorAll('.card[data-card]');
  function setLately(key) {
    var any = false;
    cards.forEach(function (c) {
      var on = c.dataset.card === key;
      c.hidden = !on;
      if (on) any = true;
    });
    if (!any) return;
    press(document.getElementById('pick-lately'), 'data-lately', key);
    store('proto-lately', key);
    remeasure(); // the slot's height can change, and the slot anchors the morph
  }

  document.getElementById('tools').addEventListener('click', function (e) {
    var b = e.target.closest('button');
    if (!b) return;
    if (b.dataset.voice) setVoice(b.dataset.voice);
    else if (b.dataset.label) setLabel(b.dataset.label);
    else if (b.dataset.lately) setLately(b.dataset.lately);
  });

  setVoice(read('proto-voice') || 'Space Grotesk');
  setLabel(read('proto-label') || 'JetBrains Mono');
  setLately(read('proto-lately') || 'substack');
})();
</script>
</body>
</html>
