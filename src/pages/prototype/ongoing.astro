<script is:inline>
(function () {
  /* ---------- montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 16 cuts of ~5.2s each, composed offline with ffmpeg (order below matches the
  // render). Captions are derived from playback time against that order.
  var order = ['2a','5a','7a','1a','6a','4a','8a','3a','2b','5b','7b','1b','6b','4b','8b','3b'];
  var captions = {
    1: 'webcam magic',
    2: 'bioluminescent flow',
    3: 'a gallery experiment',
    4: 'a neon platformer',
    5: 'package studio',
    6: 'everything bazaar',
    7: 'metro museum, in progress',
    8: 'a paper game'
  };
  var MONTAGE_SECONDS = 83.2;
  var CUT = MONTAGE_SECONDS / 16;
  var vid = document.getElementById('vid');
  var caption = document.getElementById('hero-caption');
  var toggle = document.getElementById('motion-toggle');
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var paused = prefersReduced;
  var started = false;

  function setCaptionForTime(t) {
    var i = Math.min(order.length - 1, Math.floor(t / CUT));
    caption.textContent = 'from: ' + captions[order[i].charAt(0)];
  }

  vid.addEventListener('timeupdate', function () {
    setCaptionForTime(vid.currentTime || 0);
  });
  setCaptionForTime(0);

  function start() {
    started = true;
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  function setToggleUi() {
    toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
    toggle.setAttribute('aria-label', paused ? 'play background clips' : 'pause background clips');
    toggle.textContent = paused ? 'play' : 'pause';
  }

  toggle.addEventListener('click', function () {
    paused = !paused;
    setToggleUi();
    if (paused) {
      vid.pause();
    } else if (!started) {
      start(); // reduced-motion visitors opt in here
    } else {
      vid.play().catch(function () {});
    }
  });

  setToggleUi();
  if (!prefersReduced) {
    start();
  }
  // under reduced motion nothing plays: the poster still shows via the
  // backdrop's CSS background and the untouched poster attribute.

  /* ---------- works filters ---------- */
  var kindFilters = document.querySelectorAll('.filter[data-kind]');
  var catFilters = document.querySelectorAll('.filter[data-cat]');
  var entries = document.querySelectorAll('.entry');
  var kind = 'all';
  var cat = null;

  function applyFilters() {
    entries.forEach(function (e) {
      var eKind = e.dataset.kind;
      var eCats = (e.dataset.cat || '').split(' ');
      var kindOk = kind === 'all' || eKind === kind;
      var catOk = !cat || eCats.indexOf(cat) !== -1;
      e.hidden = !(kindOk && catOk);
    });
  }

  kindFilters.forEach(function (btn) {
    btn.addEventListener('click', function () {
      kind = btn.dataset.kind;
      kindFilters.forEach(function (b) {
        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  catFilters.forEach(function (btn) {
    btn.addEventListener('click', function () {
      var picked = btn.dataset.cat;
      cat = (cat === picked) ? null : picked; // click again to clear
      catFilters.forEach(function (b) {
        b.setAttribute('aria-pressed', b.dataset.cat === cat ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  entries.forEach(function (e) {
    if (seen.indexOf(e.dataset.id) !== -1) e.classList.add('seen');
    e.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        if (seen.indexOf(e.dataset.id) === -1) {
          seen.push(e.dataset.id);
          try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
        }
        e.classList.add('seen');
      });
    });
  });
})();
</script>
