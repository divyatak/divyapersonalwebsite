---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;800&display=swap" rel="stylesheet" />
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    /* the dark act snaps; the white folio has no snap points, so it scrolls free */
    scroll-snap-type: y proximity;
  }
  body {
    font-family: 'Montserrat', sans-serif;
    color: #222;
    background: #111;
    font-size: 15px;
    line-height: 1.6;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* ---------- the video layer: fixed, behind everything, never scrolls away ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #111 url('/clips/poster-2.jpg') center / cover no-repeat;
  }
  .backdrop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .backdrop video.on { opacity: 1; }
  .backdrop .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.38) 0%, rgba(0,0,0,0.12) 42%, rgba(0,0,0,0.3) 100%);
  }

  /* ---------- the stage: everything that sits over the video ---------- */
  .stage { position: relative; z-index: 1; }
  .stage a { color: #fff; }

  .shell {
    max-width: 1420px;
    margin: 0 auto;
    padding: 0 3rem;
  }
  .shell.narrow { max-width: 1180px; }

  /* ---------- nav: full width, equidistributed, white over the video ---------- */
  .nav {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
    padding: 1.6rem 3rem;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .nav a { color: rgba(255,255,255,0.72); }
  .nav a:hover { color: #fff; }

  /* ---------- screen 1: the big name ---------- */
  .opening {
    position: relative;
    height: 100vh;
    margin-top: -4.4rem; /* the sticky nav sits inside this screen */
    display: flex;
    align-items: center;
    justify-content: center;
    scroll-snap-align: start;
  }
  .opening h1 {
    font-weight: 800;
    font-size: clamp(3rem, 13vw, 10rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: #fff;
    text-transform: lowercase;
    transform-origin: center center;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  body.docked .opening h1 {
    opacity: 0;
    transform: scale(0.14) translateY(-14vh);
  }
  .scroll-cue {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    font-size: 17px;
    transition: opacity 0.3s ease;
  }
  .scroll-cue:hover { color: #fff; }
  body.docked .scroll-cue { opacity: 0; pointer-events: none; }

  /* ---------- screen 2: the docked name + intro + lately ---------- */
  .overlay {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 10rem;
    scroll-snap-align: start;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.58) 22%,
      rgba(0,0,0,0.76) 58%,
      rgba(0,0,0,0.9) 100%
    );
  }
  .overlay-inner {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 5.5rem;
    width: 100%;
    align-items: start;
  }
  .intro { color: rgba(255,255,255,0.74); }
  .intro p { margin-bottom: 1.1rem; max-width: 46ch; }
  .intro p:last-child { margin-bottom: 0; }

  /* the big name, shrunk and docked */
  .dock-name {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    text-transform: lowercase;
    color: #fff;
    margin-bottom: 1.6rem;
    opacity: 0;
    transform: translateY(10px) scale(1.25);
    transform-origin: left top;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  body.docked .dock-name { opacity: 1; transform: none; }

  .intro .lead {
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.6rem;
  }

  /* ---------- lately: three variants, one column ---------- */
  .rail { color: rgba(255,255,255,0.8); }
  .rail a { color: #fff; }
  .v-card, .v-terminal, .v-strip { display: none; }
  body[data-rail="ticker"] .v-card,
  body[data-rail="ticker"] .v-strip,
  body[data-rail="one"] .v-card,
  body[data-rail="terminal"] .v-terminal { display: block; }

  .rail-note {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.42);
    margin-top: 0.9rem;
  }

  /* variant: one card (also used by the ticker variant) */
  .card { display: block; transition: transform 0.35s ease; }
  .card:hover, .card:focus-visible { transform: translateY(-4px); transition-duration: 0.2s; }
  .card .card-label {
    display: block;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: lowercase;
    color: #fff;
    margin-bottom: 0.7rem;
  }
  .card .card-media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .card .card-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* variant: terminal */
  .v-terminal {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12.5px;
    line-height: 1.9;
    color: rgba(255,255,255,0.82);
  }
  .v-terminal .tline { min-height: 1.9em; white-space: nowrap; }
  .v-terminal .tline a { border-bottom: 1px solid rgba(255,255,255,0.4); }
  .v-terminal .tline a:hover { border-bottom-color: #fff; }
  .v-terminal .tline.typing::after {
    content: '\2588';
    color: rgba(255,255,255,0.6);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  /* variant: ticker along the bottom edge of screen 2 */
  .v-strip {
    position: absolute;
    left: 0; right: 0;
    bottom: 3.6rem;
    overflow: hidden;
    border-top: 1px solid rgba(255,255,255,0.14);
    border-bottom: 1px solid rgba(255,255,255,0.14);
    padding: 0.55rem 0;
  }
  .v-strip .track {
    display: flex;
    width: max-content;
    animation: crawl 52s linear infinite;
  }
  .v-strip:hover .track,
  .v-strip:focus-within .track { animation-play-state: paused; }
  .v-strip .copy { display: flex; }
  .v-strip .item {
    font-size: 11.5px;
    letter-spacing: 0.09em;
    white-space: nowrap;
    color: rgba(255,255,255,0.72);
  }
  .v-strip .item a { border-bottom: 1px solid rgba(255,255,255,0.35); }
  .v-strip .item a:hover { border-bottom-color: #fff; }
  .v-strip .dot { padding: 0 0.9rem; color: rgba(255,255,255,0.3); font-size: 11.5px; }
  @keyframes crawl { from { transform: translateX(-50%); } to { transform: translateX(0); } }

  .strip-static { display: none; font-size: 11.5px; letter-spacing: 0.06em; color: rgba(255,255,255,0.7); }
  .strip-static li { list-style: none; padding: 0.35rem 0; }
  .strip-static a { border-bottom: 1px solid rgba(255,255,255,0.35); }

  /* ---------- video chrome ---------- */
  .video-chrome {
    position: sticky;
    bottom: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0 3rem 1.5rem;
    margin-top: -3.5rem;
    pointer-events: none;
  }
  .video-chrome > * { pointer-events: auto; }
  .motion-toggle {
    background: none;
    color: rgba(255,255,255,0.6);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .motion-toggle:hover { color: #fff; border-bottom-color: #fff; }

  /* ---------- the prototype switcher (deliberately not part of the design) ---------- */
  .proto-switch {
    position: fixed;
    left: 1.2rem;
    bottom: 1.2rem;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: 0.35rem;
    background: #0d0d0d;
    border: 1px solid #333;
    padding: 0.3rem 0.55rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 10.5px;
    color: #777;
  }
  .proto-switch .sl { color: #444; }
  .proto-switch button {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font: inherit;
    color: #999;
  }
  .proto-switch button:hover { color: #ddd; }
  .proto-switch button[aria-pressed="true"] { color: #fff; text-decoration: underline; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .backdrop video { transition: none; }
    .opening h1, .dock-name, .scroll-cue, .card, .tile, .tile .media video { transition: none !important; }
    .v-strip { display: none !important; }
    body[data-rail="ticker"] .strip-static { display: block; }
    .v-terminal .tline.typing::after { display: none; }
  }

  /* ---------- solid ground: the folio slides over the video ---------- */
  .ground {
    position: relative;
    z-index: 2;
    background: #fff;
  }

  .folio-head {
    position: sticky;
    top: 0;
    z-index: 5;
    background: #fff;
    display: flex;
    align-items: center;
    gap: 3rem;
    padding: 1.1rem 3rem;
    border-bottom: 1px solid #eee;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .folio-head .wordmark {
    font-size: 1.3rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: lowercase;
    color: #222;
    line-height: 1;
  }
  .folio-head .links {
    flex: 1;
    display: flex;
    justify-content: space-between;
  }
  .folio-head a { color: #999; }
  .folio-head a:hover { color: #222; }

  .works { padding-top: 5rem; scroll-margin-top: 5rem; }
  .works-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-bottom: 3.5rem;
  }
  .works-head h2 {
    font-size: 11px;
    font-weight: 600;
    text-transform: lowercase;
    letter-spacing: 0.14em;
  }

  /* ---------- lenses ---------- */
  .lenses { text-align: right; }
  .lens-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem;
  }
  .lens-row + .lens-row { margin-top: 0.5rem; }
  .lens-row .cluster {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem;
  }
  .lens-row .cluster + .cluster { margin-left: 2.2rem; }
  .lens {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    color: #999;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .lens:hover { color: #222; }
  .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .lens-row.quiet .lens { font-size: 11px; color: #bbb; }
  .lens-row.quiet .lens:hover { color: #636363; }
  .lens-row.quiet .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .lens-row .sep { color: #ddd; font-size: 12px; }

  /* ---------- view: grid ---------- */
  .view[hidden] { display: none; }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    column-gap: 3rem;
    row-gap: 5.5rem;
    padding-bottom: 8rem;
  }
  .entry[hidden] { display: none; }

  .tile { display: block; transition: transform 0.35s ease; }
  .tile.jump { cursor: pointer; }
  .entry:hover .tile, .entry:focus-within .tile { transform: translateY(-4px); transition-duration: 0.2s; }
  .tile .media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f4f4f4;
    box-shadow: 0 1px 8px rgba(0,0,0,0.10);
  }
  .tile .media img,
  .tile .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile .media video {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tile .media video.on { opacity: 1; transition-duration: 0.2s; }

  .entry h3 {
    margin-top: 0.9rem;
    font-size: 15px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: lowercase;
    color: #222;
  }
  .entry.seen h3::after { content: ' \00b7'; color: #ccc; }

  /* ---------- views: list + timeline ---------- */
  .rows { padding-bottom: 8rem; }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) 6.5rem 6.5rem minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 0.85rem 0;
    border-top: 1px solid #eee;
    font-size: 13px;
  }
  .row[hidden] { display: none; }
  .rows .row:last-of-type { border-bottom: 1px solid #eee; }
  .row .r-title { font-weight: 500; color: #222; }
  .row.seen .r-title::after { content: ' \00b7'; color: #ccc; }
  .row .r-year, .row .r-status { font-size: 11.5px; letter-spacing: 0.06em; color: #999; }
  .row .r-with { font-size: 12px; color: #636363; }
  .row .r-links { font-size: 12px; color: #999; }
  .row .r-links a { color: #636363; border-bottom: 1px solid #eee; }
  .row .r-links a:hover { color: #222; border-bottom-color: #222; }
  .row .r-links .dot { color: #ddd; padding: 0 0.25rem; }

  .tl-group[hidden] { display: none; }
  .tl-group .year-mark {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: #999;
    padding: 2.6rem 0 0.5rem;
  }
  .tl-group:first-of-type .year-mark { padding-top: 0; }
  .timeline { padding-bottom: 8rem; }

  .empty {
    font-size: 12px;
    color: #999;
    padding: 2rem 0 8rem;
  }
  .empty[hidden] { display: none; }

  /* ---------- foot ---------- */
  .foot {
    padding: 0 0 4rem;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #999;
  }
  .foot a { color: #999; }
  .foot a:hover { color: #222; }
  .foot .dot { margin: 0 0.7rem; color: #ddd; }

  @media (min-width: 1600px) {
    .grid { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 900px) {
    html { scroll-snap-type: none; }
    .shell, .nav, .video-chrome, .folio-head { padding-left: 1.4rem; padding-right: 1.4rem; }
    .nav { font-size: 11px; letter-spacing: 0.04em; }
    .overlay-inner { grid-template-columns: 1fr; gap: 3rem; }
    .overlay { padding: 6rem 0 9rem; }
    .grid { grid-template-columns: 1fr; row-gap: 3.5rem; }
    .works-head { flex-direction: column; align-items: flex-start; }
    .lenses { text-align: left; }
    .lens-row { justify-content: flex-start; }
    .lens-row .cluster + .cluster { margin-left: 1.2rem; }
    .works { padding-top: 3rem; }
    .folio-head { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .folio-head .links { width: 100%; }
    .row { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
</head>
<body data-rail="ticker">

  <!-- ============ the video, fixed behind everything ============ -->
  <div class="backdrop" aria-hidden="true">
    <video id="vid" muted playsinline loop preload="auto" poster="/clips/poster-2.jpg" src="/clips/montage.mp4"></video>
    <div class="scrim"></div>
  </div>

  <div class="stage">

    <nav class="nav" aria-label="site">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <!-- ============ screen 1: the name ============ -->
    <header class="opening" id="top">
      <h1>divya tak</h1>
      <a class="scroll-cue" href="#intro" aria-label="scroll down to the introduction">&#8595;</a>
    </header>

    <!-- ============ screen 2: docked name, intro, lately ============ -->
    <section class="overlay" id="intro">
      <div class="shell narrow overlay-inner">
        <div class="intro">
          <p class="dock-name">divya tak</p>
          <p class="lead">I make interactive things.</p>
          <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</p>
          <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.</p>
        </div>

        <aside class="rail" aria-label="lately">

          <!-- variant: one card (shared with the ticker variant) -->
          <a class="v-card card" href={peruse} target="_blank" rel="noopener">
            <span class="card-label">this week</span>
            <span class="card-media">
              <img src="/playground/lenticular.webp" alt="A lenticular print of a street drawing shifting between two views" loading="lazy" width="800" height="500" />
            </span>
          </a>

          <!-- variant: terminal -->
          <div class="v-terminal" id="terminal">
            <p class="tline">$ this week</p>
            <p class="tline">&gt; metro-museum: in progress</p>
            <p class="tline">&gt; <a href={bazaar} target="_blank" rel="noopener">everything bazaar: live &#8599;</a></p>
            <p class="tline">&gt; <a href={peruse} target="_blank" rel="noopener">something to peruse &#8599;</a></p>
          </div>

          <!-- reduced-motion fallback for the ticker -->
          <ul class="strip-static">
            {railItems.map((it) => (
              <li>{it.href ? <a href={it.href} target="_blank" rel="noopener">{it.text}</a> : it.text}</li>
            ))}
          </ul>

          <p class="rail-note">updates every monday</p>
        </aside>
      </div>

      <!-- variant: ticker, along the bottom edge of screen 2 -->
      <div class="v-strip" aria-label="lately">
        <div class="track">
          {[0, 1].map((copy) => (
            <div class="copy" aria-hidden={copy === 1 ? 'true' : undefined}>
              {railLoop.map((it) => (
                <>
                  <span class="item">
                    {it.href
                      ? <a href={it.href} target="_blank" rel="noopener" tabindex={copy === 1 ? -1 : undefined}>{it.text}</a>
                      : it.text}
                  </span>
                  <span class="dot" aria-hidden="true">&middot;</span>
                </>
              ))}
            </div>
          ))}
        </div>
      </div>
    </section>

    <div class="video-chrome">
      <button class="motion-toggle" id="motion-toggle" aria-pressed="false" aria-label="pause background clips">pause</button>
    </div>
  </div>

  <!-- ============ the folio: white ground slides over the video ============ -->
  <main class="ground">

    <header class="folio-head">
      <span class="wordmark">divya tak</span>
      <div class="links">
        {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </header>

    <div class="shell">

      <section class="works" id="works" aria-label="works">
        <div class="works-head">
          <h2>works</h2>

          <div class="lenses">
            <div class="lens-row" role="group" aria-label="filter by kind">
              <button class="lens" data-bucket="all" aria-pressed="true">all</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="lens" data-bucket="games" aria-pressed="false">games</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="lens" data-bucket="interactive pieces" aria-pressed="false">interactive pieces</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="lens" data-bucket="on paper" aria-pressed="false">on paper</button>
            </div>
            <div class="lens-row quiet">
              <div class="cluster" role="group" aria-label="filter by status">
                <button class="lens" data-status="latest" aria-pressed="true">latest</button><span class="sep" aria-hidden="true">&middot;</span>
                <button class="lens" data-status="in progress" aria-pressed="false">in progress</button><span class="sep" aria-hidden="true">&middot;</span>
                <button class="lens" data-status="finished" aria-pressed="false">finished</button>
              </div>
              <div class="cluster" role="group" aria-label="choose a view">
                <button class="lens" data-view="grid" aria-pressed="true">grid</button><span class="sep" aria-hidden="true">&middot;</span>
                <button class="lens" data-view="list" aria-pressed="false">list</button><span class="sep" aria-hidden="true">&middot;</span>
                <button class="lens" data-view="timeline" aria-pressed="false">timeline</button>
              </div>
            </div>
          </div>
        </div>

        <!-- ---- view: grid ---- -->
        <div class="view grid" id="view-grid">
          {works.map((w) => (
            <article class="entry" data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
              {w.href ? (
                <a
                  class="tile"
                  href={w.href}
                  target={isExt(w.href) ? '_blank' : undefined}
                  rel={isExt(w.href) ? 'noopener' : undefined}
                >
                  <span class="media">
                    <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                    {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                  </span>
                  <h3>{w.title}</h3>
                </a>
              ) : (
                <div
                  class={w.jump ? 'tile jump' : 'tile'}
                  role={w.jump ? 'button' : undefined}
                  tabindex={w.jump ? 0 : undefined}
                  data-jump={w.jump ? w.id : undefined}
                >
                  <span class="media">
                    <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                    {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                  </span>
                  <h3>{w.title}</h3>
                </div>
              )}
            </article>
          ))}
        </div>

        <!-- ---- view: list ---- -->
        <div class="view rows" id="view-list" hidden>
          {works.map((w) => (
            <div class="row" id={`row-${w.id}`} data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
              <span class="r-title">{w.title}</span>
              <span class="r-year">{w.year}</span>
              <span class="r-status">{w.status}</span>
              <span class="r-with">{w.with || ''}</span>
              <span class="r-links">
                {w.links.map((ln, i) => (
                  <>
                    {i > 0 && <span class="dot" aria-hidden="true">&middot;</span>}
                    <a
                      href={ln.href}
                      target={isExt(ln.href) ? '_blank' : undefined}
                      rel={isExt(ln.href) ? 'noopener' : undefined}
                    >{ln.label}</a>
                  </>
                ))}
              </span>
            </div>
          ))}
        </div>

        <!-- ---- view: timeline ---- -->
        <div class="view timeline" id="view-timeline" hidden>
          {years.map((y) => (
            <section class="tl-group" data-year={y}>
              <p class="year-mark">{y}</p>
              {works.filter((w) => w.sort === y).map((w) => (
                <div class="row" data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
                  <span class="r-title">{w.title}</span>
                  <span class="r-year">{w.year}</span>
                  <span class="r-status">{w.status}</span>
                  <span class="r-with">{w.with || ''}</span>
                  <span class="r-links">
                    {w.links.map((ln, i) => (
                      <>
                        {i > 0 && <span class="dot" aria-hidden="true">&middot;</span>}
                        <a
                          href={ln.href}
                          target={isExt(ln.href) ? '_blank' : undefined}
                          rel={isExt(ln.href) ? 'noopener' : undefined}
                        >{ln.label}</a>
                      </>
                    ))}
                  </span>
                </div>
              ))}
            </section>
          ))}
        </div>

        <p class="empty" id="empty" hidden>nothing under this lens yet.</p>
      </section>

      <footer class="foot">
        <a href="/friends/">friends</a><span class="dot" aria-hidden="true">&middot;</span>
        <a href="/about/">about</a><span class="dot" aria-hidden="true">&middot;</span>
        <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
      </footer>

    </div>
  </main>

  <!-- prototype only: switches the lately variant -->
  <div class="proto-switch" role="group" aria-label="prototype: lately variant">
    <span class="sl">rail:</span>
    <button data-rail-set="ticker" aria-pressed="true">ticker</button><span class="sl">/</span>
    <button data-rail-set="terminal" aria-pressed="false">terminal</button><span class="sl">/</span>
    <button data-rail-set="one" aria-pressed="false">one</button>
  </div>

<script is:inline>
(function () {
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 16 cuts of ~5.2s each, composed offline with ffmpeg. Order and cut length are
  // kept here unchanged even though the "from:" caption is gone, so anything that
  // needs to reason about playback time still can.
  var order = ['2a','5a','7a','1a','6a','4a','8a','3a','2b','5b','7b','1b','6b','4b','8b','3b'];
  var captions = {
    1: 'webcam magic',
    2: 'bioluminescent flow',
    3: 'a gallery experiment',
    4: 'a neon platformer',
    5: 'package studio',
    6: 'everything bazaar',
    7: 'metro museum, in progress',
    8: 'a paper game'
  };
  var MONTAGE_SECONDS = 83.2;
  var CUT = MONTAGE_SECONDS / 16;

  var vid = document.getElementById('vid');
  var toggle = document.getElementById('motion-toggle');
  var paused = prefersReduced;
  var started = false;

  function start() {
    started = true;
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  function setToggleUi() {
    toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
    toggle.setAttribute('aria-label', paused ? 'play background clips' : 'pause background clips');
    toggle.textContent = paused ? 'play' : 'pause';
  }

  toggle.addEventListener('click', function () {
    paused = !paused;
    setToggleUi();
    if (paused) {
      vid.pause();
    } else if (!started) {
      start(); // reduced-motion visitors opt in here
    } else {
      vid.play().catch(function () {});
    }
  });

  setToggleUi();
  if (!prefersReduced) start();
  // under reduced motion nothing plays: the poster still shows via the
  // backdrop's CSS background and the untouched poster attribute.

  /* ---------- the name docks: big name crossfades into the small one ---------- */
  var docked = false;
  function checkDock() {
    var should = window.scrollY > window.innerHeight * 0.28;
    if (should !== docked) {
      docked = should;
      document.body.classList.toggle('docked', docked);
    }
  }
  checkDock();
  window.addEventListener('scroll', function () {
    window.requestAnimationFrame(checkDock);
  }, { passive: true });

  /* ---------- lately: three variants, switched in place ---------- */
  var RAIL_KEY = 'proto-ongoing-rail';
  var railBtns = document.querySelectorAll('[data-rail-set]');
  var terminal = document.getElementById('terminal');
  var tlines = terminal.querySelectorAll('.tline');
  var finalHtml = [];
  tlines.forEach(function (l) { finalHtml.push(l.innerHTML); });
  var typeTimer = null;

  function showTerminalInstantly() {
    tlines.forEach(function (l, i) {
      l.classList.remove('typing');
      l.innerHTML = finalHtml[i];
    });
  }

  function typeTerminal() {
    if (typeTimer) { clearTimeout(typeTimer); typeTimer = null; }
    if (prefersReduced) { showTerminalInstantly(); return; }
    var texts = [];
    tlines.forEach(function (l, i) {
      var probe = document.createElement('div');
      probe.innerHTML = finalHtml[i];
      texts.push(probe.textContent);
      l.textContent = '';
      l.classList.remove('typing');
    });

    var line = 0, ch = 0;
    function step() {
      if (line >= tlines.length) { typeTimer = null; return; }
      var el = tlines[line];
      el.classList.add('typing');
      if (ch <= texts[line].length) {
        el.textContent = texts[line].slice(0, ch);
        ch += 1;
        typeTimer = setTimeout(step, 30);
      } else {
        el.classList.remove('typing');
        el.innerHTML = finalHtml[line]; // links go live once the line lands
        line += 1;
        ch = 0;
        typeTimer = setTimeout(step, 220);
      }
    }
    step();
  }

  var overlaySeen = false;
  var overlayEl = document.getElementById('intro');

  function setRail(name, replay) {
    document.body.setAttribute('data-rail', name);
    railBtns.forEach(function (b) {
      b.setAttribute('aria-pressed', b.dataset.railSet === name ? 'true' : 'false');
    });
    try { sessionStorage.setItem(RAIL_KEY, name); } catch (err) {}
    if (name === 'terminal') {
      if (prefersReduced) showTerminalInstantly();
      else if (overlaySeen && replay) typeTerminal();
    } else if (typeTimer) {
      clearTimeout(typeTimer);
      typeTimer = null;
    }
  }

  var storedRail = null;
  try { storedRail = sessionStorage.getItem(RAIL_KEY); } catch (err) {}
  setRail(storedRail === 'terminal' || storedRail === 'one' ? storedRail : 'ticker', false);

  railBtns.forEach(function (b) {
    b.addEventListener('click', function () { setRail(b.dataset.railSet, true); });
  });

  // type on first reveal of screen 2
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (rows) {
      rows.forEach(function (r) {
        if (!r.isIntersecting) return;
        overlaySeen = true;
        if (document.body.getAttribute('data-rail') === 'terminal') typeTerminal();
        io.disconnect();
      });
    }, { threshold: 0.35 });
    io.observe(overlayEl);
  } else {
    overlaySeen = true;
    if (document.body.getAttribute('data-rail') === 'terminal') typeTerminal();
  }

  /* ---------- folio: lenses (bucket, status) and views ---------- */
  var bucketBtns = document.querySelectorAll('.lens[data-bucket]');
  var statusBtns = document.querySelectorAll('.lens[data-status]');
  var viewBtns = document.querySelectorAll('.lens[data-view]');
  var items = document.querySelectorAll('.entry, .row');
  var groups = document.querySelectorAll('.tl-group');
  var viewEls = {
    grid: document.getElementById('view-grid'),
    list: document.getElementById('view-list'),
    timeline: document.getElementById('view-timeline')
  };
  var emptyEl = document.getElementById('empty');
  var bucket = 'all';
  var status = 'latest';
  var view = 'grid';

  function applyLenses() {
    items.forEach(function (el) {
      var bOk = bucket === 'all' || el.dataset.bucket === bucket;
      var sOk = status === 'latest' || el.dataset.status === status;
      el.hidden = !(bOk && sOk);
    });
    groups.forEach(function (g) {
      g.hidden = !g.querySelector('.row:not([hidden])');
    });
    var visible = viewEls[view].querySelectorAll('.entry:not([hidden]), .row:not([hidden])');
    emptyEl.hidden = visible.length > 0;
  }

  function setView(name) {
    view = name;
    Object.keys(viewEls).forEach(function (k) { viewEls[k].hidden = k !== name; });
    viewBtns.forEach(function (b) {
      b.setAttribute('aria-pressed', b.dataset.view === name ? 'true' : 'false');
    });
    applyLenses();
  }

  bucketBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      bucket = b.dataset.bucket;
      bucketBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.bucket === bucket ? 'true' : 'false');
      });
      applyLenses();
    });
  });

  statusBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      status = b.dataset.status;
      statusBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.status === status ? 'true' : 'false');
      });
      applyLenses();
    });
  });

  viewBtns.forEach(function (b) {
    b.addEventListener('click', function () { setView(b.dataset.view); });
  });

  applyLenses();

  /* ---------- the six small games tile: jump to its list row ---------- */
  document.querySelectorAll('[data-jump]').forEach(function (t) {
    function jump() {
      setView('list');
      var row = document.getElementById('row-' + t.dataset.jump);
      if (row) row.scrollIntoView({ block: 'center', behavior: prefersReduced ? 'auto' : 'smooth' });
    }
    t.addEventListener('click', jump);
    t.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); jump(); }
    });
  });

  /* ---------- hover footage: only where a real clip exists ---------- */
  if (!prefersReduced) {
    document.querySelectorAll('.tile .clip').forEach(function (v) {
      var tile = v.closest('.tile');
      function enter() {
        if (!v.src) v.src = v.dataset.src;
        v.classList.add('on');
        v.play().catch(function () {});
      }
      function leave() {
        v.classList.remove('on');
        v.pause();
        try { v.currentTime = 0; } catch (err) {}
      }
      tile.addEventListener('mouseenter', enter);
      tile.addEventListener('focusin', enter);
      tile.addEventListener('mouseleave', leave);
      tile.addEventListener('focusout', leave);
    });
  }

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  function mark(id) {
    if (seen.indexOf(id) === -1) {
      seen.push(id);
      try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
    }
    document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
      el.classList.add('seen');
    });
  }
  seen.forEach(mark);
  items.forEach(function (el) {
    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { mark(el.dataset.id); });
    });
  });
})();
</script>
</body>
</html>
