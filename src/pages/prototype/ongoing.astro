<script is:inline>
(function () {
  /* ---------- opening montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 24 cuts of ~2.6s each, composed offline with ffmpeg (order below matches the
  // render). Captions are derived from playback time against that order.
  var order = ['2b','5a','7c','1a','6b','4c','8a','3b','2c','5c','7a','1c','6a','4a','8c','3a','2a','5b','7b','1b','6c','4b','8b','3c'];
  var captions = {
    1: 'webcam magic',
    2: 'bioluminescent flow',
    3: 'a gallery experiment',
    4: 'a neon platformer',
    5: 'package studio',
    6: 'everything bazaar',
    7: 'metro museum, in progress',
    8: 'a paper game'
  };
  var MONTAGE_SECONDS = 62.0;
  var CUT = MONTAGE_SECONDS / order.length;
  var vid = document.getElementById('vid');
  var caption = document.getElementById('hero-caption');
  var toggle = document.getElementById('motion-toggle');
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var paused = prefersReduced;
  var started = false;

  function setCaptionForTime(t) {
    var i = Math.min(order.length - 1, Math.floor(t / CUT));
    caption.textContent = 'from: ' + captions[order[i].charAt(0)];
  }

  vid.addEventListener('timeupdate', function () {
    setCaptionForTime(vid.currentTime || 0);
  });
  setCaptionForTime(0);

  function start() {
    started = true;
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  function setToggleUi() {
    toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
    toggle.setAttribute('aria-label', paused ? 'play background clips' : 'pause background clips');
    toggle.textContent = paused ? 'play' : 'pause';
  }

  toggle.addEventListener('click', function () {
    paused = !paused;
    setToggleUi();
    if (paused) {
      vid.pause();
    } else if (!started) {
      start(); // reduced-motion visitors opt in here
    } else {
      vid.play().catch(function () {});
    }
  });

  setToggleUi();
  if (!prefersReduced) {
    start();
  }
  // under reduced motion nothing plays: the poster still shows via the
  // hero's CSS background and the untouched poster attribute.

  /* ---------- works filters ---------- */
  var kindChips = document.querySelectorAll('.chip[data-kind]');
  var catChips = document.querySelectorAll('.chip[data-cat]');
  var entries = document.querySelectorAll('.entry');
  var kind = 'all';
  var cat = null;

  function applyFilters() {
    entries.forEach(function (e) {
      var eKind = e.dataset.kind;
      var eCats = (e.dataset.cat || '').split(' ');
      var kindOk = kind === 'all' || eKind === kind;
      var catOk = !cat || eCats.indexOf(cat) !== -1;
      e.hidden = !(kindOk && catOk);
    });
  }

  kindChips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      kind = chip.dataset.kind;
      kindChips.forEach(function (c) {
        c.setAttribute('aria-pressed', c === chip ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  catChips.forEach(function (chip) {
    chip.addEventListener('click', function () {
      var picked = chip.dataset.cat;
      cat = (cat === picked) ? null : picked; // click again to clear
      catChips.forEach(function (c) {
        c.setAttribute('aria-pressed', c.dataset.cat === cat ? 'true' : 'false');
      });
      applyFilters();
    });
  });

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  entries.forEach(function (e) {
    if (seen.indexOf(e.dataset.id) !== -1) e.classList.add('seen');
    e.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        if (seen.indexOf(e.dataset.id) === -1) {
          seen.push(e.dataset.id);
          try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
        }
        e.classList.add('seen');
      });
    });
  });

  /* ---------- switcher keys ---------- */
  document.addEventListener('keydown', function (ev) {
    var t = ev.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if (ev.key === 'ArrowLeft') window.location.href = '/prototype/merge/';
    if (ev.key === 'ArrowRight') window.location.href = '/prototype/flow/';
  });
})();
</script>
</body>
</html>
