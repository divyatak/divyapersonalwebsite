                <img src="/projects/2020/AI quit/cover.webp" alt="AI quit cover" loading="lazy" width="300" height="300" />
                <img src="/projects/2020/Boneyard/cover.webp" alt="Boneyard cover" loading="lazy" width="300" height="300" />
                <img src="/projects/2020/Mark/cover.webp" alt="Mark cover" loading="lazy" width="300" height="300" />
              </span>
              <h3>six small games</h3>
              <div class="whisper">
                <p class="meta">2020 &middot; game</p>
              </div>
              <p class="sub-links">
                <a href="/works/ai-quit/">AI quit</a> &middot;
                <a href="/works/boneyard/">Boneyard</a> &middot;
                <a href="/works/mark/">Mark</a> &middot;
