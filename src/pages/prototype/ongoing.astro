              </span>
              <h3>How to think</h3>
              <div class="whisper">
                <p class="meta">2022 &middot; zine, illustration</p>
              </div>
            </a>
          </article>

          <article class="entry entry--offset" data-id="common" data-kind="finished" data-cat="comic">
            <a class="tile" href="/works/common/">
              <span class="media">
                <img src="/projects/2021/Common/cover.webp" alt="Common comic cover" loading="lazy" width="640" height="360" />
              </span>
