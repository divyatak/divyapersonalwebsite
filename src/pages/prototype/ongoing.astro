<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;800&display=swap" rel="stylesheet" />
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: 'Montserrat', sans-serif;
    color: #222;
    background: #111;
    font-size: 15px;
    line-height: 1.6;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* ---------- the video layer: fixed, behind everything, never scrolls away ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #111 url('/clips/poster-2.jpg') center / cover no-repeat;
  }
  .backdrop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .backdrop video.on { opacity: 1; }
  .backdrop .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.38) 0%, rgba(0,0,0,0.12) 42%, rgba(0,0,0,0.3) 100%);
  }

  /* ---------- the stage: everything that sits over the video ---------- */
  .stage { position: relative; z-index: 1; }
  .stage a { color: #fff; }

  .shell {
    max-width: 1420px;
    margin: 0 auto;
    padding: 0 3rem;
  }
  .shell.narrow { max-width: 1180px; }

  /* ---------- nav ---------- */
  .nav {
    position: absolute;
    top: 0; left: 0; right: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    padding: 1.6rem 3rem;
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .nav .links { display: flex; gap: 1.8rem; }
  .nav a { color: rgba(255,255,255,0.72); }
  .nav a:hover { color: #fff; }
  .nav .current { color: #fff; font-weight: 600; }

  /* ---------- viewport 1: the name ---------- */
  .opening {
    position: relative;
    height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .opening h1 {
    font-weight: 800;
    font-size: clamp(3rem, 13vw, 10rem);
    letter-spacing: -0.035em;
    line-height: 1;
    color: #fff;
    text-transform: lowercase;
  }
  .scroll-cue {
    position: absolute;
    bottom: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    color: rgba(255,255,255,0.7);
    font-size: 17px;
  }
  .scroll-cue:hover { color: #fff; }

  /* ---------- viewport 2: intro over the video ---------- */
  .overlay {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: 8rem 0 10rem;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.55) 20%,
      rgba(0,0,0,0.72) 55%,
      rgba(0,0,0,0.86) 100%
    );
  }
  .overlay-inner {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 6rem;
    width: 100%;
    align-items: start;
  }
  .intro { color: rgba(255,255,255,0.78); }
  .intro p { margin-bottom: 1.2rem; max-width: 46ch; }
  .intro .lead {
    font-size: clamp(1.5rem, 3.2vw, 2.4rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #fff;
    margin-bottom: 1.8rem;
  }

  .rail { color: rgba(255,255,255,0.8); }
  .rail h2 {
    font-size: 11px;
    font-weight: 600;
    text-transform: lowercase;
    letter-spacing: 0.14em;
    color: #fff;
  }
  .rail .sub {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: rgba(255,255,255,0.45);
    margin-bottom: 1.4rem;
  }
  .rail ul { list-style: none; }
  .rail li {
    padding: 0.75rem 0;
    border-top: 1px solid rgba(255,255,255,0.16);
    font-size: 13px;
  }
  .rail li:last-of-type { border-bottom: 1px solid rgba(255,255,255,0.16); }
  .rail .when {
    display: block;
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: rgba(255,255,255,0.45);
  }
  .rail a { border-bottom: 1px solid rgba(255,255,255,0.35); }
  .rail a:hover { border-bottom-color: #fff; }
  .rail .foot-note {
    font-size: 11px;
    color: rgba(255,255,255,0.45);
    margin-top: 1rem;
    max-width: 32ch;
  }

  /* ---------- video chrome: pinned to the bottom of the stage, scrolls off with it ---------- */
  .video-chrome {
    position: sticky;
    bottom: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0 3rem 1.5rem;
    margin-top: -3.5rem;
    pointer-events: none;
  }
  .video-chrome > * { pointer-events: auto; }
  .from-caption {
    font-size: 11px;
    letter-spacing: 0.08em;
    color: rgba(255,255,255,0.6);
  }
  .motion-toggle {
    background: none;
    color: rgba(255,255,255,0.6);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    font-family: 'Montserrat', sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: lowercase;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .motion-toggle:hover { color: #fff; border-bottom-color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .backdrop video { transition: none; }
    .tile, .tile .media img, .whisper { transition: none !important; }
  }

  /* ---------- solid ground: the folio slides over the video ---------- */
  .ground {
    position: relative;
    z-index: 2;
    background: #fff;
    padding-top: 6rem;
  }

  .works-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding-bottom: 3.5rem;
  }
  .works-head h2 {
    font-size: 11px;
    font-weight: 600;
    text-transform: lowercase;
    letter-spacing: 0.14em;
  }
  .works-head .sub {
    font-size: 12px;
    color: #999;
    margin-top: 0.35rem;
    max-width: 44ch;
  }
  .filters { text-align: right; }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.4rem;
  }
  .filter-row + .filter-row { margin-top: 0.5rem; }
  .filter {
    font-family: 'Montserrat', sans-serif;
    font-size: 12px;
    text-transform: lowercase;
    letter-spacing: 0.06em;
    color: #999;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .filter:hover { color: #222; }
  .filter[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .filter-row.quiet .filter { font-size: 11px; color: #bbb; }
  .filter-row.quiet .filter:hover { color: #636363; }
  .filter-row.quiet .filter[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .filter-row .sep { color: #ddd; font-size: 12px; }

  /* ---------- the folio ---------- */
  .stream {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    align-items: start;
    column-gap: 3rem;
    row-gap: 6rem;
    padding-bottom: 8rem;
  }
  .entry[hidden] { display: none; }
  .entry--full { grid-column: 1 / -1; }
  .entry--offset { grid-column: 2; }
  .entry--line { grid-column: 1 / -1; }

  .tile { display: block; transition: transform 0.35s ease; }
  .entry:hover .tile, .entry:focus-within .tile { transform: translateY(-4px); transition-duration: 0.2s; }
  .tile .media { display: block; overflow: hidden; }
  .tile .media img {
    width: 100%;
    height: auto;
    box-shadow: 0 1px 8px rgba(0,0,0,0.10);
  }
  .tile .strip { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; align-items: start; }

  .entry h3 {
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-top: 1.2rem;
  }
  .entry--full h3 { font-size: clamp(1.5rem, 3vw, 2.3rem); }
  .entry--half h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
  .entry--offset h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); }
  .entry.seen h3::after { content: ' \00b7'; color: #ccc; }

  .whisper {
    opacity: 0;
    transition: opacity 0.35s ease;
    margin-top: 0.45rem;
  }
  .entry:hover .whisper, .entry:focus-within .whisper { opacity: 1; transition-duration: 0.2s; }
  .whisper .meta {
    font-size: 11px;
    letter-spacing: 0.06em;
    color: #999;
  }
  .whisper .note {
    font-size: 12px;
    color: #636363;
    max-width: 46ch;
    margin-top: 0.2rem;
  }
  @media (hover: none) {
    .whisper { opacity: 1; }
  }

  .out-link {
    display: inline-block;
    margin-top: 0.7rem;
    font-size: 12px;
    color: #636363;
    border-bottom: 1px solid #ddd;
  }
  .out-link:hover { color: #222; border-bottom-color: #222; }
  .sub-links {
    margin-top: 0.7rem;
    font-size: 12px;
    color: #999;
  }
  .sub-links a { color: #636363; border-bottom: 1px solid #eee; }
  .sub-links a:hover { color: #222; border-bottom-color: #222; }

  /* rest beats: a line of text between the imagery */
  .entry--line .tile {
    padding: 2.2rem 0;
    border-top: 1px solid #eee;
    border-bottom: 1px solid #eee;
  }
  .entry--line h3 { font-size: clamp(1.2rem, 2vw, 1.5rem); margin-top: 0; font-weight: 500; }
  .entry--line h3 a { border-bottom: 1px solid transparent; }
  .entry--line h3 a:hover { border-bottom-color: #222; }

  /* ---------- foot ---------- */
  .foot {
    padding: 0 0 4rem;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #999;
  }
  .foot a { color: #999; }
  .foot a:hover { color: #222; }
  .foot .dot { margin: 0 0.7rem; color: #ddd; }

  @media (max-width: 900px) {
    .shell, .nav, .video-chrome { padding-left: 1.4rem; padding-right: 1.4rem; }
    .overlay-inner { grid-template-columns: 1fr; gap: 3.5rem; }
    .overlay { padding: 6rem 0 8rem; }
    .stream { grid-template-columns: 1fr; row-gap: 4rem; }
    .entry--offset { grid-column: 1; }
    .works-head { flex-direction: column; align-items: flex-start; }
    .filters { text-align: left; }
    .filter-row { justify-content: flex-start; }
    .ground { padding-top: 4rem; }
  }
</style>
</head>
<body>

  <!-- ============ the video, fixed behind everything ============ -->
  <div class="backdrop" aria-hidden="true">
    <video id="vid" muted playsinline loop preload="auto" poster="/clips/poster-2.jpg" src="/clips/montage.mp4"></video>
    <div class="scrim"></div>
  </div>

  <div class="stage">

    <nav class="nav" aria-label="site">
      <div class="links">
        <span class="current" aria-current="page">works</span>
        <a href="/friends/">friends</a>
        <a href="/about/">about</a>
        <a href="mailto:hello@divyatak.art">contact</a>
      </div>
    </nav>

    <!-- ============ 1. the name ============ -->
    <header class="opening" id="top">
      <h1>divya tak</h1>
      <a class="scroll-cue" href="#intro" aria-label="scroll down to the introduction">&#8595;</a>
    </header>

    <!-- ============ 2. intro + lately, over the still-playing video ============ -->
    <section class="overlay" id="intro">
      <div class="shell narrow overlay-inner">
        <div class="intro">
          <p class="lead">I make interactive things.</p>
          <p>I want the viewer to feel like they're in it. Not just looking at it through glass.</p>
          <p>I came to all of it from physics, and I've never learned to keep the physicist and the artist in separate rooms.</p>
          <p>Some of it is games, some of it is drawing, some of it is code that does something when you touch it. It all lives together below.</p>
        </div>

        <aside class="rail" aria-label="lately">
          <h2>lately</h2>
          <p class="sub">updates every monday</p>
          <ul>
            <li>
              <span class="when">aug 2026</span>
              this site: alt text and image sizing pass
            </li>
            <li>
              <span class="when">2026</span>
              bioluminescent flow joined the playground
            </li>
            <li>
              <span class="when">now</span>
              metro museum: in progress
            </li>
            <li>
              <span class="when">2026</span>
              <a href="https://everythingbazaar.netlify.app" target="_blank" rel="noopener">everything bazaar is live</a>
            </li>
            <li>
              <a href="https://divyatak.github.io/creative-visuals/lenticular/" target="_blank" rel="noopener">something to peruse &#8594;</a>
            </li>
          </ul>
          <p class="foot-note">sample rail. the real one builds itself from github, substack, instagram.</p>
        </aside>
      </div>
    </section>

    <div class="video-chrome">
      <p class="from-caption" id="hero-caption">from: bioluminescent flow</p>
      <button class="motion-toggle" id="motion-toggle" aria-pressed="false" aria-label="pause background clips">pause</button>
    </div>
  </div>

  <!-- ============ 3. solid ground: the folio slides over the video ============ -->
  <main class="ground">
    <div class="shell">

      <section class="works" aria-label="works">
        <div class="works-head">
          <div>
            <h2>works</h2>
            <p class="sub">everything, newest first. some finished, some in progress, some never finishing.</p>
          </div>
          <div class="filters">
            <div class="filter-row" role="group" aria-label="filter by kind">
              <button class="filter" data-kind="all" aria-pressed="true">latest</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-kind="experiment" aria-pressed="false">experiments</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-kind="finished" aria-pressed="false">finished</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-kind="ongoing" aria-pressed="false">ongoing</button>
            </div>
            <div class="filter-row quiet" role="group" aria-label="filter by category">
              <button class="filter" data-cat="game" aria-pressed="false">game</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-cat="illustration" aria-pressed="false">illustration</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-cat="comic" aria-pressed="false">comic</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-cat="zine" aria-pressed="false">zine</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-cat="photocomics" aria-pressed="false">photocomics</button><span class="sep" aria-hidden="true">&middot;</span>
              <button class="filter" data-cat="tool" aria-pressed="false">tool</button>
            </div>
          </div>
        </div>

        <div class="stream" id="stream">

          <article class="entry entry--full" data-id="metro-museum" data-kind="ongoing" data-cat="game">
            <div class="tile">
              <span class="media">
                <img src="/clips/poster-7.jpg" alt="A 3D museum interior with mannequin figures at sunset, from the Metro Museum build" loading="lazy" width="640" height="360" />
              </span>
              <h3>Metro Museum of the Forgotten</h3>
              <div class="whisper">
                <p class="meta">2026 &middot; in progress &middot; game</p>
                <p class="note">a museum for what people leave behind on the Delhi Metro</p>
              </div>
            </div>
          </article>

          <article class="entry entry--full" data-id="everything-bazaar" data-kind="finished" data-cat="game tool">
            <a class="tile" href="https://everythingbazaar.netlify.app" target="_blank" rel="noopener">
              <span class="media">
                <img src="/clips/poster-6.jpg" alt="A dark shop screen with a product box, from Everything Bazaar" loading="lazy" width="640" height="360" />
              </span>
              <h3>Everything Bazaar</h3>
              <div class="whisper">
                <p class="meta">2026 &middot; live &middot; game, tool</p>
              </div>
            </a>
          </article>

          <article class="entry entry--half" data-id="bioluminescent-flow" data-kind="experiment" data-cat="">
