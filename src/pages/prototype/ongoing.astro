              <div class="whisper">
                <p class="meta">2024 &middot; game, illustration</p>
              </div>
            </a>
          </article>

          <article class="entry entry--half" data-id="how-to-think" data-kind="finished" data-cat="zine illustration">
            <a class="tile" href="/works/how-to-think/">
              <span class="media">
