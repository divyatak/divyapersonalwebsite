      </section>

      <!-- six 2020 games: compact strip with real covers -->
      <section class="entry" data-entry="games">
        <span class="marker" aria-hidden="true"></span>
        <p class="meta"><span class="t">six games in six months</span> · made 2020 · with Charu · act: play</p>
        <p class="hook">one game a month for six months. we called it Game'd.</p>
        <div class="covers">
          <a href="/works/ai-quit/"><img src="/projects/2020/AI quit/cover.webp" alt="AI quit cover art: a tiny robot escaping a toaster factory" loading="lazy" /></a>
