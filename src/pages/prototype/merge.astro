  <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var HOLD = 700;

      function loadSet(key) {
        try { return JSON.parse(sessionStorage.getItem(key) || '[]'); } catch (e) { return []; }
      }
      function saveSet(key, arr) {
        try { sessionStorage.setItem(key, JSON.stringify(arr)); } catch (e) {}
      }

      /* residue: acted entries stay quietly marked, session only, uncounted, unremarked */
      var residue = loadSet('proto-merge-residue');
      function markEntry(id) {
        if (!id) return;
        if (residue.indexOf(id) === -1) {
          residue.push(id);
          saveSet('proto-merge-residue', residue);
        }
        var el = document.querySelector('[data-entry="' + id + '"]');
        if (el) el.classList.add('acted');
      }
      residue.forEach(function (id) {
        var el = document.querySelector('[data-entry="' + id + '"]');
        if (el) el.classList.add('acted');
      });

      /* any real link inside an entry marks the entry when used */
      document.querySelectorAll('.entry a').forEach(function (a) {
        a.addEventListener('click', function () {
          var e = a.closest('.entry');
          if (e) markEntry(e.getAttribute('data-entry'));
        });
      });

      /* metro museum: held attention resolves a record; resolved records stay resolved */
      var mmList = document.getElementById('mm-list');
      var recs = Array.prototype.slice.call(mmList.querySelectorAll('.rec'));
      var mmResolved = loadSet('proto-merge-mm');

      function resolveRec(btn, i, fromRestore) {
        if (btn.classList.contains('resolved')) return;
        btn.classList.remove('holding');
        btn.classList.add('resolved');
        btn.setAttribute('aria-expanded', 'true');
        if (!fromRestore) {
          if (mmResolved.indexOf(i) === -1) {
            mmResolved.push(i);
            saveSet('proto-merge-mm', mmResolved);
          }
          markEntry('mm');
        }
      }

      recs.forEach(function (btn, i) {
        if (mmResolved.indexOf(i) !== -1) resolveRec(btn, i, true);

        var timer = null;
        function beginHold() {
          if (btn.classList.contains('resolved') || reduced) return;
          btn.classList.add('holding');
          timer = setTimeout(function () { resolveRec(btn, i); }, HOLD);
        }
        function cancelHold() {
          if (timer) { clearTimeout(timer); timer = null; }
          btn.classList.remove('holding');
        }
        btn.addEventListener('mouseenter', beginHold);
        btn.addEventListener('mouseleave', cancelHold);
        btn.addEventListener('pointerdown', function (ev) {
          if (ev.pointerType === 'touch') beginHold();
        });
        btn.addEventListener('pointerup', function (ev) {
          if (ev.pointerType === 'touch') cancelHold();
        });
        btn.addEventListener('pointercancel', cancelHold);
        /* instant on focus, instant on click (keyboard and reduced-motion) */
        btn.addEventListener('focus', function () { resolveRec(btn, i); });
        btn.addEventListener('click', function () { resolveRec(btn, i); });
      });
      /* transitions only arm after any restored state is painted: resting page stays still */
      requestAnimationFrame(function () { mmList.classList.add('live'); });

      /* everything bazaar: one exclusive pick, the other closes for the session */
      var ebPair = document.getElementById('eb-pair');
      var ebLink = document.getElementById('eb-link');
      var feels = Array.prototype.slice.call(ebPair.querySelectorAll('.feel'));

      function applyPick(feel, fromRestore) {
        feels.forEach(function (b) {
          if (b.getAttribute('data-feel') === feel) {
            b.classList.add('picked');
            b.setAttribute('aria-pressed', 'true');
            b.disabled = true;
          } else {
            b.classList.add('closed');
            b.setAttribute('aria-pressed', 'false');
            b.disabled = true;
          }
        });
        ebLink.hidden = false;
        if (!fromRestore) {
          try { sessionStorage.setItem('proto-merge-eb', feel); } catch (e) {}
          markEntry('eb');
        }
      }

      var storedPick = null;
      try { storedPick = sessionStorage.getItem('proto-merge-eb'); } catch (e) {}
      if (storedPick) applyPick(storedPick, true);

      feels.forEach(function (b) {
        b.addEventListener('click', function () {
          if (b.disabled) return;
          applyPick(b.getAttribute('data-feel'));
        });
      });
      requestAnimationFrame(function () { ebPair.classList.add('live'); });

      /* switcher keyboard nav */
      document.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        var t = e.target;
        if (t && (/^(input|textarea|select)$/i.test(t.tagName) || t.isContentEditable)) return;
        window.location.href = e.key === 'ArrowLeft' ? '/prototype/record/' : '/prototype/flow/';
      });
    })();
  </script>
</body>
</html>
