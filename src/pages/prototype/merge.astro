        <p class="striplinks">
          <a href="/works/misplaced/">misplaced</a> ·
          <a href="/works/proximity/">proximity</a> ·
          <a href="/works/ruh-and-the-glow/">ruh and the glow</a>
        </p>
      </section>

      <!-- physics: the bottom of the record, flat -->
      <section class="entry" data-entry="physics">
        <span class="marker" aria-hidden="true"></span>
        <p class="flatline"><span class="t">physics</span> · IIT Kharagpur</p>
      </section>

    </div>

    <!-- closing facts strip: printable-flat -->
    <footer class="facts">
      <p><a href="mailto:hello@divyatak.art">hello@divyatak.art</a></p>
      <p><a href="/friends/">friends</a></p>
      <p class="apx-label">made about me by other people</p>
