<div class="proto-bar"><a href="/prototype/flow/">←</a><span>record — one list, last used first</span><a href="/prototype/merge/">→</a><a class="idx" href="/prototype/">all</a></div>

<script is:inline>
(function () {
  var rm = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ----- disclosure entries ----- */
  var OPEN_KEY = 'proto-record-opened';
  var opened;
  try { opened = JSON.parse(sessionStorage.getItem(OPEN_KEY) || '[]'); } catch (e) { opened = []; }

  function saveOpened() {
    try { sessionStorage.setItem(OPEN_KEY, JSON.stringify(opened)); } catch (e) {}
  }
  function markOpened(id) {
    if (!id) return;
    if (opened.indexOf(id) === -1) { opened.push(id); saveOpened(); }
    var li = document.querySelector('li[data-id="' + id + '"]');
    if (li) li.classList.add('opened');
  }

  /* residue from earlier in the session: marked, but closed */
  opened.forEach(function (id) {
    var li = document.querySelector('li[data-id="' + id + '"]');
    if (li) li.classList.add('opened');
  });

  document.querySelectorAll('button.line').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var body = document.getElementById(btn.getAttribute('aria-controls'));
      var isOpen = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isOpen));
      if (body) body.hidden = isOpen;
      if (!isOpen) markOpened(btn.closest('li').getAttribute('data-id'));
    });
  });

  /* ----- metro museum: hold to resolve ----- */
  document.querySelectorAll('.mm-record').forEach(function (r) {
    var t = null;
    function resolve() { r.classList.add('resolved'); }
    function arm() {
      if (r.classList.contains('resolved')) return;
      if (rm.matches) { resolve(); return; }
      t = setTimeout(resolve, 700);
    }
    function disarm() { if (t) { clearTimeout(t); t = null; } }
    r.addEventListener('mouseenter', arm);
    r.addEventListener('mouseleave', disarm);
    r.addEventListener('touchstart', arm, { passive: true });
    r.addEventListener('touchend', disarm);
    r.addEventListener('touchcancel', disarm);
    r.addEventListener('focus', resolve);
  });

  /* ----- everything bazaar: one pick, session-long ----- */
  var BZ_KEY = 'proto-record-bazaar';
  var picks = document.querySelectorAll('.bz-pick');
  var bzLink = document.getElementById('bz-link');

  function applyPick(feeling) {
    picks.forEach(function (b) {
      if (b.getAttribute('data-feeling') === feeling) {
        b.classList.add('picked');
      } else {
        b.classList.add('closed');
      }
      b.disabled = true;
    });
    if (bzLink) bzLink.hidden = false;
  }

  var storedPick = null;
  try { storedPick = sessionStorage.getItem(BZ_KEY); } catch (e) {}
  if (storedPick) applyPick(storedPick);

  picks.forEach(function (b) {
    b.addEventListener('click', function () {
      var feeling = b.getAttribute('data-feeling');
      try { sessionStorage.setItem(BZ_KEY, feeling); } catch (e) {}
      applyPick(feeling);
    });
  });

  /* ----- switcher keyboard nav ----- */
  document.addEventListener('keydown', function (e) {
    var t = e.target;
    if (t && (t.matches('input, textarea, select') || t.isContentEditable)) return;
    if (e.key === 'ArrowLeft') window.location.href = '/prototype/flow/';
    if (e.key === 'ArrowRight') window.location.href = '/prototype/merge/';
  });
})();
</script>

