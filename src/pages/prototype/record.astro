<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { background: #fff; }
  body {
    font-family: 'Montserrat', sans-serif;
    color: #222;
    font-size: 15px;
    line-height: 1.6;
    max-width: 760px;
    margin: 0 auto;
    padding: 72px 24px 120px;
  }

  a { color: #222; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #999; }
  a:hover { text-decoration-color: #222; }

  /* ---------- chrome (inert) ---------- */
  header h1 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: 0.01em;
  }
  header .standing {
    margin-top: 6px;
    font-size: 13px;
    color: #636363;
  }
  header .standing a { color: #636363; }

  .record-label {
    margin: 48px 0 0;
    font-size: 12px;
    color: #999;
    letter-spacing: 0.04em;
  }

  /* ---------- the record ---------- */
  ol.record { list-style: none; margin-top: 8px; }
  ol.record > li { border-bottom: 1px solid #eee; }

  .line, .line-flat {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 10px;
    width: 100%;
    padding: 13px 2px;
    text-align: left;
  }
  button.line {
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
  }
  button.line:hover .name { color: #000; }
  button.line:focus-visible {
    outline: 1px solid #222;
    outline-offset: 2px;
  }

  .mark {
    width: 8px;
    height: 8px;
    flex: none;
    align-self: center;
    border: 1px solid #999;
    background: #fff;
  }
  .mark.none { border-color: transparent; }
  li.opened .mark { background: #222; border-color: #222; }

  .name { font-weight: 500; color: #222; }
  .name a { font-weight: 500; }
  li.opened > .line .name, li.opened > .line-flat .name { color: #636363; }
  .hook { color: #636363; }
  .data {
    margin-left: auto;
    font-size: 12px;
    color: #999;
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .data { margin-left: 18px; flex-basis: 100%; white-space: normal; }
  }

  /* ---------- opened bodies ---------- */
  .body {
    padding: 6px 2px 26px 18px;
  }
  .body { animation: reveal 0.16s ease; }
  @keyframes reveal {
    from { opacity: 0; transform: translateY(-2px); }
  }
  .body p { max-width: 60ch; }
  .body .plain { font-size: 13px; color: #636363; }
  .body .plain a { color: #222; }
  .body img {
    display: block;
    max-width: 100%;
    height: auto;
    box-shadow: 0 1px 10px rgba(0,0,0,0.12);
  }
  .body .thumb { max-width: 420px; margin-bottom: 12px; }
  .body .caplabel { font-size: 12px; color: #999; margin: 6px 0 20px; }

  .testimony {
    font-size: 15px;
    color: #222;
    max-width: 56ch;
  }

  /* ---------- metro museum: the rule, run small ---------- */
  .mm-note { font-size: 12px; color: #999; margin-bottom: 14px; }
  .mm-record {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    align-items: baseline;
    padding: 9px 2px;
    border-bottom: 1px dashed #ccc;
    color: #c9c9c9;
    cursor: default;
    transition: color 0.25s ease;
  }
  .mm-record:focus-visible { outline: 1px solid #222; outline-offset: 2px; }
  .mm-record .mm-item { font-weight: 500; letter-spacing: 0.02em; }
  .mm-record .mm-cat {
    font-size: 12px;
    border: 1px dashed #d5d5d5;
    padding: 0 6px;
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .mm-record .mm-where { font-size: 12px; margin-left: auto; }
  .mm-record.resolved {
    color: #222;
    border-bottom: 1px solid #eee;
  }
  .mm-record.resolved .mm-cat { border: 1px solid #222; color: #222; }
  .mm-record.resolved .mm-where { color: #636363; }
  .mm-after { margin-top: 16px; font-size: 13px; color: #636363; }

  /* ---------- everything bazaar: the pick ---------- */
  .bz-picks { display: flex; gap: 32px; align-items: baseline; margin: 6px 0 4px; }
  .bz-pick {
    background: none;
    border: 0;
    font-family: 'Montserrat', sans-serif;
    font-size: 26px;
    font-weight: 500;
    color: #222;
    cursor: pointer;
    padding: 2px 0;
  }
  .bz-pick:hover { color: #000; letter-spacing: 0.02em; }
  .bz-pick:focus-visible { outline: 1px solid #222; outline-offset: 3px; }
  .bz-pick.picked { color: #222; cursor: default; }
  .bz-pick.picked:hover { letter-spacing: normal; }
  .bz-pick.closed {
    color: #ccc;
    text-decoration: line-through;
    text-decoration-color: #ccc;
    cursor: default;
  }
  .bz-pick.closed:hover { letter-spacing: normal; color: #ccc; }
  #bz-link { margin-top: 14px; font-size: 13px; }
  #bz-link a { color: #222; }

  /* ---------- (un)seen ---------- */
  .unseen-piece { margin-bottom: 4px; }
  .unseen-caption {
    margin: 4px 0 24px;
    font-size: 15px;
    color: #222;
    max-width: 56ch;
  }

  /* ---------- appendix ---------- */
  .appendix { margin-top: 64px; }
  .appendix h2 {
    font-size: 12px;
    font-weight: 500;
    color: #999;
    letter-spacing: 0.04em;
  }
  .appendix ul { list-style: none; margin-top: 6px; }
  .appendix li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 10px;
    align-items: baseline;
    padding: 10px 2px;
    border-bottom: 1px solid #eee;
    color: #636363;
  }
  .appendix .data { margin-left: auto; font-size: 12px; color: #999; }

  /* ---------- physics quote (the record's first entry) ---------- */
  .first-entry-quote {
    padding: 4px 2px 20px 18px;
    color: #222;
    max-width: 56ch;
  }

  /* ---------- proto switcher (tooling chrome) ---------- */
  .proto-bar {
    position: fixed;
    bottom: 16px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 14px;
    background: #111;
    color: #fff;
    font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
    font-size: 13px;
    padding: 8px 18px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .proto-bar a { color: #fff; text-decoration: none; }
  .proto-bar a:hover { text-decoration: underline; }
  .proto-bar .idx { color: #999; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>
