---
// THROWAWAY PROTOTYPE — angle hypothesis A ("no glass"), delete after decision.
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>no glass — divya tak (prototype A)</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Space+Grotesk:wght@400;500;600&display=swap"
    rel="stylesheet"
  />

  <style>
    /* ————— the room ————— */
    :root {
      --ink: #eaf2ee;
      --dim: #93a3a6;
      --mint: #7df0cf;
      --lilac: #b9a7ff;
      --amber: #ffd27a;
      --night: #050810;
      --serif: "Fraunces", georgia, serif;
      --sans: "Space Grotesk", system-ui, sans-serif;
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--night);
      color: var(--ink);
      font-family: var(--sans);
      font-size: 16px;
      line-height: 1.55;
      overflow-x: hidden;
    }
    ::selection { background: rgba(125, 240, 207, 0.3); }

    /* the living field sits behind everything, always */
    #field {
      position: fixed;
      inset: 0;
      width: 100vw;
      height: 100vh;
      z-index: 0;
      display: block;
    }

    /* ————— nearly-invisible nav ————— */
    .corner {
      position: fixed;
      z-index: 20;
      font-size: 12px;
      letter-spacing: 0.08em;
      opacity: 0.45;
      transition: opacity 0.2s ease;
    }
    .corner:hover { opacity: 1; }
    .corner a { color: var(--ink); text-decoration: none; border-bottom: 1px solid transparent; }
    .corner a:hover { border-bottom-color: var(--mint); }
    .corner.tl { top: 18px; left: 22px; }
    .corner.tr { top: 18px; right: 22px; display: flex; gap: 18px; }

    /* ————— arrival ————— */
    .arrival {
      position: relative;
      z-index: 2;
      min-height: 100svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 24px;
      gap: 22px;
    }
    .claim {
      font-family: var(--serif);
      font-weight: 340;
      font-size: clamp(34px, 6.5vw, 72px);
      line-height: 1.12;
      max-width: 15ch;
      text-shadow: 0 0 40px rgba(125, 240, 207, 0.25);
    }
    .claim em {
      font-style: italic;
      color: var(--mint);
    }
    .hint {
      font-size: 13px;
      letter-spacing: 0.14em;
      color: var(--dim);
    }
    .drift {
      margin-top: 4vh;
      color: var(--ink);
      text-decoration: none;
      font-size: 13px;
      letter-spacing: 0.2em;
      opacity: 0.7;
      transition: opacity 0.2s ease;
      animation: bob 2.6s ease-in-out infinite;
    }
    .drift:hover { opacity: 1; }
    @keyframes bob {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(7px); }
    }

    /* ————— spoken lines between doors ————— */
    .passage {
      position: relative;
      z-index: 2;
      font-family: var(--serif);
      font-style: italic;
      font-weight: 320;
      font-size: clamp(20px, 3vw, 30px);
      line-height: 1.4;
      text-align: center;
      max-width: 26ch;
      margin: 18vh auto;
      padding: 0 24px;
      color: var(--ink);
    }
    .passage.small { font-size: clamp(17px, 2.2vw, 22px); color: var(--dim); }

    /* ————— the corridor of doors ————— */
    .corridor {
      position: relative;
      z-index: 2;
      max-width: 1100px;
      margin: 0 auto;
      padding: 0 5vw 10vh;
    }
    /* one faint thread connects every door — it is one space, not a list */
    .corridor::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 50%;
      width: 1px;
      background: linear-gradient(
        to bottom,
        transparent,
        rgba(125, 240, 207, 0.16) 8%,
        rgba(185, 167, 255, 0.14) 55%,
        rgba(255, 210, 122, 0.16) 92%,
        transparent
      );
      pointer-events: none;
    }

    .door {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 20px;
      margin: 16vh 0;
      max-width: 480px;
      opacity: 0;
      transform: translateY(36px);
      transition: opacity 0.9s ease, transform 0.9s ease;
    }
    .door.in { opacity: 1; transform: none; }
    .door.l { margin-right: auto; }
    .door.r { margin-left: auto; }
    .door.c { margin-left: auto; margin-right: auto; align-items: center; text-align: center; }
    .door.big { max-width: 560px; }
    .door.small-door { max-width: 380px; }

    /* the doorway itself: an arch of light */
    .portal {
      display: block;
      width: 100%;
      aspect-ratio: 4 / 5;
      border-radius: 999px 999px 18px 18px;
      overflow: hidden;
      position: relative;
      border: 1px solid rgba(125, 240, 207, 0.28);
      box-shadow:
        0 0 50px rgba(125, 240, 207, 0.1),
        inset 0 0 60px rgba(5, 8, 16, 0.5);
      transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
      background: #0a1120;
    }
    a.portal:hover, .door:hover .portal {
      transform: translateY(-8px);
      border-color: rgba(125, 240, 207, 0.6);
      box-shadow:
        0 0 90px rgba(125, 240, 207, 0.22),
        inset 0 0 60px rgba(5, 8, 16, 0.35);
      transition-duration: 0.2s;
    }
    .portal img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
      filter: saturate(1.05);
    }
    /* paper doors glow warm instead of cool */
    .paper .portal { border-color: rgba(255, 210, 122, 0.3); box-shadow: 0 0 50px rgba(255, 210, 122, 0.09), inset 0 0 60px rgba(5, 8, 16, 0.5); }
    .paper:hover .portal {
      border-color: rgba(255, 210, 122, 0.6);
      box-shadow: 0 0 90px rgba(255, 210, 122, 0.2), inset 0 0 60px rgba(5, 8, 16, 0.35);
      transform: translateY(-8px);
      transition-duration: 0.2s;
    }

    /* styled placeholders for doors with no picture yet */
    .ph {
      width: 100%;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }
    .ph-metro {
      background:
        radial-gradient(ellipse 90% 55% at 50% 0%, rgba(125, 240, 207, 0.22), transparent 70%),
        radial-gradient(ellipse 70% 40% at 50% 100%, rgba(185, 167, 255, 0.14), transparent 70%),
        #071120;
    }
    .ph-metro .ph-big {
      font-family: var(--serif);
      font-weight: 300;
      font-size: clamp(40px, 7vw, 64px);
      color: rgba(234, 242, 238, 0.2);
      letter-spacing: 0.04em;
    }
    .ph-bazaar {
      background:
        repeating-linear-gradient(
          90deg,
          rgba(255, 210, 122, 0.1) 0 26px,
          rgba(185, 167, 255, 0.1) 26px 52px,
          rgba(125, 240, 207, 0.1) 52px 78px,
          rgba(255, 138, 171, 0.1) 78px 104px
        ),
        radial-gradient(ellipse 100% 70% at 50% 30%, rgba(255, 210, 122, 0.12), transparent 70%),
        #100a1c;
    }
    .ph-titli {
      background:
        radial-gradient(ellipse 45% 55% at 32% 45%, rgba(255, 138, 171, 0.24), transparent 70%),
        radial-gradient(ellipse 45% 55% at 68% 45%, rgba(255, 210, 122, 0.22), transparent 70%),
        #140a12;
    }
    .ph-word {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.3em;
      text-transform: uppercase;
      color: rgba(234, 242, 238, 0.55);
    }

    /* fanned covers — a hand of photographs, never a grid */
    .fan {
      width: 100%;
      aspect-ratio: 4 / 3;
      position: relative;
    }
    .fan img {
      position: absolute;
      width: 58%;
      aspect-ratio: 3 / 4;
      object-fit: cover;
      border-radius: 8px;
      border: 1px solid rgba(255, 210, 122, 0.3);
      box-shadow: 0 12px 34px rgba(0, 0, 0, 0.55);
      transition: transform 0.35s ease;
    }
    .fan img:nth-child(1) { left: 0%;  top: 9%;  transform: rotate(-7deg); z-index: 1; }
    .fan img:nth-child(2) { left: 15%; top: 3%;  transform: rotate(-2deg); z-index: 2; }
    .fan img:nth-child(3) { left: 30%; top: 6%;  transform: rotate(3deg);  z-index: 3; }
    .fan img:nth-child(4) { left: 43%; top: 11%; transform: rotate(8deg);  z-index: 4; }
    .door:hover .fan img:nth-child(1) { transform: rotate(-10deg) translateY(-6px); transition-duration: 0.2s; }
    .door:hover .fan img:nth-child(2) { transform: rotate(-4deg) translateY(-10px); transition-duration: 0.2s; }
    .door:hover .fan img:nth-child(3) { transform: rotate(5deg) translateY(-10px); transition-duration: 0.2s; }
    .door:hover .fan img:nth-child(4) { transform: rotate(11deg) translateY(-6px); transition-duration: 0.2s; }
    .fan.cool img { border-color: rgba(125, 240, 207, 0.3); }
    .fan.three img:nth-child(1) { left: 4%;  top: 8%; }
    .fan.three img:nth-child(2) { left: 21%; top: 2%; }
    .fan.three img:nth-child(3) { left: 38%; top: 8%; }

    /* the plate beside each door */
    .plate h2 {
      font-family: var(--serif);
      font-weight: 420;
      font-size: clamp(22px, 3vw, 30px);
      line-height: 1.2;
    }
    .plate .year {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.12em;
      color: var(--dim);
      margin-left: 10px;
      white-space: nowrap;
    }
    .plate p {
      color: var(--dim);
      margin-top: 8px;
      max-width: 44ch;
      font-size: 15px;
    }
    .door.c .plate p { margin-left: auto; margin-right: auto; }

    /* the handle: a verb */
    .verb {
      display: inline-block;
      margin-top: 16px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.18em;
      text-transform: lowercase;
      color: var(--mint);
      text-decoration: none;
      border: 1px solid rgba(125, 240, 207, 0.4);
      border-radius: 999px;
      padding: 9px 22px;
      transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
    }
    a.verb:hover {
      transform: translateY(-3px);
      box-shadow: 0 0 30px rgba(125, 240, 207, 0.3);
      background: rgba(125, 240, 207, 0.08);
      transition-duration: 0.2s;
    }
    .paper .verb { color: var(--amber); border-color: rgba(255, 210, 122, 0.4); }
    .paper a.verb:hover { box-shadow: 0 0 30px rgba(255, 210, 122, 0.28); background: rgba(255, 210, 122, 0.08); }
    .verb.soon {
      color: var(--lilac);
      border-color: rgba(185, 167, 255, 0.35);
      border-style: dashed;
      cursor: default;
    }
    .verb.quiet { border-style: dashed; opacity: 0.75; cursor: default; }

    /* ————— the far end of the room ————— */
    .depart {
      position: relative;
      z-index: 2;
      min-height: 70svh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 26px;
      padding: 10vh 24px 16vh;
    }
    .depart .physics {
      font-size: 14px;
      color: var(--dim);
      max-width: 46ch;
    }
    .depart .callout {
      font-family: var(--serif);
      font-weight: 340;
      font-style: italic;
      font-size: clamp(28px, 5vw, 52px);
      line-height: 1.2;
      text-shadow: 0 0 40px rgba(255, 210, 122, 0.2);
    }
    .depart .mail {
      font-family: var(--sans);
      font-size: 15px;
      letter-spacing: 0.1em;
      color: var(--ink);
      text-decoration: none;
      border-bottom: 1px solid rgba(125, 240, 207, 0.5);
      padding-bottom: 3px;
      transition: color 0.2s ease, border-color 0.2s ease;
    }
    .depart .mail:hover { color: var(--mint); border-color: var(--mint); }

    @media (max-width: 720px) {
      .door, .door.big, .door.small-door { max-width: min(440px, 88vw); margin-left: auto; margin-right: auto; }
      .corridor::before { left: 8px; }
      .door { margin-top: 13vh; margin-bottom: 13vh; }
    }

    /* ————— stillness for those who ask for it ————— */
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      .drift { animation: none; }
      .door { opacity: 1; transform: none; transition: none; }
      .portal, .verb, .fan img { transition: none; }
      .door:hover .fan img { transform: none; }
    }
  </style>
</head>

<body>
  <canvas id="field" aria-hidden="true"></canvas>

  <nav class="corner tl"><a href="/">divya tak</a></nav>
  <nav class="corner tr">
    <a href="/about/">about</a>
    <a href="mailto:hello@divyatak.art">contact</a>
  </nav>

  <!-- arrival: you interact before you read -->
  <header class="arrival">
    <h1 class="claim">I make interactive things. <em>You're in one now.</em></h1>
    <p class="hint">move your cursor. tap the dark. it notices.</p>
    <a class="drift" href="#doors">drift down ↓</a>
  </header>

  <p class="passage">
    &ldquo;I want the viewer to feel like they're in it. Not just looking at it
    through glass.&rdquo;
  </p>

  <main class="corridor" id="doors">
    <!-- door 1 · metro museum -->
    <section class="door c big">
      <div class="portal">
        <div class="ph ph-metro">
          <span class="ph-big">24,646</span>
        </div>
      </div>
      <div class="plate">
        <h2>Metro Museum of the Forgotten <span class="year">2026, in progress</span></h2>
        <p>A browser museum built from 24,646 scraped Delhi Metro lost-and-found records.</p>
        <span class="verb soon">enter — opening soon</span>
      </div>
    </section>

    <!-- door 2 · everything bazaar -->
    <section class="door r">
      <a class="portal" href="https://everythingbazaar.netlify.app" target="_blank" rel="noopener">
        <div class="ph ph-bazaar">
          <span class="ph-word">feelings, vended</span>
        </div>
      </a>
      <div class="plate">
        <h2>Everything Bazaar <span class="year">2026</span></h2>
        <p>Vending machines that sell feelings, procedurally branded.</p>
        <a class="verb" href="https://everythingbazaar.netlify.app" target="_blank" rel="noopener">enter →</a>
      </div>
    </section>

    <!-- door 3 · the line before -->
    <section class="door l">
      <a class="portal" href="https://divya.studiotypo.xyz" target="_blank" rel="noopener">
        <img src="/playground/the-line-before.webp" alt="A 3D garden of glowing flowers grown from lines of poetry" width="480" height="600" loading="lazy" />
      </a>
      <div class="plate">
        <h2>The Line Before <span class="year">2025</span></h2>
        <p>A 3D poetry garden with Kahran Singh &mdash; flowers bloom from words.</p>
        <a class="verb" href="https://divya.studiotypo.xyz" target="_blank" rel="noopener">wander →</a>
      </div>
    </section>

    <!-- door 4 · bioluminescent flow -->
    <section class="door r">
      <a class="portal" href="https://divyatak.github.io/creative-visuals/particles/" target="_blank" rel="noopener">
        <img src="/playground/bioluminescent-flow.webp" alt="Glowing teal particles swirling around a hand seen through a webcam" width="480" height="600" loading="lazy" />
      </a>
      <div class="plate">
        <h2>Bioluminescent Flow <span class="year">2026</span></h2>
        <p>Glowing algae that ripple around your hand, via webcam.</p>
        <a class="verb" href="https://divyatak.github.io/creative-visuals/particles/" target="_blank" rel="noopener">touch →</a>
      </div>
    </section>

    <!-- door 5 · webcam magic -->
    <section class="door l">
      <a class="portal" href="https://divyatak.github.io/creative-visuals/webcam/" target="_blank" rel="noopener">
        <img src="/playground/webcam-magic.webp" alt="A webcam mirror transformed by gesture-controlled visual effects" width="480" height="600" loading="lazy" />
      </a>
      <div class="plate">
        <h2>Webcam Magic <span class="year">2026</span></h2>
        <p>A gesture-controlled mirror with seven modes.</p>
        <a class="verb" href="https://divyatak.github.io/creative-visuals/webcam/" target="_blank" rel="noopener">wave →</a>
      </div>
    </section>

    <p class="passage small">
      &ldquo;I make playful work about serious things and serious work about
      playful things.&rdquo;
    </p>

    <!-- door 6 · lenticular -->
    <section class="door c">
      <a class="portal" href="https://divyatak.github.io/creative-visuals/lenticular/" target="_blank" rel="noopener">
        <img src="/playground/lenticular.webp" alt="A photo-comic panel mid-shift between rough sketch and finished art" width="480" height="600" loading="lazy" />
      </a>
      <div class="plate">
        <h2>(un)seen Lenticular <span class="year">2026</span></h2>
        <p>Photo-comics that shift between sketch and final as you move.</p>
        <a class="verb" href="https://divyatak.github.io/creative-visuals/lenticular/" target="_blank" rel="noopener">move →</a>
      </div>
    </section>

    <!-- door 7 · titli effect -->
    <section class="door l">
      <div class="portal">
        <div class="ph ph-titli">
          <span class="ph-word">the titli effect</span>
        </div>
      </div>
      <div class="plate">
        <h2>The Titli Effect <span class="year">2024</span></h2>
        <p>A narrative game made with my sister Charu. 2nd place, Jennifer Ann Group Connectedness jam.</p>
        <span class="verb quiet">play</span>
      </div>
    </section>

    <!-- door 8 · paper plane -->
    <section class="door r">
      <div class="portal">
        <img src="/projects/2024/Journey of my paper plane/cover.webp" alt="Cover art for Journey of my paper plane" width="480" height="600" loading="lazy" />
      </div>
      <div class="plate">
        <h2>Journey of my paper plane <span class="year">2024</span></h2>
        <span class="verb quiet">play</span>
      </div>
    </section>

    <!-- door 9 · six small games -->
    <section class="door c small-door">
      <div class="fan cool three" aria-label="Covers of three early games">
        <img src="/projects/2020/AI quit/cover.webp" alt="Cover of the game AI quit" width="280" height="373" loading="lazy" />
        <img src="/projects/2020/Boneyard/cover.webp" alt="Cover of the game Boneyard" width="280" height="373" loading="lazy" />
        <img src="/projects/2020/Mark/cover.webp" alt="Cover of the game Mark" width="280" height="373" loading="lazy" />
      </div>
      <div class="plate">
        <h2>six small games <span class="year">2020</span></h2>
        <p>AI quit, Boneyard, Mark, Misplaced, Proximity, Ruh and the glow &mdash; all on itch.io.</p>
        <span class="verb quiet">play</span>
      </div>
    </section>

    <p class="passage small">some doors open onto paper.</p>

    <!-- door 10 · (un)seen — the on-paper door, same register, different verb -->
    <section class="door l paper">
      <div class="fan" aria-label="Covers of the (un)seen photo-comic series">
        <img src="/projects/2024/(un)seen Istanbul/cover.webp" alt="(un)seen Istanbul photo-comic cover" width="280" height="373" loading="lazy" />
        <img src="/projects/2024/(un)seen Vietnam/cover.webp" alt="(un)seen Vietnam photo-comic cover" width="280" height="373" loading="lazy" />
        <img src="/projects/2025/(un)seen Emirates/cover.webp" alt="(un)seen Emirates photo-comic cover" width="280" height="373" loading="lazy" />
        <img src="/projects/2026/(un)seen Life/cover.webp" alt="(un)seen Life photo-comic cover" width="280" height="373" loading="lazy" />
      </div>
      <div class="plate">
        <h2>(un)seen <span class="year">2024–ongoing</span></h2>
        <p>Photo-comic walks through Istanbul, Vietnam, the Emirates, Tokyo.</p>
        <span class="verb quiet">look</span>
      </div>
    </section>

    <!-- door 11 · comics & zines -->
    <section class="door r paper small-door">
      <div class="fan three" aria-label="Covers of three comics and zines">
        <img src="/projects/2016/Pi of life/cover.webp" alt="Cover of the comic Pi of life" width="280" height="373" loading="lazy" />
        <img src="/projects/2021/Common/cover.webp" alt="Cover of the comic Common" width="280" height="373" loading="lazy" />
        <img src="/projects/2022/How to think/cover.webp" alt="Cover of the zine How to think" width="280" height="373" loading="lazy" />
      </div>
      <div class="plate">
        <h2>comics &amp; zines</h2>
        <p>Pi of life, Common, How to think&hellip;</p>
        <span class="verb quiet">look</span>
      </div>
    </section>
  </main>

  <!-- the far end of the room -->
  <footer class="depart">
    <p class="physics">
      &ldquo;I came to all of it from physics, and I've never learned to keep the
      physicist and the artist in separate rooms.&rdquo;
    </p>
    <p class="callout">Come closer. Look again. Let's play.</p>
    <a class="mail" href="mailto:hello@divyatak.art">hello@divyatak.art</a>
  </footer>

  <!-- the field: a dark room full of small lights that notice you -->
  <script is:inline>
    (() => {
      const cv = document.getElementById('field');
      const cx = cv.getContext('2d');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let W, H, dpr, parts = [], rings = [], t = 0;
      const ptr = { x: -9999, y: -9999, live: false };

      function size() {
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        W = innerWidth; H = innerHeight;
        cv.width = Math.round(W * dpr);
        cv.height = Math.round(H * dpr);
        cx.setTransform(dpr, 0, 0, dpr, 0, 0);
        seed();
      }

      function seed() {
        const n = Math.max(60, Math.min(150, Math.round((W * H) / 11000)));
        parts = [];
        for (let i = 0; i < n; i++) {
          parts.push({
            x: Math.random() * W, y: Math.random() * H,
            vx: 0, vy: 0,
            r: 0.7 + Math.random() * 1.9,
            ph: Math.random() * Math.PI * 2,
            sp: 0.4 + Math.random() * 0.8,
            warm: Math.random() < 0.18, // a few amber sparks among the cool ones
            glow: 0,
          });
        }
      }

      const tint = (p, a) =>
        p.warm ? 'rgba(255,210,122,' + a + ')' : 'rgba(125,240,207,' + a + ')';

      function frame() {
        t += 0.016;
        cx.globalCompositeOperation = 'source-over';
        cx.fillStyle = 'rgba(5,8,16,0.28)'; // translucent wipe → soft trails
        cx.fillRect(0, 0, W, H);
        cx.globalCompositeOperation = 'lighter';

        for (const p of parts) {
          // slow personal drift
          p.vx += Math.cos(p.ph + t * p.sp) * 0.008;
          p.vy += Math.sin(p.ph * 1.7 + t * p.sp) * 0.008;
          // the cursor pulls nearby lights into a loose orbit and wakes them
          if (ptr.live) {
            const dx = ptr.x - p.x, dy = ptr.y - p.y;
            const d = Math.hypot(dx, dy) || 1;
            if (d < 220) {
              const f = (220 - d) / 220;
              p.vx += (dx / d) * f * 0.06 + (-dy / d) * f * 0.12;
              p.vy += (dy / d) * f * 0.06 + (dx / d) * f * 0.12;
              p.glow = Math.min(1, p.glow + f * 0.08);
            }
          }
          // taps ripple outward and shove the lights
          for (const rg of rings) {
            const dx = p.x - rg.x, dy = p.y - rg.y;
            const d = Math.hypot(dx, dy) || 1;
            if (Math.abs(d - rg.r) < 46) {
              p.vx += (dx / d) * rg.a * 1.4;
              p.vy += (dy / d) * rg.a * 1.4;
              p.glow = Math.min(1, p.glow + rg.a * 0.5);
            }
          }
          p.vx *= 0.94; p.vy *= 0.94;
          p.x += p.vx; p.y += p.vy;
          p.glow *= 0.96;
          if (p.x < -30) p.x = W + 30; else if (p.x > W + 30) p.x = -30;
          if (p.y < -30) p.y = H + 30; else if (p.y > H + 30) p.y = -30;

          const tw = 0.35 + 0.25 * Math.sin(t * 2 * p.sp + p.ph) + p.glow * 0.6;
          const R = p.r * (5 + p.glow * 7);
          const g = cx.createRadialGradient(p.x, p.y, 0, p.x, p.y, R);
          g.addColorStop(0, tint(p, (0.55 * tw).toFixed(3)));
          g.addColorStop(1, tint(p, 0));
          cx.fillStyle = g;
          cx.beginPath(); cx.arc(p.x, p.y, R, 0, 7); cx.fill();
          cx.fillStyle = tint(p, Math.min(1, 0.9 * tw + 0.2).toFixed(3));
          cx.beginPath(); cx.arc(p.x, p.y, p.r, 0, 7); cx.fill();
        }

        for (let i = rings.length - 1; i >= 0; i--) {
          const rg = rings[i];
          rg.r += 5; rg.a *= 0.94;
          cx.strokeStyle = 'rgba(185,167,255,' + (rg.a * 0.5).toFixed(3) + ')';
          cx.lineWidth = 1.5;
          cx.beginPath(); cx.arc(rg.x, rg.y, rg.r, 0, 7); cx.stroke();
          if (rg.a < 0.02) rings.splice(i, 1);
        }
        requestAnimationFrame(frame);
      }

      // reduced motion: one quiet, still frame — the room holds its breath
      function still() {
        cx.fillStyle = '#050810';
        cx.fillRect(0, 0, W, H);
        cx.globalCompositeOperation = 'lighter';
        for (const p of parts) {
          const R = p.r * 6;
          const g = cx.createRadialGradient(p.x, p.y, 0, p.x, p.y, R);
          g.addColorStop(0, tint(p, 0.4));
          g.addColorStop(1, tint(p, 0));
          cx.fillStyle = g;
          cx.beginPath(); cx.arc(p.x, p.y, R, 0, 7); cx.fill();
        }
        cx.globalCompositeOperation = 'source-over';
      }

      addEventListener('resize', () => { size(); if (reduced) still(); });
      size();
      if (reduced) { still(); return; }
      addEventListener('pointermove', (e) => {
        ptr.x = e.clientX; ptr.y = e.clientY; ptr.live = true;
      }, { passive: true });
      addEventListener('pointerdown', (e) => {
        rings.push({ x: e.clientX, y: e.clientY, r: 4, a: 1 });
        ptr.x = e.clientX; ptr.y = e.clientY; ptr.live = true;
      }, { passive: true });
      document.addEventListener('pointerleave', () => { ptr.live = false; });
      requestAnimationFrame(frame);
    })();
  </script>

  <!-- doors surface one at a time as you drift -->
  <script is:inline>
    (() => {
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.door');
      if (reduced || !('IntersectionObserver' in window)) {
        els.forEach((el) => el.classList.add('in'));
        return;
      }
      const io = new IntersectionObserver(
        (entries) => entries.forEach((en) => {
          if (en.isIntersecting) { en.target.classList.add('in'); io.unobserve(en.target); }
        }),
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      els.forEach((el) => io.observe(el));
    })();
  </script>

  <!-- prototype switcher — tooling, not part of the mockup -->
  <div class="proto-bar">
    <a class="proto-arrow" href="/prototype/d/">←</a>
    <span class="proto-label">A — no glass</span>
    <a class="proto-arrow" href="/prototype/b/">→</a>
    <a class="proto-index" href="/prototype/">all</a>
  </div>
  <style>
    .proto-bar{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;align-items:center;gap:10px;background:#111;color:#fff;padding:8px 14px;border-radius:999px;font:600 13px/1 monospace;box-shadow:0 4px 16px rgba(0,0,0,.35)}
    .proto-bar a{color:#fff;text-decoration:none;padding:2px 6px}
    .proto-bar a:hover{background:#333;border-radius:6px}
    .proto-index{opacity:.6;font-weight:400}
  </style>
  <script is:inline>
    document.addEventListener('keydown',(e)=>{
      const el=document.activeElement;
      if(el&&(['INPUT','TEXTAREA'].includes(el.tagName)||el.isContentEditable))return;
      if(e.key==='ArrowLeft')location.href='/prototype/d/';
      if(e.key==='ArrowRight')location.href='/prototype/b/';
    });
  </script>
</body>
</html>
