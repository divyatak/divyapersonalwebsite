<!-- TYPE EXPLORATION B of ongoing.astro, ROUND 2 — relationships (typography only) -->
---
// PROTOTYPE — landing rebuild after the design interview.
// Dark act = two snap screens over the fixed video. White act = the folio, free scroll.
// One name element travels from screen 1 into the slot on screen 2. One nav bar for the whole page.
// Works are read from the build pipeline (generated-projects.json) plus five entries that live outside it.
//
// TYPE B / ROUND 2 — THE CLASSICAL AXIS.
// Content, order, video, the 3-column 16:10 grid, the filters, load-more and the
// title-morph mechanism are unchanged. What changed is the typographic SYSTEM:
// one modular scale (root 2) and one left axis that the whole page hangs from.

import generated from '../../data/generated-projects.json';

const isExt = (h) => typeof h === 'string' && h.indexOf('http') === 0;

/* ---------- buckets: derived from the pipeline's categories ---------- */
const ON_PAPER = ['comic', 'zine', 'illustration', 'photocomics'];
const bucketFor = (cats = []) => {
  if (cats.indexOf('game') !== -1) return 'games';
  if (cats.some((c) => ON_PAPER.indexOf(c) !== -1)) return 'on paper';
  return 'none'; // e.g. Mixed meanings (ai / conceptual) — visible under "all" only
};

// the pipeline groups by year, and buckets everything pre-2020 into a label:"earlier"
// group whose year is 0, so the real year comes off the cover path.
const yearOf = (p, group) => {
  const m = /\/projects\/(\d{4})\//.exec(p.cover || '');
  return m ? Number(m[1]) : group.year;
};

// credits are kept in the data but are NOT shown in the folio any more —
// they belong on the work detail pages.
const WITH_CHARU = [
  'ai-quit', 'boneyard', 'mark', 'misplaced', 'proximity', 'ruh-and-the-glow',
  'the-titli-effect',
];

const CURRENT_YEAR = 2026;

/* ---------- the five that are not in the pipeline ---------- */
const bazaar = 'https://everythingbazaar.netlify.app';
const flow = 'https://divyatak.github.io/creative-visuals/particles/';
const webcam = 'https://divyatak.github.io/creative-visuals/webcam/';
const lineBefore = 'https://divya.studiotypo.xyz';

const additions = [
  {
    id: 'metro-museum',
    title: 'Metro Museum of the Forgotten',
    year: 2026,
    status: 'in progress',
    bucket: 'games',
    img: '/clips/poster-7.jpg',
    alt: 'A 3D museum interior with mannequin figures at sunset, from the Metro Museum build',
    clip: '/clips/cut-7a.mp4',
    href: null,
    with: '',
  },
  {
    id: 'everything-bazaar',
    title: 'Everything Bazaar',
    year: 2026,
    status: 'ongoing',
    bucket: 'games',
    img: '/clips/poster-6.jpg',
    alt: 'A dark shop screen with a product box, from Everything Bazaar',
    clip: null,
    href: bazaar,
    with: '',
  },
  {
    id: 'bioluminescent-flow',
    title: 'Bioluminescent Flow',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/bioluminescent-flow.webp',
    alt: 'Glowing particle trails on a dark field, from Bioluminescent Flow',
    clip: '/clips/cut-2a.mp4',
    href: flow,
    with: '',
  },
  {
    id: 'webcam-magic',
    title: 'Webcam Magic',
    year: 2026,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/webcam-magic.webp',
    alt: 'A face rendered as a pixel mirror, from Webcam Magic',
    clip: '/clips/cut-1a.mp4',
    href: webcam,
    with: '',
  },
  {
    id: 'the-line-before',
    title: 'The Line Before',
    year: 2025,
    status: 'finished',
    bucket: 'interactive pieces',
    img: '/playground/the-line-before.webp',
    alt: 'A scene from The Line Before',
    clip: null,
    href: lineBefore,
    with: 'with Kahran Singh',
  },
];

/* ---------- everything the pipeline knows about ---------- */
const fromPipeline = generated.flatMap((group) =>
  group.projects.map((p) => {
    const year = yearOf(p, group);
    return {
      id: p.slug,
      title: p.title,
      year,
      // only the current year's (un)seen edition is still being added to;
      // every earlier edition is closed, like everything else in the pipeline
      status:
        p.slug.indexOf('unseen') === 0 && year === CURRENT_YEAR ? 'ongoing' : 'finished',
      bucket: bucketFor(p.categories),
      img: p.cover,
      alt: `Cover image for ${p.title}`,
      clip: null,
      href: `/works/${p.slug}/`,
      with: WITH_CHARU.indexOf(p.slug) !== -1 ? 'with Charu' : '',
    };
  })
);

// newest first; the sort is stable, so the additions sit ahead of pipeline entries
// from the same year.
const works = [...additions, ...fromPipeline].sort((a, b) => b.year - a.year);

const navLinks = [
  { label: 'works', href: '#works' },
  { label: 'friends', href: '/friends/' },
  { label: 'about', href: '/about/' },
  { label: 'contact', href: 'mailto:hello@divyatak.art' },
];
---
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak · type b</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<!-- Fraunces (variable opsz / SOFT / WONK / wght, roman + italic) = the text voice.
     Instrument Sans (variable wght) = the apparatus voice. -->
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght,SOFT,WONK@0,9..144,400..600,0..100,0..1;1,9..144,400..500,0..100,0..1&family=Instrument+Sans:wght@400..600&display=swap" rel="stylesheet" />
<style>
  /* ================= TYPE B / ROUND 2 — THE CLASSICAL AXIS =================

     TWO RELATIONSHIPS, AND THEY ARE THE WHOLE DESIGN.

     1 · ONE SCALE — ratio root 2 (1.414), the book ratio.
         Because root 2 doubles every second step, the display run is a clean
         octave cascade and the half-steps fall between:

              136  name            ─┐
               96                   │ (unused — the leap is deliberate)
               68  works chapter    │  each display level is exactly
               48                   │  DOUBLE the one below it:
               34  lead             │  136 · 68 · 34 · 17
               24  docked name      │
               17  text            ─┘
               12  apparatus

         Six sizes on the page. Every one of them is 136 / 2^n or its root-2
         half-step. Nothing is chosen by eye.

     2 · ONE AXIS — --axis, a single left margin that never moves, from the
         first pixel of the dark act to the last line of the folio. On it:
         the name, the docked name, the lead, the body, the coda, the nav
         wordmark and its links, the chapter word "works", both lens rows,
         the first column of the grid, load-more, the footer. The name does
         not travel diagonally any more — start x EQUALS end x, so it rises
         straight UP the axis and shrinks. The line is the armature; the
         morph now demonstrates it.

         OFF the axis, on purpose, three things: the "lately" slot (a second,
         weaker axis far right — its emptiness is the counterweight that makes
         the left line read as a decision), the motion toggle (machine chrome,
         kept out of the reading line), and columns 2–3 of the grid (only the
         first column can sit on the axis; the captions' shared cap-line is
         what ties the other two back to it).

     3 · RHYTHM — --u: 13px. Every leading value and every vertical space is
         a multiple: text 17/26 (2u), captions 12/19.5 (1.5u), lead 34/39 (3u),
         chapter 68/65 (5u), sections 130 (10u). The page is a baseline grid
         that happens to also be a scale.

     4 · VOICES — the page is a book, so TEXT is the serif (Fraunces, text cut
         at 17px, display cut at 34/68/136) and the APPARATUS is the sans
         (Instrument Sans, 12px, tracked +0.16em, lowercase — marginalia set
         like small caps without depending on a smcp table). Nav, filters,
         plate captions, buttons, footer: all apparatus. Nothing in between.

     5 · CASE — lowercase throughout, her register, but set as a masthead:
         display closes to −0.03em, apparatus opens to +0.16em. The tracking
         curve is inverse to the size curve, which is what stops lowercase
         from reading as casual.

     6 · ITALIC — twice. The key word in the lead, and the coda, which becomes
         a colophon line at the foot of the text block.

     MORPH-CRITICAL: .name and #name-slot are typographically identical (same
     family, wght, SOFT, WONK, tracking in em, line-height 1, opsz PINNED to
     144 with font-optical-sizing: none). Automatic opsz would draw different
     widths at 136px and 24px and the measured ratio would stop describing the
     scale. The JS reads both font sizes; only the start POSITION was rewritten.
     ======================================================================== */

  :root {
    --axis: 4.5rem;   /* the one left margin — everything hangs off it */
    --un: 13;         /* rhythm unit, unitless — so leading stays a RATIO */
    --u: calc(var(--un) * 1px);  /* the same unit as a length, for spacing */

    --t-name: clamp(3rem, 9.6vw, 8.5rem);   /* 136 */
    --t-chap: clamp(2.5rem, 5.4vw, 4.25rem); /* 68  */
    --t-lead: clamp(1.75rem, 3.4vw, 2.125rem); /* 34 */
    --t-dock: 1.5rem;  /* 24 */
    --t-text: 17px;
    --t-app: 12px;

    --serif: 'Fraunces', Georgia, 'Times New Roman', serif;
    --sans: 'Instrument Sans', system-ui, -apple-system, sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html {
    scroll-behavior: smooth;
    /* the dark act snaps; the white folio has no snap points, so it scrolls free */
    scroll-snap-type: y proximity;
  }
  body {
    font-family: var(--serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 14, 'SOFT' 40, 'WONK' 0, 'wght' 400;
    color: #222;
    background: #111;
    font-size: var(--t-text);
    line-height: calc(var(--un) * 2 / 17);  /* 26 / 17 */
    font-variant-numeric: oldstyle-num proportional-nums;
    text-rendering: optimizeLegibility;
  }
  img { max-width: 100%; display: block; }
  a { color: inherit; text-decoration: none; }
  :focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }

  /* light-on-dark makes a modulated serif look fatty under subpixel rendering;
     the white folio keeps the default rasteriser, where it wants the weight */
  .name, .stage, .bar:not(.ink) {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* the apparatus voice — one rule, reused everywhere it belongs */
  .bar, .lens, .more, .empty, .foot, .entry h3, .lately .label, .motion-toggle {
    font-family: var(--sans);
    font-optical-sizing: auto;
    font-variation-settings: normal;
    font-size: var(--t-app);
    letter-spacing: 0.16em;
    text-transform: lowercase;
  }

  /* ---------- the video layer: fixed, behind everything, never scrolls away ---------- */
  .backdrop {
    position: fixed;
    inset: 0;
    z-index: 0;
    background: #111 url('/clips/poster-2.jpg') center / cover no-repeat;
  }
  .backdrop video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* the montage is uniform 1920x1080; cover keeps it honest anyway */
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .backdrop video.on { opacity: 1; }
  .backdrop .scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.14) 42%, rgba(0,0,0,0.34) 100%);
  }

  /* ---------- one nav bar — a single left-hung line, right side left empty ---------- */
  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 6;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: calc(var(--u) * 3);
    padding: calc(var(--u) * 1.5) var(--axis);
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 500;
    transition: background-color 0.25s ease, border-color 0.25s ease;
    border-bottom: 1px solid transparent;
  }
  /* the wordmark is the name, so it stays in the text voice — Fraunces' TEXT
     cut (opsz 14), a different drawing from the display: less contrast,
     sturdier joins. A display cut shrunk to 13px would shatter. */
  .bar .wordmark {
    font-family: var(--serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 14, 'SOFT' 30, 'WONK' 1, 'wght' 600;
    font-size: 13px;
    letter-spacing: 0.01em;
    color: #fff;
    opacity: 1;
    transition: opacity 0.3s ease, color 0.25s ease;
  }
  /* on screen 1 the big name is the wordmark, so the bar keeps quiet —
     the space stays reserved, which is what keeps the links off the axis edge */
  body:not(.docked) .bar .wordmark { opacity: 0; pointer-events: none; }
  .bar .links {
    display: flex;
    justify-content: flex-start;   /* hangs left from the wordmark; no spreading */
    gap: calc(var(--u) * 2);
  }
  .bar a { color: rgba(255,255,255,0.72); transition: color 0.25s ease; }
  .bar a:hover { color: #fff; }
  /* once the white ground is under the bar, the bar turns to ink */
  .bar.ink {
    background: rgba(255,255,255,0.86);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom-color: #eee;
  }
  .bar.ink .wordmark { color: #222; }
  .bar.ink a { color: #999; }
  .bar.ink a:hover { color: #222; }

  /* ---------- the one name: flush to the axis, never centred ----------
     Typographically identical to #name-slot (see morph note above). */
  .name {
    position: fixed;
    left: 0;
    top: 0;
    z-index: 2; /* above the stage, under the white ground */
    width: max-content;
    white-space: nowrap;
    transform-origin: 0 0;
    font-family: var(--serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 25, 'WONK' 1, 'wght' 600;
    font-size: var(--t-name);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    text-transform: lowercase;
    pointer-events: none;
    opacity: 0;
    will-change: transform;
  }
  .name.ready { opacity: 1; }

  /* ---------- the stage: everything that sits over the video ---------- */
  .stage { position: relative; z-index: 1; }
  .stage a { color: #fff; }

  /* the shell no longer centres — it starts at the axis and lets the right rag */
  .shell {
    max-width: none;
    margin: 0;
    padding: 0 var(--axis);
  }
  .shell.narrow { max-width: none; }

  /* ---------- screen 1 ---------- */
  .opening {
    position: relative;
    height: 100vh;
    scroll-snap-align: start;
  }
  /* the cue comes off the centre and onto the axis: it is marginalia under the
     name, the first thing that proves the line exists */
  .scroll-cue {
    position: absolute;
    bottom: calc(var(--u) * 4);
    left: var(--axis);
    transform: none;
    color: rgba(255,255,255,0.7);
    font-size: var(--t-text);
    line-height: 1;
    transition: opacity 0.3s ease;
  }
  .scroll-cue:hover { color: #fff; }
  body.docked .scroll-cue { opacity: 0; pointer-events: none; }

  /* ---------- screen 2: the docked name + the intro ---------- */
  .overlay {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding: calc(var(--u) * 10) 0;
    scroll-snap-align: start;
    background: linear-gradient(
      to bottom,
      rgba(0,0,0,0) 0%,
      rgba(0,0,0,0.66) 20%,
      rgba(0,0,0,0.86) 55%,
      rgba(0,0,0,0.95) 100%
    );
  }
  /* text block on the axis; the reserved slot pushed out to the second, weaker
     axis. The container is allowed to run wide so the air between them is real. */
  .intro-cols {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
    align-items: start;
    gap: calc(var(--u) * 6);
    max-width: 1180px;
  }
  .intro {
    color: rgba(255,255,255,0.78);
    max-width: 62ch;   /* the measure, in the text size — a book column */
  }
  .intro p { margin-bottom: calc(var(--u) * 2); }

  /* ---------- the reserved slot: held space, on purpose ----------
     A rule, a label, and nothing else. The height is the point. */
  .lately {
    /* 4u drops the rule onto the lead's cap-line: dock (24) + its 2u space */
    margin-top: calc(var(--u) * 4);
    padding-top: var(--u);
    min-height: calc(var(--u) * 27);
    border-top: 1px solid rgba(255,255,255,0.28);
  }
  .lately .label {
    display: block;
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 500;
    color: rgba(255,255,255,0.5);
  }
  /* one hairline far below, so the emptiness reads as measured, not missing */
  .lately::after {
    content: '';
    display: block;
    width: calc(var(--u) * 3);
    height: 1px;
    margin-top: calc(var(--u) * 18);
    background: rgba(255,255,255,0.16);
  }
  .intro a {
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.35);
  }
  .intro a:hover { border-bottom-color: #fff; }

  /* the slot the name lands in — invisible, it only holds the position.
     24px: the root-2 half-step between text and lead. The name arrives
     SMALLER than the lead on purpose — once you are inside the book, the
     statement outranks the byline, and the name becomes a running head. */
  .name-slot {
    font-family: var(--serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 25, 'WONK' 1, 'wght' 600;
    font-size: var(--t-dock);
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: lowercase;
    visibility: hidden;
    margin-bottom: calc(var(--u) * 2);
  }

  /* the lead: display cut, weight held at 400 so modulation does the work
     instead of mass. 34 / 39 — three rhythm units of leading. */
  .intro .lead {
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 72, 'SOFT' 45, 'WONK' 0, 'wght' 400;
    font-size: var(--t-lead);
    line-height: calc(var(--un) * 3 / 34);
    letter-spacing: -0.018em;
    color: #fff;
    max-width: 22ch;
    text-wrap: balance;
    margin-bottom: calc(var(--u) * 3);
  }
  /* the one word the sentence is actually about */
  .intro .lead em {
    font-style: italic;
    font-variation-settings: 'opsz' 72, 'SOFT' 60, 'WONK' 1, 'wght' 400;
  }
  /* the colophon line that closes the text block */
  .intro .coda {
    font-style: italic;
    font-variation-settings: 'opsz' 14, 'SOFT' 60, 'WONK' 1, 'wght' 400;
    margin-top: calc(var(--u) * 3);
    margin-bottom: 0;
    color: rgba(255,255,255,0.55);
  }

  /* ---------- video chrome (deliberately off-axis: machine, not text) ---------- */
  .video-chrome {
    position: sticky;
    bottom: 0;
    z-index: 3;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    padding: 0 var(--axis) calc(var(--u) * 2);
    margin-top: calc(var(--u) * -3.5);
    pointer-events: none;
  }
  .video-chrome > * { pointer-events: auto; }
  .motion-toggle {
    background: none;
    color: rgba(255,255,255,0.6);
    border: none;
    border-bottom: 1px solid rgba(255,255,255,0.3);
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 500;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .motion-toggle:hover { color: #fff; border-bottom-color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    .backdrop video { transition: none; }
    .scroll-cue, .tile, .tile .media video, .bar, .bar .wordmark { transition: none !important; }
  }

  /* ---------- solid ground: the folio slides over the video ---------- */
  .ground {
    position: relative;
    z-index: 2;
    background: #fff;
  }

  /* the folio starts on the same axis as the name did — that is the whole page */
  .works {
    padding: calc(var(--u) * 10) var(--axis) 0;
    scroll-margin-top: calc(var(--u) * 5);
  }
  /* the chapter opening: word on the axis, apparatus stacked under it, one rule
     closing the head — the axis's horizontal partner */
  .works-head {
    padding-bottom: calc(var(--u) * 3);
    border-bottom: 1px solid #ebebeb;
    margin-bottom: calc(var(--u) * 4);
  }
  .works-head h2 {
    font-family: var(--serif);
    font-optical-sizing: none;
    font-variation-settings: 'opsz' 144, 'SOFT' 25, 'WONK' 1, 'wght' 500;
    font-size: var(--t-chap);
    line-height: calc(var(--un) * 5 / 68);
    letter-spacing: -0.032em;
    text-transform: lowercase;
    color: #222;
    margin-bottom: calc(var(--u) * 3);
  }

  /* ---------- lenses: two lines of marginalia, both on the axis ---------- */
  .lens-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
  }
  .lens-row + .lens-row { margin-top: var(--u); }
  .lens {
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 500;
    color: #999;
    background: none;
    border: none;
    border-bottom: 1px solid transparent;
    padding: 0 0 2px;
    cursor: pointer;
  }
  .lens:hover { color: #222; }
  .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  /* the second row is the same SIZE — it recedes by ink and weight, not by
     shrinking. Two sizes in the apparatus would break the scale. */
  .lens-row.quiet .lens { font-weight: 400; color: #c2c2c2; }
  .lens-row.quiet .lens:hover { color: #636363; }
  .lens-row.quiet .lens[aria-pressed="true"] { color: #222; border-bottom-color: #222; }
  .lens-row .sep { font-family: var(--sans); font-size: var(--t-app); color: #e0e0e0; }

  /* ---------- the grid: unchanged 3 columns, 16:10 plates ---------- */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
    column-gap: calc(var(--u) * 2);
    row-gap: calc(var(--u) * 4);
    padding-bottom: calc(var(--u) * 4);
  }
  .entry[hidden] { display: none; }

  /* column-reverse lifts the caption ABOVE its plate without touching the
     markup: the label reads first, the plate follows — catalogue order. It
     also lays a shared cap-line of type across every row, which is how
     columns 2 and 3 get tied back to the axis. */
  .tile {
    display: flex;
    flex-direction: column-reverse;
    transition: transform 0.35s ease;
  }
  .entry:hover .tile, .entry:focus-within .tile { transform: translateY(-4px); transition-duration: 0.2s; }
  .tile .media {
    display: block;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #f4f4f4;
    box-shadow: 0 1px 8px rgba(0,0,0,0.10);
  }
  .tile .media img,
  .tile .media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* nothing stretches, ever */
  }
  .tile .media video {
    opacity: 0;
    transition: opacity 0.35s ease;
  }
  .tile .media video.on { opacity: 1; transition-duration: 0.2s; }

  /* plate labels: apparatus, tracked, two lines of 1.5u reserved whether the
     title needs them or not — so every plate in a row starts on one line */
  .entry h3 {
    line-height: calc(var(--un) * 1.5 / 12);
    min-height: calc(var(--u) * 3);
    margin: 0 0 var(--u);
    letter-spacing: 0.1em;   /* labels open, but a title still has to be read */
    font-weight: 500;
    font-variant-numeric: oldstyle-num proportional-nums;
    color: #222;
  }
  .entry.seen h3::after { content: ' \00b7'; color: #ccc; }

  /* ---------- nine at a time — the control returns to the line ---------- */
  .more-wrap {
    text-align: left;
    padding-bottom: calc(var(--u) * 10);
  }
  .more {
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 500;
    color: #bbb;
    background: none;
    border: none;
    border-bottom: 1px solid #eee;
    padding: 0 0 3px;
    cursor: pointer;
  }
  .more:hover { color: #222; border-bottom-color: #222; }
  .more[hidden] { display: none; }

  .empty {
    line-height: calc(var(--un) * 2 / 12);
    color: #999;
    padding: calc(var(--u) * 2) 0;
  }
  .empty[hidden] { display: none; }

  /* ---------- foot: the last line on the axis ---------- */
  .foot {
    padding: 0 var(--axis) calc(var(--u) * 6);
    line-height: calc(var(--un) * 2 / 12);
    font-weight: 400;
    color: #999;
  }
  .foot a { color: #999; }
  .foot a:hover { color: #222; }
  .foot .dot { margin: 0 0.5rem; color: #ddd; }

  /* ---------- tooling only — not part of the design ---------- */
  .proto-pill {
    position: fixed;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    z-index: 9999;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: #111;
    color: #fff;
    border-radius: 999px;
    padding: 0.4rem 0.85rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 12px;
    font-weight: 400;
    font-variation-settings: normal;
    letter-spacing: 0;
    line-height: 1;
    text-transform: none;
  }
  .proto-pill a { color: rgba(255,255,255,0.65); }
  .proto-pill a:hover { color: #fff; }
  .proto-pill .now { color: #fff; font-weight: 700; }
  .proto-pill .bar-sep { color: rgba(255,255,255,0.3); }

  @media (max-width: 1100px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 900px) {
    /* one variable moves the whole page's armature */
    :root { --axis: 1.5rem; --un: 12; --t-text: 16px; }
    html { scroll-snap-type: none; }
    /* the denominators follow the sizes down, so the rhythm stays exact:
       body 16/24 (2u), lead 28/36 (3u) */
    body { line-height: calc(var(--un) * 2 / 16); }
    .intro .lead { line-height: calc(var(--un) * 3 / 28); }
    .bar { gap: calc(var(--u) * 2); }
    .bar .links { gap: calc(var(--u) * 1.5); }
    .overlay { padding: calc(var(--u) * 9) 0; }
    /* the reserved slot stacks under the text; the axis stays */
    .intro-cols { grid-template-columns: 1fr; gap: calc(var(--u) * 4); }
    .lately { margin-top: 0; min-height: calc(var(--u) * 18); }
    .lately::after { margin-top: calc(var(--u) * 12); }
    .works { padding: calc(var(--u) * 8) var(--axis) 0; }
  }

  @media (max-width: 700px) {
    .grid { grid-template-columns: 1fr; row-gap: calc(var(--u) * 5); }
  }
</style>
</head>
<body>

  <!-- ============ the video, fixed behind everything ============ -->
  <div class="backdrop" aria-hidden="true">
    <video id="vid" muted playsinline loop preload="auto" poster="/clips/poster-2.jpg" src="/clips/montage.mp4"></video>
    <div class="scrim"></div>
  </div>

  <!-- ============ one nav bar, white over the video, ink over the folio ============ -->
  <header class="bar" id="bar">
    <a class="wordmark" href="/prototype/type-b/">divya tak</a>
    <nav class="links" aria-label="site">
      {navLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>
  </header>

  <!-- ============ the name: one element, it becomes the docked title ============ -->
  <h1 class="name" id="name">divya tak</h1>

  <div class="stage">

    <!-- ============ screen 1 ============ -->
    <div class="opening" id="top">
      <a class="scroll-cue" href="#intro" aria-label="scroll down to the introduction">&#8595;</a>
    </div>

    <!-- ============ screen 2: docked name + intro ============ -->
    <section class="overlay" id="intro">
      <div class="shell narrow">
        <div class="intro-cols">
          <div class="intro">
            <!-- the slot the fixed name lands in; it holds space and nothing else -->
            <p class="name-slot" id="name-slot" aria-hidden="true">divya tak</p>
            <p class="lead">I make <em>interactive</em> things.</p>
            <p>Hi! Hello! I'm Divya. I am a cross domain creative human. I love making many things with many people.</p>
            <p>
              I run a storytelling studio called <a href="https://joyus.studio" target="_blank" rel="noopener">Joyus</a>
              with my friend <a href="https://kahransingh.com" target="_blank" rel="noopener">Kahran</a>.
              I make games with <a href="https://charutak.xyz" target="_blank" rel="noopener">Charu</a>.
              I often collaborate with <a href="https://varuns.work" target="_blank" rel="noopener">Varun Ramanna</a> on VFX projects.
            </p>
            <p class="coda">You are at the home of some of my creations.</p>
          </div>

          <!-- RESERVED SLOT — "lately / new stuff".
               The space is intentional and stays empty until its design exists.
               Do not fill this with a list, a feed, or placeholder content. -->
          <aside class="lately" aria-label="lately">
            <span class="label">lately</span>
          </aside>
        </div>
      </div>
    </section>

    <div class="video-chrome">
      <button class="motion-toggle" id="motion-toggle" aria-pressed="false" aria-label="pause background clips">pause</button>
    </div>
  </div>

  <!-- ============ the folio: white ground slides over the video ============ -->
  <main class="ground" id="ground">

    <section class="works" id="works" aria-label="works">
      <div class="works-head">
        <h2>works</h2>

        <div class="lenses">
          <div class="lens-row" role="group" aria-label="filter by kind">
            <button class="lens" data-bucket="all" aria-pressed="true">all</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="games" aria-pressed="false">games</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="interactive pieces" aria-pressed="false">interactive pieces</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-bucket="on paper" aria-pressed="false">on paper</button>
          </div>
          <div class="lens-row quiet" role="group" aria-label="filter by status">
            <button class="lens" data-status="latest" aria-pressed="true">latest</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="in progress" aria-pressed="false">in progress</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="ongoing" aria-pressed="false">ongoing</button><span class="sep" aria-hidden="true">&middot;</span>
            <button class="lens" data-status="finished" aria-pressed="false">finished</button>
          </div>
        </div>
      </div>

      <!-- ---- the grid: plate + label. CSS lifts the label above the plate. ---- -->
      <div class="grid" id="grid">
        {works.map((w) => (
          <article class="entry" data-id={w.id} data-bucket={w.bucket} data-status={w.status}>
            {w.href ? (
              <a
                class="tile"
                href={w.href}
                target={isExt(w.href) ? '_blank' : undefined}
                rel={isExt(w.href) ? 'noopener' : undefined}
              >
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </a>
            ) : (
              <div class="tile">
                <span class="media">
                  <img src={w.img} alt={w.alt} loading="lazy" width="800" height="500" />
                  {w.clip && <video class="clip" muted loop playsinline preload="none" data-src={w.clip}></video>}
                </span>
                <h3>{w.title}</h3>
              </div>
            )}
          </article>
        ))}
      </div>

      <p class="empty" id="empty" hidden>nothing under this lens yet.</p>

      <div class="more-wrap">
        <button class="more" id="more" type="button" hidden>more</button>
      </div>
    </section>

    <footer class="foot">
      <a href="/friends/">friends</a><span class="dot" aria-hidden="true">&middot;</span>
      <a href="/about/">about</a><span class="dot" aria-hidden="true">&middot;</span>
      <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
    </footer>

  </main>

  <!-- ============ tooling only — variant switcher, not part of the design ============ -->
  <div class="proto-pill" aria-label="prototype variants">
    <a href="/prototype/ongoing/">base</a><span class="bar-sep" aria-hidden="true">·</span>
    <a href="/prototype/type-a/">a</a><span class="bar-sep" aria-hidden="true">·</span>
    <span class="now" aria-current="page">b</span><span class="bar-sep" aria-hidden="true">·</span>
    <a href="/prototype/type-c/">c</a>
  </div>

<script is:inline>
(function () {
  var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---------- montage: one pre-composed file (/clips/montage.mp4) ---------- */
  // 12 cuts of 5.2s each, composed offline with ffmpeg at a uniform 1920x1080.
  // Kept here so anything that needs to reason about playback time still can.
  // Sources 5 and 6 no longer exist in /clips/, so they are not in the order.
  var order = ['2a','7a','1a','4a','8b','3a','2b','7b','1b','4b','8a','3b'];
  var MONTAGE_SECONDS = 62.4;
  var CUT = MONTAGE_SECONDS / order.length; // 5.2s

  var vid = document.getElementById('vid');
  var toggle = document.getElementById('motion-toggle');
  var paused = prefersReduced;
  var started = false;

  function start() {
    started = true;
    vid.classList.add('on');
    vid.play().catch(function () {});
  }

  function setToggleUi() {
    toggle.setAttribute('aria-pressed', paused ? 'true' : 'false');
    toggle.setAttribute('aria-label', paused ? 'play background clips' : 'pause background clips');
    toggle.textContent = paused ? 'play' : 'pause';
  }

  toggle.addEventListener('click', function () {
    paused = !paused;
    setToggleUi();
    if (paused) {
      vid.pause();
    } else if (!started) {
      start(); // reduced-motion visitors opt in here
    } else {
      vid.play().catch(function () {});
    }
  });

  setToggleUi();
  if (!prefersReduced) start();
  // under reduced motion nothing plays: the poster still shows via the
  // backdrop's CSS background and the untouched poster attribute.

  /* ---------- the name: ONE element travelling UP THE AXIS into its slot ----------
     ROUND 2. The mechanism is untouched — one element, measured against the
     invisible .name-slot, interpolated on scroll. What changed is the start:
     the name is no longer centred in the viewport. Its start x is taken FROM
     the slot, so start x === end x and the travel is purely vertical. The name
     rises along the same left line the lead, the body, the chapter word and the
     first column of the grid all sit on. Nothing about the axis is hard-coded
     here: it is read off the slot, which is hung off --axis in CSS. */
  var nameEl = document.getElementById('name');
  var slotEl = document.getElementById('name-slot');
  var overlayEl = document.getElementById('intro');
  var groundEl = document.getElementById('ground');
  var barEl = document.getElementById('bar');

  var M = { x0: 0, y0: 0, x1: 0, yDoc: 0, s1: 0.2, end: 1 };
  var docked = null;
  var inked = null;

  // where the big name sits on screen 1: its baseline block bottoms out just
  // above the optical centre, title-page fashion, with the cue below it.
  var START_BOTTOM = 0.52;

  function measure() {
    nameEl.style.transform = 'none';
    var nr = nameEl.getBoundingClientRect();       // left:0 / top:0, so this is its natural size
    var sr = slotEl.getBoundingClientRect();
    var nf = parseFloat(getComputedStyle(nameEl).fontSize) || 1;
    var sf = parseFloat(getComputedStyle(slotEl).fontSize) || 1;

    M.x1 = sr.left + (window.pageXOffset || 0);    // the axis
    M.x0 = M.x1;                                   // the name never leaves it
    M.y0 = Math.max(0, window.innerHeight * START_BOTTOM - nr.height);
    M.yDoc = sr.top + (window.pageYOffset || 0);   // the slot's position in the document
    M.s1 = sf / nf;                                // both use line-height 1, so top-left aligns
    // scroll distance between the two snap points, measured from the document
    M.end = Math.max(1, overlayEl.getBoundingClientRect().top + (window.pageYOffset || 0));
    paint();
    nameEl.classList.add('ready');
  }

  function paint() {
    var y = window.pageYOffset || document.documentElement.scrollTop || 0;
    var p = y / M.end;
    if (p < 0) p = 0;
    if (p > 1) p = 1;
    if (prefersReduced) p = p > 0.35 ? 1 : 0; // jump between states, never tween

    var tx = M.x0 + (M.x1 - M.x0) * p;        // constant: the axis
    var yEnd = M.yDoc - y;                    // where the slot is on screen right now
    var ty = M.y0 + (yEnd - M.y0) * p;        // past p=1 this tracks the slot, so it scrolls away
    var s = 1 + (M.s1 - 1) * p;
    nameEl.style.transform =
      'translate3d(' + tx.toFixed(2) + 'px,' + ty.toFixed(2) + 'px,0) scale(' + s.toFixed(4) + ')';

    var d = p > 0.5;
    if (d !== docked) { docked = d; document.body.classList.toggle('docked', d); }

    // the bar turns to ink once the white ground has slid under it
    var ink = groundEl.getBoundingClientRect().top <= barEl.offsetHeight;
    if (ink !== inked) { inked = ink; barEl.classList.toggle('ink', ink); }
  }

  var ticking = false;
  window.addEventListener('scroll', function () {
    if (ticking) return;
    ticking = true;
    window.requestAnimationFrame(function () { ticking = false; paint(); });
  }, { passive: true });

  var resizeTimer = null;
  window.addEventListener('resize', function () {
    if (resizeTimer) clearTimeout(resizeTimer);
    resizeTimer = setTimeout(measure, 120);
  });

  measure();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(measure);
  window.addEventListener('load', measure);

  /* ---------- wheel assist: the dark act's two screens snap decisively ----------
     CSS scroll-snap stays as the fallback; this just makes one gesture land. */
  var coarse = window.matchMedia('(pointer: coarse)').matches;
  if (!prefersReduced && !coarse) {
    var lockUntil = 0;
    var THRESHOLD = 8;
    window.addEventListener('wheel', function (e) {
      if (e.ctrlKey) return;                       // pinch zoom
      var y = window.pageYOffset || 0;
      var end = M.end;
      if (y > end + 4) return;                     // in the folio: hands off
      var now = Date.now();
      if (now < lockUntil) { e.preventDefault(); return; } // swallow the tail of a gesture
      if (e.deltaY > THRESHOLD && y < end - 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: end, behavior: 'smooth' });
      } else if (e.deltaY < -THRESHOLD && y > 4) {
        e.preventDefault();
        lockUntil = now + 700;
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }, { passive: false });
  }

  /* ---------- folio: lenses (bucket, status) + nine at a time ---------- */
  var bucketBtns = document.querySelectorAll('.lens[data-bucket]');
  var statusBtns = document.querySelectorAll('.lens[data-status]');
  var items = document.querySelectorAll('.entry');
  var emptyEl = document.getElementById('empty');
  var moreBtn = document.getElementById('more');
  var bucket = 'all';
  var status = 'latest';

  var PAGE = 9;
  var shown = PAGE;

  // keepPage=true when the visitor asked for more; any lens change starts over
  function apply(keepPage) {
    if (!keepPage) shown = PAGE;
    var matched = 0;
    items.forEach(function (el) {
      var bOk = bucket === 'all' || el.dataset.bucket === bucket;
      var sOk = status === 'latest' || el.dataset.status === status;
      var hit = bOk && sOk;
      if (hit) matched++;
      el.hidden = !(hit && matched <= shown);
    });
    emptyEl.hidden = matched > 0;
    moreBtn.hidden = matched <= shown; // no counts, it just goes quiet when done
  }

  bucketBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      bucket = b.dataset.bucket;
      bucketBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.bucket === bucket ? 'true' : 'false');
      });
      apply(false);
    });
  });

  statusBtns.forEach(function (b) {
    b.addEventListener('click', function () {
      status = b.dataset.status;
      statusBtns.forEach(function (o) {
        o.setAttribute('aria-pressed', o.dataset.status === status ? 'true' : 'false');
      });
      apply(false);
    });
  });

  moreBtn.addEventListener('click', function () {
    shown += PAGE;
    apply(true);
  });

  apply(false);

  /* ---------- hover footage: only where a real clip exists ---------- */
  if (!prefersReduced) {
    document.querySelectorAll('.tile .clip').forEach(function (v) {
      var tile = v.closest('.tile');
      function enter() {
        if (!v.src) v.src = v.dataset.src;
        v.classList.add('on');
        v.play().catch(function () {});
      }
      function leave() {
        v.classList.remove('on');
        v.pause();
        try { v.currentTime = 0; } catch (err) {}
      }
      tile.addEventListener('mouseenter', enter);
      tile.addEventListener('focusin', enter);
      tile.addEventListener('mouseleave', leave);
      tile.addEventListener('focusout', leave);
    });
  }

  /* ---------- residue (session marks, never counted) ---------- */
  var KEY = 'proto-ongoing-seen';
  var seen;
  try {
    seen = JSON.parse(sessionStorage.getItem(KEY) || '[]');
  } catch (err) {
    seen = [];
  }
  function mark(id) {
    if (seen.indexOf(id) === -1) {
      seen.push(id);
      try { sessionStorage.setItem(KEY, JSON.stringify(seen)); } catch (err) {}
    }
    document.querySelectorAll('[data-id="' + id + '"]').forEach(function (el) {
      el.classList.add('seen');
    });
  }
  seen.forEach(mark);
  items.forEach(function (el) {
    el.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () { mark(el.dataset.id); });
    });
  });
})();
</script>
</body>
</html>
