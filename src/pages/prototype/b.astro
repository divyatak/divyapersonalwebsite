<!-- THROWAWAY PROTOTYPE — angle hypothesis B, delete after decision -->
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="robots" content="noindex" />
<title>divya tak — builds</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700&family=IBM+Plex+Mono:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
<style>
  :root {
    --paper: #f2f1ec;
    --card: #faf9f5;
    --ink: #1a1a15;
    --muted: #72716a;
    --faint: #a3a299;
    --rule: #dcdbd1;
    --live: #17843f;
    --wip: #b06e08;
    --mono: "IBM Plex Mono", ui-monospace, monospace;
    --grot: "Archivo", system-ui, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { background: var(--paper); }
  body {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.55;
    color: var(--ink);
    max-width: 920px;
    margin: 0 auto;
    padding: 56px 24px 120px;
    -webkit-font-smoothing: antialiased;
  }
  a { color: inherit; }
  ::selection { background: var(--ink); color: var(--paper); }

  /* ---------- hero ---------- */
  .stamp {
    display: flex; flex-wrap: wrap; gap: 6px 18px;
    font-size: 11px; color: var(--faint);
    letter-spacing: 0.04em;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--rule);
    margin-bottom: 44px;
  }
  .stamp b { font-weight: 500; color: var(--muted); }
  .stamp .push { margin-left: auto; }

  header.hero { margin-bottom: 64px; }
  h1 {
    font-family: var(--grot);
    font-weight: 700;
    font-size: clamp(28px, 5vw, 40px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-bottom: 18px;
  }
  .claim {
    font-family: var(--grot);
    font-weight: 500;
    font-size: clamp(16px, 2.6vw, 20px);
    line-height: 1.45;
    max-width: 40em;
    margin-bottom: 14px;
  }
  .claim .dim { color: var(--muted); }
  .quote {
    font-style: italic;
    color: var(--muted);
    font-size: 13px;
    max-width: 44em;
  }

  /* ---------- section headers ---------- */
  section { margin-bottom: 60px; }
  h2 {
    display: flex; align-items: baseline; gap: 12px;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 12px;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  h2::after { content: ""; flex: 1; border-bottom: 1px solid var(--rule); transform: translateY(-4px); }
  h2 .count { color: var(--faint); font-weight: 400; letter-spacing: 0; }

  /* ---------- index rows ---------- */
  .row {
    display: grid;
    grid-template-columns: 3.4rem 40px 1fr auto;
    gap: 0 16px;
    align-items: center;
    padding: 14px 8px 14px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: background-color 120ms ease;
  }
  a.row:hover, a.row:focus-visible { background: var(--card); }
  a.row:focus-visible { outline: 2px solid var(--ink); outline-offset: -2px; }
  a.row:hover .ttl, a.row:focus-visible .ttl { text-decoration: underline; text-underline-offset: 3px; }
  a.row:hover .status, a.row:focus-visible .status { transform: translateX(2px); }

  .yr { font-size: 12px; color: var(--faint); }

  .tile {
    width: 40px; height: 40px;
    border: 1px solid var(--rule);
    border-radius: 2px;
    background: var(--card);
    object-fit: cover;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px; color: var(--faint);
    overflow: hidden;
    flex-shrink: 0;
  }
  img.tile { display: block; }

  .body { min-width: 0; }
  .ttl {
    font-family: var(--grot);
    font-weight: 600;
    font-size: 15px;
    letter-spacing: -0.005em;
  }
  .desc { color: var(--muted); }
  .desc::before { content: " — "; color: var(--faint); }
  .tags {
    display: block;
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.02em;
    margin-top: 3px;
  }

  .status {
    font-size: 12px;
    white-space: nowrap;
    color: var(--muted);
    display: flex; align-items: center; gap: 7px;
    justify-self: end;
    transition: transform 120ms ease;
  }
  .dot {
    width: 7px; height: 7px; border-radius: 50%;
    background: var(--faint);
    flex-shrink: 0;
  }
  .status.live { color: var(--live); }
  .status.live .dot { background: var(--live); animation: pulse 2.4s ease-in-out infinite; }
  .status.wip { color: var(--wip); }
  .status.wip .dot { background: var(--wip); }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(23, 132, 63, 0.35); }
    50% { box-shadow: 0 0 0 5px rgba(23, 132, 63, 0); }
  }

  /* experiments: slightly tighter */
  .tight .row { padding: 10px 8px 10px 0; }
  .tight .ttl { font-size: 14px; }

  /* ---------- on paper ---------- */
  .paper-block {
    display: flex; gap: 20px; align-items: flex-start;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
  }
  .covers { display: flex; gap: 6px; flex-shrink: 0; }
  .covers img {
    width: 40px; height: 52px;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: 2px;
    display: block;
  }
  .paper-block p { color: var(--muted); max-width: 52em; }
  .paper-block p strong { color: var(--ink); font-weight: 500; }

  /* ---------- talks ---------- */
  .talk {
    display: grid;
    grid-template-columns: 3.4rem 1fr auto;
    gap: 0 16px;
    padding: 9px 8px 9px 0;
    border-bottom: 1px solid var(--rule);
  }
  .talk .venue { color: var(--muted); font-size: 12px; white-space: nowrap; }

  /* ---------- contact + footer ---------- */
  .contact p { margin-bottom: 6px; }
  .contact a {
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 1px;
    transition: background-color 120ms ease;
  }
  .contact a:hover, .contact a:focus-visible { background: var(--ink); color: var(--paper); }
  .contact .aff { color: var(--muted); font-size: 13px; }

  footer {
    margin-top: 72px;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: 11px;
    color: var(--faint);
    letter-spacing: 0.03em;
  }

  /* ---------- responsive ---------- */
  @media (max-width: 640px) {
    body { padding: 32px 16px 120px; }
    .row { grid-template-columns: 3.1rem 1fr; row-gap: 4px; }
    .tile { display: none; }
    .status { grid-column: 2; justify-self: start; }
    .talk { grid-template-columns: 3.1rem 1fr; }
    .talk .venue { grid-column: 2; white-space: normal; }
    .paper-block { flex-direction: column; gap: 12px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .status.live .dot { animation: none; }
    .row, .status, .contact a { transition: none; }
  }
</style>
</head>
<body>

  <div class="stamp">
    <span><b>divyatak.art</b> / index</span>
    <span>11 builds · <b>5 live</b> · 2 in progress</span>
    <span class="push">last rebuilt aug 2026</span>
  </div>

  <header class="hero">
    <h1>divya tak</h1>
