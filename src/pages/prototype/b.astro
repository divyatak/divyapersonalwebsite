      <span class="tile" aria-hidden="true">⚂</span>
      <span class="body">
        <span class="ttl">six small games on itch.io</span><span class="desc">ai quit, boneyard, mark, misplaced, proximity, ruh and the glow</span>
        <span class="tags">itch.io</span>
      </span>
      <span class="status"><span class="dot"></span>shipped</span>
    </div>
  </section>

  <section>
    <h2>on paper</h2>
    <div class="paper-block">
      <span class="covers">
        <img src="/projects/2024/(un)seen Istanbul/cover.webp" alt="(un)seen istanbul cover" width="40" height="52" loading="lazy" />
        <img src="/projects/2024/(un)seen Vietnam/cover.webp" alt="(un)seen vietnam cover" width="40" height="52" loading="lazy" />
        <img src="/projects/2025/(un)seen Emirates/cover.webp" alt="(un)seen emirates cover" width="40" height="52" loading="lazy" />
        <img src="/projects/2026/(un)seen Tokyo/Flower.webp" alt="(un)seen tokyo page" width="40" height="52" loading="lazy" />
