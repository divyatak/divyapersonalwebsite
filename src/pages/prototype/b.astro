    <a class="row" href="https://divyatak.github.io/creative-visuals/lenticular/" target="_blank" rel="noopener">
      <span class="yr">2026</span>
      <img class="tile" src="/playground/lenticular.webp" alt="" width="40" height="40" loading="lazy" />
      <span class="body">
        <span class="ttl">(un)seen lenticular</span><span class="desc">photo-comics shifting sketch↔final on mouse move</span>
