    <div class="row">
      <span class="yr">2024</span>
      <img class="tile" src="/projects/2024/Journey of my paper plane/cover.webp" alt="" width="40" height="40" loading="lazy" />
      <span class="body">
        <span class="ttl">journey of my paper plane</span><span class="desc">game</span>
        <span class="tags">game</span>
      </span>
      <span class="status"><span class="dot"></span>shipped</span>
    </div>
  </section>

  <section class="tight">
    <h2>experiments <span class="count">/05</span></h2>

    <a class="row" href="https://divyatak.github.io/creative-visuals/particles/" target="_blank" rel="noopener">
      <span class="yr">2026</span>
      <img class="tile" src="/playground/bioluminescent-flow.webp" alt="" width="40" height="40" loading="lazy" />
      <span class="body">
        <span class="ttl">bioluminescent flow</span><span class="desc">glowing algae ripple around your hand</span>
        <span class="tags">three.js gpu particles · mediapipe hand tracking</span>
      </span>
      <span class="status live"><span class="dot"></span>play ↗</span>
    </a>

    <a class="row" href="https://divyatak.github.io/creative-visuals/webcam/" target="_blank" rel="noopener">
      <span class="yr">2026</span>
      <img class="tile" src="/playground/webcam-magic.webp" alt="" width="40" height="40" loading="lazy" />
