<script is:inline>
document.addEventListener('keydown',(e)=>{
  const el=document.activeElement;
  if(el&&(['INPUT','TEXTAREA'].includes(el.tagName)||el.isContentEditable))return;
  if(e.key==='ArrowLeft')location.href='/prototype/c/';
  if(e.key==='ArrowRight')location.href='/prototype/a/';
});
</script>

<script is:inline>
// gentle entrance: posters rise onto their shelves as you scroll
(function(){
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced || !('IntersectionObserver' in window)) return; // body keeps .no-observer → everything visible
  document.body.classList.remove('no-observer');
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(en){
      if (en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); }
    });
  }, { threshold: 0.12 });
  document.querySelectorAll('.poster,.between,.made,.outro').forEach(function(el){ io.observe(el); });
})();
</script>

