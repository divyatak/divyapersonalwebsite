  <div class="proto-bar"><a href="/prototype/merge/">←</a><span>flow — works forward</span><a href="/prototype/record/">→</a><a class="idx" href="/prototype/">all</a></div>

  <script is:inline>
    (function () {
      var reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
      var K_RESIDUE = 'flow:residue';
      var K_RECORDS = 'flow:metro-resolved';
      var K_PICK = 'flow:bazaar-pick';

      function loadSet(key) {
        try { return new Set(JSON.parse(sessionStorage.getItem(key) || '[]')); }
        catch (e) { return new Set(); }
      }
      function saveSet(key, set) {
        try { sessionStorage.setItem(key, JSON.stringify(Array.from(set))); } catch (e) {}
      }

      /* residue: opened entries keep their mark; never counted, never mentioned */
      var residue = loadSet(K_RESIDUE);
      function applyResidue(id) {
        var nodes = document.querySelectorAll('[data-entry="' + id + '"]');
        for (var i = 0; i < nodes.length; i++) nodes[i].classList.add('inked');
      }
      function mark(id) {
        if (!id) return;
        if (!residue.has(id)) { residue.add(id); saveSet(K_RESIDUE, residue); }
        applyResidue(id);
      }
      residue.forEach(applyResidue);

      /* links that count as opening the entry */
      var markLinks = document.querySelectorAll('[data-mark]');
      for (var i = 0; i < markLinks.length; i++) {
        (function (el) {
          el.addEventListener('click', function () { mark(el.getAttribute('data-mark')); });
        })(markLinks[i]);
      }

      /* metro: a record resolves only if you attend.
         hover-hold ~700ms; press-and-hold on touch; instant on reduced motion,
         keyboard focus, or Enter/click. resolved records stay resolved (residue). */
      var resolvedRecs = loadSet(K_RECORDS);
      var records = document.querySelectorAll('.record');
      for (var r = 0; r < records.length; r++) {
        (function (btn) {
          var id = btn.getAttribute('data-rec');
          var timer = null;
          function resolve() {
            if (btn.classList.contains('resolved')) return;
            btn.classList.add('resolved');
            if (!resolvedRecs.has(id)) { resolvedRecs.add(id); saveSet(K_RECORDS, resolvedRecs); }
            mark('metro');
          }
          function cancel() { if (timer) { clearTimeout(timer); timer = null; } }
          if (resolvedRecs.has(id)) btn.classList.add('resolved');

          btn.addEventListener('mouseenter', function () {
            if (reduced.matches) { resolve(); return; }
            cancel();
            timer = setTimeout(resolve, 700);
          });
          btn.addEventListener('mouseleave', cancel);
          btn.addEventListener('pointerdown', function (e) {
            if (e.pointerType === 'mouse') return;
            if (reduced.matches) { resolve(); return; }
            cancel();
            timer = setTimeout(resolve, 700);
          });
          btn.addEventListener('pointerup', cancel);
          btn.addEventListener('pointercancel', cancel);
          btn.addEventListener('pointerleave', cancel);
          btn.addEventListener('focus', function () {
            try { if (btn.matches(':focus-visible')) resolve(); } catch (e) { resolve(); }
          });
          btn.addEventListener('click', resolve); /* Enter/Space via keyboard, or a plain click: both answer */
        })(records[r]);
      }

      /* bazaar: a single exclusive pick; the other closes and stays closed for the session */
      var feelings = document.querySelectorAll('.feeling');
      var afterLine = document.getElementById('bazaar-after');
      function applyPick(picked) {
        for (var f = 0; f < feelings.length; f++) {
          var b = feelings[f];
          if (b.getAttribute('data-feel') === picked) {
            b.classList.add('taken');
          } else {
            b.classList.add('closed');
            b.disabled = true;
          }
        }
        if (afterLine) afterLine.hidden = false;
        mark('bazaar');
      }
      var storedPick = null;
      try { storedPick = sessionStorage.getItem(K_PICK); } catch (e) {}
      if (storedPick) applyPick(storedPick);
      for (var f = 0; f < feelings.length; f++) {
        (function (b) {
          b.addEventListener('click', function () {
            var already = null;
            try { already = sessionStorage.getItem(K_PICK); } catch (e) {}
            if (already) return;
            var feel = b.getAttribute('data-feel');
            try { sessionStorage.setItem(K_PICK, feel); } catch (e) {}
            applyPick(feel);
          });
        })(feelings[f]);
      }

      /* prototype switcher: arrow keys, skipped while typing */
      document.addEventListener('keydown', function (e) {
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        var t = e.target;
        if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
        if (e.key === 'ArrowLeft') window.location.href = '/prototype/merge/';
        if (e.key === 'ArrowRight') window.location.href = '/prototype/record/';
      });
    })();
  </script>
