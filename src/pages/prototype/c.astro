<!-- THROWAWAY PROTOTYPE — angle hypothesis C, delete after decision. -->
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Divya Tak — a practice in four questions</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap" rel="stylesheet" />

  <style is:global>
    :root{
      --paper:#f6f2ea;
      --paper-deep:#efe9dd;
      --ink:#221d15;
      --ink-soft:#57503f;
      --faint:#8a8171;
      --rule:#d9d1c1;
      --accent:#8c3b22;
      --serif:"Newsreader", Georgia, serif;
      --display:"Fraunces", Georgia, serif;
      --sans:ui-sans-serif, system-ui, "Helvetica Neue", Arial, sans-serif;
    }
    *{margin:0;padding:0;box-sizing:border-box}
    html{scroll-behavior:smooth}
    @media (prefers-reduced-motion: reduce){ html{scroll-behavior:auto} }
    body{
      background:var(--paper);
      color:var(--ink);
      font-family:var(--serif);
      font-size:1.22rem;
      line-height:1.62;
      -webkit-font-smoothing:antialiased;
    }
    ::selection{background:#e8d9c4}

    a{color:var(--accent);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
    a:hover{color:var(--ink)}
    img{max-width:100%;height:auto;display:block}

    /* ---------- measure & rhythm ---------- */
    .col{max-width:41rem;margin-inline:auto;padding-inline:24px}
    .wide{max-width:60rem;margin-inline:auto;padding-inline:24px}

    /* ---------- top matter ---------- */
    .masthead{
      display:flex;justify-content:space-between;align-items:baseline;
      max-width:60rem;margin-inline:auto;
      padding:28px 24px 0;
      font-family:var(--sans);font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);
    }
    .masthead a{color:var(--ink-soft);text-decoration:none}
    .masthead a:hover{color:var(--accent)}

    .hero{padding:16vh 24px 10vh}
    .hero .kicker{
      font-family:var(--sans);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
      color:var(--faint);margin-bottom:2.2rem;
    }
    .hero h1{
      font-family:var(--display);
      font-weight:500;
      font-size:clamp(2.4rem, 6.4vw, 4.4rem);
      line-height:1.08;
      letter-spacing:-.01em;
      max-width:16ch;
    }
    .hero .after{
      margin-top:2.6rem;max-width:34rem;
      font-size:1.28rem;color:var(--ink-soft);
    }
    .hero .after em{font-style:italic}

    /* ---------- contents (essay ToC, not a grid) ---------- */
    .contents{padding:2rem 24px 7rem;border-top:1px solid var(--rule)}
    .contents-inner{max-width:41rem;margin-inline:auto;padding-top:1.6rem}
    .contents .label{
      font-family:var(--sans);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);
      margin-bottom:1.4rem;
    }
    .contents ol{list-style:none;counter-reset:q}
    .contents li{counter-increment:q;border-bottom:1px solid var(--rule)}
    .contents li:first-child{border-top:1px solid var(--rule)}
    .contents a{
      display:flex;align-items:baseline;gap:1.4rem;
      padding:.85rem .2rem;
      text-decoration:none;color:var(--ink);
      font-family:var(--display);font-size:1.35rem;font-weight:400;
    }
    .contents a::before{
      content:counter(q, upper-roman);
      font-family:var(--sans);font-size:.72rem;letter-spacing:.1em;color:var(--faint);
      min-width:1.6rem;
    }
    .contents a:hover{color:var(--accent)}

    /* ---------- chapters ---------- */
    .chapter{padding:7rem 0 4rem;border-top:1px solid var(--rule)}
    .chapter-head{max-width:41rem;margin-inline:auto;padding-inline:24px;margin-bottom:2.4rem}
    .chapter-head .num{
      font-family:var(--sans);font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);
      display:block;margin-bottom:1rem;
    }
    .chapter-head h2{
      font-family:var(--display);font-weight:500;
      font-size:clamp(1.9rem, 4.4vw, 2.9rem);line-height:1.12;letter-spacing:-.01em;
    }
    .passage{
      max-width:38rem;margin-inline:auto;padding-inline:24px;
      font-family:var(--display);font-style:italic;font-weight:400;
      font-size:clamp(1.3rem, 2.6vw, 1.6rem);line-height:1.45;color:var(--ink-soft);
      margin-bottom:4rem;
    }
    .body-text{max-width:41rem;margin-inline:auto;padding-inline:24px;margin-bottom:2.4rem}
    .body-text + .body-text{margin-top:-1.2rem}

    /* ---------- exhibits ---------- */
    .exhibit{margin:4.5rem auto 5.5rem}
    .exhibit .cap{
      max-width:41rem;margin:1.1rem auto 0;padding-inline:24px;
    }
    .cap .title-line{
      font-family:var(--sans);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);
      margin-bottom:.35rem;
    }
    .cap .title-line b{color:var(--ink);font-weight:600}
    .cap p{font-size:1.05rem;color:var(--ink-soft)}
    .cap p a{white-space:nowrap}

    figure.plate{max-width:52rem;margin-inline:auto;padding-inline:24px}
    figure.plate.narrow{max-width:44rem}
    figure.plate img{width:100%;border:1px solid var(--rule)}

    /* prints laid on a table — deliberately uneven, not a grid */
    .spread{
      max-width:60rem;margin-inline:auto;padding-inline:24px;
      display:grid;grid-template-columns:repeat(12,1fr);gap:20px;align-items:start;
    }
    .spread img{border:1px solid var(--rule);width:100%}
    .spread .s1{grid-column:1/7;margin-top:2.6rem}
    .spread .s2{grid-column:7/13}
    .spread .s3{grid-column:2/6;margin-top:1.4rem}
    .spread .s4{grid-column:6/12;margin-top:3.4rem}
    @media (max-width:640px){
      .spread{gap:14px}
      .spread .s1{grid-column:1/8;margin-top:0}
      .spread .s2{grid-column:5/13;margin-top:1.2rem}
      .spread .s3{grid-column:1/7;margin-top:1rem}
      .spread .s4{grid-column:6/13;margin-top:2rem}
    }

    /* alternating single plates for the touch pieces */
    .touch-piece{max-width:60rem;margin:4rem auto;padding-inline:24px;display:grid;grid-template-columns:repeat(12,1fr);gap:20px;align-items:end}
    .touch-piece img{width:100%;border:1px solid var(--rule)}
    .touch-piece .txt{padding-bottom:.4rem}
    .touch-piece.left  .pic{grid-column:1/8} .touch-piece.left  .txt{grid-column:8/13}
    .touch-piece.right .pic{grid-column:6/13} .touch-piece.right .txt{grid-column:1/6;text-align:right}
    .touch-piece.right .txt .title-line{justify-content:flex-end}
    @media (max-width:640px){
      .touch-piece.left .pic,.touch-piece.right .pic{grid-column:1/13}
      .touch-piece.left .txt,.touch-piece.right .txt{grid-column:1/13;text-align:left}
    }
    .touch-piece .title-line{
      font-family:var(--sans);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:.35rem;
    }
    .touch-piece .title-line b{color:var(--ink);font-weight:600}
    .touch-piece p{font-size:1.02rem;color:var(--ink-soft);line-height:1.5}

    .workbench-note{
      max-width:41rem;margin:3rem auto 0;padding:1.1rem 24px 0;
      border-top:1px dashed var(--rule);
      font-size:1.02rem;color:var(--ink-soft);
    }

    /* museum wall label — placeholder for Metro Museum */
    .wall-label{
      max-width:34rem;margin-inline:auto;
      background:var(--paper-deep);
      border:1px solid var(--rule);
      outline:1px solid var(--rule);outline-offset:6px;
      padding:3.4rem 2.4rem;
      text-align:center;
    }
    .wall-label .lbl-kicker{font-family:var(--sans);font-size:.66rem;letter-spacing:.22em;text-transform:uppercase;color:var(--faint);margin-bottom:1.1rem}
    .wall-label .lbl-title{font-family:var(--display);font-size:1.7rem;font-weight:500;line-height:1.2;margin-bottom:.9rem}
    .wall-label .lbl-meta{font-family:var(--sans);font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft)}
    .wall-label .lbl-count{font-family:var(--display);font-style:italic;color:var(--ink-soft);margin-top:1.2rem;font-size:1.05rem}

    /* price-tag placeholder for Everything Bazaar */
    .price-tag{
      max-width:30rem;margin-inline:auto;
      border:1px dashed var(--faint);
      padding:3rem 2rem;text-align:center;
      background:repeating-linear-gradient(-45deg, transparent 0 14px, rgba(140,59,34,.05) 14px 15px), var(--paper-deep);
    }
    .price-tag .tag-title{font-family:var(--display);font-style:italic;font-size:2rem;font-weight:500}
    .price-tag .tag-sub{font-family:var(--sans);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--ink-soft);margin-top:.8rem}

    /* small tinted card for Titli (no image supplied) */
    .game-note{
      max-width:26rem;margin-inline:auto;
      background:var(--paper-deep);border:1px solid var(--rule);
      padding:2.4rem 1.8rem;text-align:center;
    }
    .game-note .gn-title{font-family:var(--display);font-size:1.45rem;font-weight:500;margin-bottom:.6rem}
    .game-note .gn-meta{font-family:var(--sans);font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft)}

    /* three of six 2020 games — loose strip, uneven sizes */
    .strip{max-width:56rem;margin:0 auto;padding-inline:24px;display:grid;grid-template-columns:repeat(12,1fr);gap:20px;align-items:start}
    .strip img{width:100%;border:1px solid var(--rule)}
    .strip .g1{grid-column:1/5;margin-top:1.8rem}
    .strip .g2{grid-column:5/10}
    .strip .g3{grid-column:10/13;margin-top:3rem}
    @media (max-width:640px){
      .strip .g1{grid-column:1/7;margin-top:0}
      .strip .g2{grid-column:7/13;margin-top:1.4rem}
      .strip .g3{grid-column:3/9;margin-top:1rem}
    }

    /* ---------- coda ---------- */
    .coda{padding:7rem 0 3rem;border-top:1px solid var(--rule)}
    .coda .passage{margin-bottom:2.4rem}
    .after-list{max-width:41rem;margin:4rem auto 0;padding-inline:24px}
    .after-list h3{
      font-family:var(--sans);font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--faint);
      font-weight:600;margin-bottom:1rem;
    }
    .after-list ul{list-style:none}
    .after-list li{padding:.55rem 0;border-bottom:1px solid var(--rule);font-size:1.05rem;color:var(--ink-soft)}
    .after-list li:first-child{border-top:1px solid var(--rule)}
    .after-list li b{color:var(--ink);font-weight:500}
    .write-me{max-width:41rem;margin:3.4rem auto 0;padding-inline:24px;font-size:1.15rem}
    footer.endmark{
      text-align:center;padding:5rem 24px 7rem;
      font-family:var(--display);font-style:italic;color:var(--faint);font-size:1.05rem;
    }

    /* ---------- reveal ---------- */
    .reveal{opacity:0;transform:translateY(16px);transition:opacity .7s ease, transform .7s ease}
    .reveal.in{opacity:1;transform:none}
    @media (prefers-reduced-motion: reduce){
      .reveal{opacity:1;transform:none;transition:none}
    }
  </style>
</head>
<body>

  <div class="masthead">
    <span>Divya Tak</span>
    <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
  </div>

  <!-- ============ opening statement ============ -->
  <header class="hero col">
    <p class="kicker">A practice in four questions</p>
    <h1>I care about what gets ignored.</h1>
    <p class="after">
      A lost bag sitting in a metro office. A street corner nobody photographs.
      The small want you don't say out loud. Most of my work starts with something
      like that — and then asks you to stop and look at it with me. Everything on
      this page is a chapter of that one project.
    </p>
  </header>

  <!-- ============ contents ============ -->
  <nav class="contents reveal">
    <div class="contents-inner">
      <p class="label">The questions</p>
      <ol>
        <li><a href="#forget">what do we forget</a></li>
        <li><a href="#want">what do we want</a></li>
        <li><a href="#touch">what happens when you touch it</a></li>
        <li><a href="#play">what do we play</a></li>
      </ol>
    </div>
  </nav>

  <!-- ============ I · what do we forget ============ -->
  <section class="chapter" id="forget">
    <div class="chapter-head reveal">
      <span class="num">I</span>
      <h2>what do we forget</h2>
    </div>
    <p class="passage reveal">
      Between the lived and the remembered. Between the seen and the imagined —
      that's where the things I keep returning to sit.
    </p>

    <div class="body-text reveal">
      <p>
        Two projects live here. One collects what a whole city loses; the other
        collects what I almost didn't notice myself.
      </p>
    </div>

    <div class="exhibit reveal">
      <div class="wall-label">
        <p class="lbl-kicker">Now being built</p>
        <p class="lbl-title">Metro Museum of the Forgotten</p>
        <p class="lbl-meta">2026 · browser museum · in progress</p>
        <p class="lbl-count">24,646 lost-and-found records, Delhi Metro</p>
      </div>
      <div class="cap">
        <p class="title-line"><b>Metro Museum of the Forgotten</b> · 2026, in progress</p>
        <p>
          I commemorate the forgotten in a virtual museum, forcing the viewer to
          look at things no one pays attention to — a half-finished sandwich, an
          empty bag. Built from 24,646 records scraped from the Delhi Metro's
          lost-and-found listings.
        </p>
      </div>
    </div>

    <div class="exhibit reveal">
      <div class="spread">
        <img class="s1" src="/projects/2024/(un)seen%20Istanbul/cover.webp" alt="(un)seen Istanbul — photo-comic cover" loading="lazy" />
        <img class="s2" src="/projects/2024/(un)seen%20Vietnam/cover.webp" alt="(un)seen Vietnam — photo-comic cover" loading="lazy" />
        <img class="s3" src="/projects/2025/(un)seen%20Emirates/cover.webp" alt="(un)seen Emirates — photo-comic cover" loading="lazy" />
        <img class="s4" src="/projects/2026/(un)seen%20Life/cover.webp" alt="(un)seen Life — photo-comic cover" loading="lazy" />
      </div>
      <div class="cap">
        <p class="title-line"><b>(un)seen</b> · 2024–ongoing · Istanbul, Vietnam, Emirates, Life</p>
        <p>
          I photograph moments that are easy to miss, then draw into them. Not to
          embellish, but to reframe. Even as I document my stay or existence in a
          space, it compels me to be aware of what I am observing, what I am
          imagining and where I truly am. The drawing isn't a side practice —
          it's how the looking happens.
          There's also an interactive version you can tilt:
          <a href="https://divyatak.github.io/creative-visuals/lenticular/">see it live&nbsp;→</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ II · what do we want ============ -->
  <section class="chapter" id="want">
    <div class="chapter-head reveal">
      <span class="num">II</span>
      <h2>what do we want</h2>
    </div>
    <p class="passage reveal">
      How do you look at how we live, and the stories we tell ourselves about it,
      without either judging it or turning away?
    </p>

    <div class="exhibit reveal">
      <div class="price-tag">
        <p class="tag-title">everything bazaar</p>
        <p class="tag-sub">feelings · sold here · 2026</p>
      </div>
      <div class="cap">
        <p class="title-line"><b>Everything Bazaar</b> · 2026</p>
        <p>
          The inquiry becomes about buying feelings. What happens when something
          feels right to a part of you while another part of you knows it's wrong?
          <a href="https://everythingbazaar.netlify.app">see it live&nbsp;→</a>
        </p>
      </div>
    </div>
  </section>

  <!-- ============ III · what happens when you touch it ============ -->
  <section class="chapter" id="touch">
    <div class="chapter-head reveal">
      <span class="num">III</span>
      <h2>what happens when you touch it</h2>
    </div>
    <p class="passage reveal">
      You can't moralise at someone who's playing, and someone who's playing
      can't stay detached.
    </p>

    <div class="body-text reveal">
      <p>
        That's why so much of this work is interactive: not for the novelty, but
        because a participant looks differently than a spectator does. These
        three run in your browser right now.
      </p>
    </div>

    <div class="touch-piece left reveal">
      <div class="pic"><img src="/playground/bioluminescent-flow.webp" alt="Bioluminescent Flow — glowing particles in dark water" loading="lazy" /></div>
      <div class="txt">
        <p class="title-line"><b>Bioluminescent Flow</b> · 2026</p>
        <p>Glow that gathers wherever your cursor goes. <a href="https://divyatak.github.io/creative-visuals/particles/">see it live&nbsp;→</a></p>
      </div>
    </div>

    <div class="touch-piece right reveal">
      <div class="pic"><img src="/playground/webcam-magic.webp" alt="Webcam Magic — your camera feed, made playable" loading="lazy" /></div>
      <div class="txt">
        <p class="title-line"><b>Webcam Magic</b> · 2026</p>
        <p>Your own camera, handed back to you as a toy. <a href="https://divyatak.github.io/creative-visuals/webcam/">see it live&nbsp;→</a></p>
      </div>
    </div>

    <div class="touch-piece left reveal">
      <div class="pic"><img src="/playground/the-line-before.webp" alt="The Line Before — a garden of poems you move through" loading="lazy" /></div>
      <div class="txt">
        <p class="title-line"><b>The Line Before</b> · 2025 · with Kahran Singh</p>
        <p>Poems planted in a garden you wander through. <a href="https://divya.studiotypo.xyz">see it live&nbsp;→</a></p>
      </div>
    </div>

    <p class="workbench-note reveal">
      Also on the workbench: a <b>projection mapping instrument</b> (2026, in
      progress) — the same idea, but the screen is the room you're standing in.
    </p>
  </section>

  <!-- ============ IV · what do we play ============ -->
  <section class="chapter" id="play">
    <div class="chapter-head reveal">
      <span class="num">IV</span>
      <h2>what do we play</h2>
    </div>
    <p class="passage reveal">
      Games are where this whole thing started. It's not that serious — and
      that's exactly why it works. People put their guard down inside a game,
      and then they notice things.
    </p>

    <div class="exhibit reveal">
      <div class="game-note">
        <p class="gn-title">The Titli Effect</p>
        <p class="gn-meta">2024 · with Charu</p>
      </div>
      <div class="cap">
        <p class="title-line"><b>The Titli Effect</b> · 2024 · with Charu</p>
        <p>2nd place at the Jennifer Ann Group's Connectedness game jam.</p>
      </div>
    </div>

    <div class="exhibit reveal">
      <figure class="plate narrow">
        <img src="/projects/2024/Journey of my paper plane/cover.webp" alt="Journey of my paper plane — game cover" loading="lazy" />
      </figure>
      <div class="cap">
        <p class="title-line"><b>Journey of my paper plane</b> · 2024</p>
        <p>A small game; the title says exactly what it is.</p>
      </div>
    </div>

    <div class="exhibit reveal">
      <div class="strip">
        <img class="g1" src="/projects/2020/AI quit/cover.webp" alt="AI quit — game cover" loading="lazy" />
        <img class="g2" src="/projects/2020/Boneyard/cover.webp" alt="Boneyard — game cover" loading="lazy" />
        <img class="g3" src="/projects/2020/Mark/cover.webp" alt="Mark — game cover" loading="lazy" />
      </div>
      <div class="cap">
        <p class="title-line"><b>Six small games</b> · 2020 · itch.io</p>
        <p>Three of the six, made in a single year. Quick, rough, and honest about it.</p>
      </div>
    </div>
  </section>

  <!-- ============ coda ============ -->
  <section class="coda" id="trajectory">
    <div class="chapter-head reveal">
      <span class="num">Where this is going</span>
      <h2>physics, then art, then both</h2>
    </div>
    <p class="passage reveal">
      I came to all of it from physics, and moved to creativity, and now I find
      myself fascinated by the research aspects again.
    </p>
    <div class="body-text reveal">
      <p>
        Physics first, then the creative industries, and now the two keep folding
        back into each other — scraping datasets to build museums, drawing over
        photographs, writing small simulations you can put your hands in. Less a
        career change, more the same curiosity changing instruments.
      </p>
    </div>

    <div class="after-list reveal">
      <h3>Talks</h3>
      <ul>
        <li><b>Algorithm and Art</b> — NGMA Bangalore, 2026</li>
        <li><b>Games and Literature</b> — Goethe-Institut, 2024</li>
        <li><b>AI and Copyright</b> — The Fifth Elephant, 2023</li>
      </ul>
    </div>

    <p class="write-me reveal">
      If any of these questions is one you're also asking, write to me:
      <a href="mailto:hello@divyatak.art">hello@divyatak.art</a>
    </p>

    <footer class="endmark">look again.</footer>
  </section>

  <!-- ============ scroll reveal ============ -->
  <script is:inline>
    (function () {
      var els = document.querySelectorAll('.reveal');
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('in'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -5% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <!-- ============ prototype switcher ============ -->
  <div class="proto-bar">
    <a class="proto-arrow" href="/prototype/b/">←</a>
    <span class="proto-label">C — look again</span>
    <a class="proto-arrow" href="/prototype/d/">→</a>
    <a class="proto-index" href="/prototype/">all</a>
  </div>
  <style>
  .proto-bar{position:fixed;bottom:16px;left:50%;transform:translateX(-50%);z-index:9999;display:flex;align-items:center;gap:10px;background:#111;color:#fff;padding:8px 14px;border-radius:999px;font:600 13px/1 monospace;box-shadow:0 4px 16px rgba(0,0,0,.35)}
  .proto-bar a{color:#fff;text-decoration:none;padding:2px 6px}
  .proto-bar a:hover{background:#333;border-radius:6px}
  .proto-index{opacity:.6;font-weight:400}
  </style>
  <script is:inline>
  document.addEventListener('keydown',(e)=>{
    const el=document.activeElement;
    if(el&&(['INPUT','TEXTAREA'].includes(el.tagName)||el.isContentEditable))return;
    if(e.key==='ArrowLeft')location.href='/prototype/b/';
    if(e.key==='ArrowRight')location.href='/prototype/d/';
  });
  </script>

</body>
</html>
