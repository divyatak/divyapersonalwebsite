---
/**
 * /works/[slug]/ — one work, told as three unlabelled paragraphs with pictures
 * between them.
 *
 * Two sources feed this route:
 *   1. the build pipeline (src/data/generated-projects.json, made from public/projects/)
 *   2. src/data/extra-works.js — the five works that live outside the pipeline
 * Both are normalised into one `work` shape before rendering, so the page never
 * has to know where an entry came from.
 *
 * THE FORM. There are no What / Why / How headings and no label column. The
 * page is prose: the first paragraph says what the thing is, the second how it
 * is actually built, the third why it exists — and the reader is never told
 * which is which. The order ends on the soul on purpose.
 *
 * Pictures do the work the labels used to do. A couple of images from the media
 * strip are lifted into the gaps BETWEEN the paragraphs, so the reading is
 * paced by the work itself rather than by typography; everything left over
 * follows at the bottom as the calm strip. A work with no images beyond its
 * hero simply reads as three paragraphs with air between them.
 *
 * Reserved writing. Why and How are only ever printed when there is real
 * written source material behind them. Where there isn't, a single muted line
 * stands in the paragraph's place — so the page shows where the words will go
 * without inventing them, and without announcing an empty section. When BOTH
 * are unwritten there is one muted line, not two.
 */
import Layout from '../../layouts/Layout.astro'
import works from '../../data/generated-projects.json'
import { extraWorks } from '../../data/extra-works.js'

// getStaticPaths is hoisted and evaluated on its own, so everything it needs
// lives inside it.
export function getStaticPaths() {
  // Credits are stored in the data but only ever printed as Divya writes them.
  const WITH_CHARU = new Set([
    'ai-quit', 'boneyard', 'mark', 'misplaced', 'proximity', 'ruh-and-the-glow',
    'the-titli-effect',
  ])
  const CURRENT_YEAR = 2026

  // The pipeline groups everything pre-2020 into a label:"earlier" group whose
  // year is 0, so the real year comes off the cover path.
  const yearOf = (p: any, groupYear: number) => {
    const m = /\/projects\/(\d{4})\//.exec(p.cover || '')
    return m ? Number(m[1]) : groupYear
  }
  const labelFor = (url: string) =>
    url.includes('spotify') ? 'Listen on Spotify' : 'Open it'

  const fromPipeline = works.flatMap((group: any) =>
    group.projects.map((p: any) => {
      const year = yearOf(p, group.year)
      const firstImage = p.media.find((m: any) => m.type === 'image')
      const hero = p.cover || (firstImage ? firstImage.src : null)
      return {
        params: { slug: p.slug },
        props: {
          work: {
            slug: p.slug,
            title: p.title,
            year,
            // only the current year's (un)seen edition is still being added to
            status:
              p.slug.startsWith('unseen') && year === CURRENT_YEAR ? 'ongoing' : 'finished',
            with: WITH_CHARU.has(p.slug) ? 'with Charu' : '',
            url: p.link || null,
            linkLabel: p.link ? labelFor(p.link) : null,
            itch: p.itch || null,
            hero,
            heroAlt: hero ? `${p.title}, cover image` : '',
            orientation: p.coverOrientation === 'portrait' ? 'portrait' : 'landscape',
            // the pipeline's own info.txt description is the What, verbatim
            what: p.description || null,
            why: null,
            how: null,
            strip: p.media.filter((m: any) => m.src !== hero),
          },
        },
      }
    })
  )

  const fromExtras = extraWorks.map((w: any) => ({
    params: { slug: w.slug },
    props: {
      work: {
        slug: w.slug,
        title: w.title,
        year: w.year,
        status: w.status,
        with: w.with || '',
        url: w.url || null,
        linkLabel: w.url ? w.linkLabel || 'Open it' : null,
        itch: null,
        hero: w.image,
        heroAlt: w.imageAlt,
        orientation: w.orientation || 'landscape',
        what: w.what || null,
        why: w.why || null,
        how: w.how || null,
        strip: [],
      },
    },
  }))

  return [...fromPipeline, ...fromExtras]
}

const { work } = Astro.props
const base = import.meta.env.BASE_URL.replace(/\/$/, '')

function youtubeEmbedUrl(url: string) {
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([\w-]+)/)
  return match ? `https://www.youtube.com/embed/${match[1]}` : url
}

// The fact line: only the facts that are real. Status is printed only while a
// work is still moving — a year already says "finished" for everything else.
const facts = [
  String(work.year),
  work.with,
  work.status === 'ongoing' ? 'Ongoing' : '',
].filter(Boolean)

const RESERVED = '— to be written —'

/* ---------- the three paragraphs, in the order what → how → why ----------
   Nothing is labelled, so a missing section cannot announce itself: it becomes
   one muted line standing in the same place the writing will eventually go.
   Two missing sections would be two identical muted lines saying the same
   nothing twice, so they collapse into one. */
const paragraphs: any[] = []
if (work.what) paragraphs.push({ reserved: false, body: work.what })

if (!work.how && !work.why) {
  paragraphs.push({ reserved: true, body: RESERVED })
} else {
  paragraphs.push(
    work.how ? { reserved: false, body: work.how } : { reserved: true, body: RESERVED }
  )
  paragraphs.push(
    work.why ? { reserved: false, body: work.why } : { reserved: true, body: RESERVED }
  )
}

/* ---------- the pictures that go between them ----------
   Only still images are lifted into the prose: a video or an embed asks to be
   started, and nothing in the middle of a paragraph should ask for anything.
   Those wait in the strip.

   One image to a gap normally; two when the work has enough pictures that a
   single one would read as an accident. Whatever is left stays in the tail, so
   a work with thirty images still gives the prose only four. */
const stripImages = work.strip.filter((m: any) => m.type === 'image')
const imageCount = stripImages.length
const altFor = (m: any) =>
  m.alt || `${work.title}, image ${stripImages.indexOf(m) + 1} of ${imageCount}`

const gaps = Math.max(0, paragraphs.length - 1)
const perGap = imageCount >= 5 ? 2 : 1

const betweens: any[][] = []
let taken = 0
for (let g = 0; g < gaps; g++) {
  const slice = stripImages.slice(taken, taken + perGap)
  betweens.push(slice)
  taken += slice.length
}

// one flat run of blocks, so the whole article is a single grid
const flow: any[] = []
paragraphs.forEach((p, i) => {
  flow.push({ kind: 'para', ...p })
  ;(betweens[i] || []).forEach((m: any) => flow.push({ kind: 'plate', media: m }))
})

const lifted = new Set(betweens.flat().map((m: any) => m.src))
const tail = work.strip.filter((m: any) => !lifted.has(m.src))
const metaDescription = work.what
  ? work.what.length > 155 ? `${work.what.slice(0, 152).trimEnd()}...` : work.what
  : `${work.title} by Divya`
---

<Layout
  title={`${work.title} — Divya`}
  description={metaDescription}
  ogImage={work.hero || undefined}
>
  <article class="wk" aria-label={`Work: ${work.title}`}>

    <a class="wk-back" href={`${base}/works/`}>Back to works</a>

    {work.hero && (
      <figure class:list={['wk-hero', work.orientation]}>
        <img src={`${base}${work.hero}`} alt={work.heroAlt} decoding="async" />
      </figure>
    )}

    <header class="wk-head">
      <h1 class="wk-title">{work.title}</h1>
      {facts.length > 0 && (
        <p class="wk-facts">{facts.join('  ·  ')}</p>
      )}
    </header>

    <div class="wk-flow">
      {flow.map((b: any) =>
        b.kind === 'para' ? (
          <p class:list={['wk-prose', { reserved: b.reserved }]}>{b.body}</p>
        ) : (
          <figure class="wk-plate">
            <img
              src={`${base}${b.media.src}`}
              alt={altFor(b.media)}
              loading="lazy"
              decoding="async"
              width={b.media.width || undefined}
              height={b.media.height || undefined}
            />
          </figure>
        )
      )}
    </div>

    {work.url && (
      <div class="wk-out">
        <a href={work.url} target="_blank" rel="noopener noreferrer">
          {work.linkLabel}
        </a>
      </div>
    )}

    {work.itch && (
      <div class="wk-out">
        <div class="wk-itch">
          <h2 class="wk-label wk-itch-label">Play it</h2>
          <iframe src={work.itch} title={`${work.title} on itch.io`} loading="lazy"></iframe>
        </div>
      </div>
    )}

    {tail.length > 0 && (
      <div class="wk-strip">
        <div class="wk-strip-inner">
          {tail.map((m: any, i: number) =>
            m.type === 'youtube' ? (
              <div class="wk-embed">
                <iframe
                  src={youtubeEmbedUrl(m.src)}
                  title={`${work.title}, video ${i + 1}`}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                  allowfullscreen
                ></iframe>
              </div>
            ) : m.type === 'video' ? (
              <video
                src={`${base}${m.src}`}
                controls
                preload="metadata"
                playsinline
              ></video>
            ) : (
              <img
                src={`${base}${m.src}`}
                alt={altFor(m)}
                loading="lazy"
                decoding="async"
                width={m.width || undefined}
                height={m.height || undefined}
              />
            )
          )}
        </div>
      </div>
    )}

  </article>
</Layout>

<style>
  /* =====================================================================
     One family, three weights. The page is page-scoped on purpose: it
     carries its own type and its own grid, and borrows nothing from the
     old component stylesheet.

     THE SEED. --r = 1.5rem = 24px. It is the column gutter, one line of
     body text, and the unit every vertical space is a multiple of.

     THE COLUMNS. Three, inside the layout's content box. ONE axis now: with
     the labels gone there is no second column to answer to, so every line on
     the page — the title, the first word of the prose, the left edge of every
     picture, the link out — hangs on column 1's left line, which is the same
     line the top bar's wordmark hangs on.

     TWO WIDTHS ON THAT ONE AXIS. Prose is capped at a reading measure (34em);
     pictures run two columns of three. So the images are wider than the text
     without ever becoming full-bleed, and the difference between reading and
     looking is carried by width alone — no rules, no labels, no frames.

     Nothing here transitions or animates on load.
     ===================================================================== */
  @import url('https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&display=swap');

  .wk {
    --r: 1.5rem;
    --gutter: var(--r);
    --ink: #222;
    --quiet: #8a8a8a;
    --faint: #c4c4c4;

    font-family: 'Sora', system-ui, sans-serif;
    color: var(--ink);
    font-size: clamp(15px, 0.5vw + 0.7rem, 17px);
    line-height: var(--r);
    letter-spacing: -0.005em;
    padding-bottom: calc(var(--r) * 5);
  }

  /* every row of the page stands on the same three columns */
  .wk-head,
  .wk-flow,
  .wk-out,
  .wk-strip {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
  }

  /* ---------- the label register: small, letterspaced, sentence case ---------- */
  .wk-back,
  .wk-label,
  .wk-facts {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    line-height: var(--r);
    color: var(--quiet);
  }

  .wk-back {
    display: inline-block;
    text-decoration: none;
    margin-bottom: calc(var(--r) * 2);
  }
  .wk-back:hover { color: var(--ink); }

  /* ---------- hero: no frame, no caption, nothing but the picture ---------- */
  .wk-hero {
    margin: 0 0 calc(var(--r) * 2.5);
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 76vh;
    overflow: hidden;
    background: #f4f4f4;
  }
  /* a portrait cover keeps its shape and takes two columns, not three */
  .wk-hero.portrait {
    width: calc((100% - 2 * var(--gutter)) / 3 * 2 + var(--gutter));
    aspect-ratio: 4 / 5;
    max-height: 82vh;
  }
  .wk-hero img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------- title + the quiet fact line ---------- */
  .wk-title {
    grid-column: 1 / -1;
    margin: 0;
    font-size: clamp(2.1rem, 5.4vw, 4.4rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--ink);
    /* the ink hangs on column 1's line rather than the glyph box */
    text-indent: -0.03em;
  }
  .wk-facts {
    grid-column: 1 / -1;
    margin: var(--r) 0 0;
    font-weight: 400;
  }

  /* ---------- the prose, and the pictures set into it ----------
     Three paragraphs and nothing telling you what they are. Paragraph to
     paragraph is two rhythm units of air; a picture between them takes three,
     because a picture has to be finished before the next sentence starts. */
  .wk-flow { margin-top: calc(var(--r) * 4); }

  .wk-prose {
    grid-column: 1 / -1;
    margin: 0;
    max-width: 34em;
  }
  .wk-prose + .wk-prose { margin-top: calc(var(--r) * 2); }

  /* held in reserve: this is where the writing will go, said once and quietly */
  .wk-prose.reserved {
    color: var(--faint);
    letter-spacing: 0.04em;
  }

  /* a picture lifted out of the strip and set between two paragraphs.
     Two columns of three, its own natural ratio, no frame and no caption. */
  .wk-plate {
    grid-column: 1 / 3;
    margin: calc(var(--r) * 3) 0 0;
  }
  /* a pair of pictures is one beat, so they sit closer to each other than
     either of them sits to the writing */
  .wk-plate + .wk-plate { margin-top: calc(var(--r) * 1.5); }
  .wk-plate + .wk-prose { margin-top: calc(var(--r) * 3); }
  .wk-plate img {
    display: block;
    width: 100%;
    height: auto;
    background: #f4f4f4;
  }

  /* ---------- the way out: one plain, prominent link ---------- */
  .wk-out { margin-top: calc(var(--r) * 4); }
  .wk-out > a {
    grid-column: 1 / -1;
    justify-self: start;
    font-size: clamp(1.05rem, 1.6vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 0.18em;
  }
  .wk-out > a:hover { color: #636363; border-bottom-color: #636363; }

  /* the six 2020 games have no page URL of their own, only an itch widget,
     so the widget itself is the way out */
  .wk-itch {
    grid-column: 1 / -1;
    width: 100%;
    max-width: 34rem;
  }
  .wk-itch-label { margin: 0 0 calc(var(--r) * 0.75); }
  .wk-itch iframe {
    display: block;
    width: 100%;
    height: 167px;
    border: 0;
  }

  /* ---------- whatever the prose didn't use: one calm column, same axis, same width ---------- */
  .wk-strip { margin-top: calc(var(--r) * 6); }
  .wk-strip-inner {
    grid-column: 1 / 3;
    display: flex;
    flex-direction: column;
    gap: calc(var(--r) * 3);
  }
  .wk-strip img,
  .wk-strip video {
    display: block;
    width: 100%;
    height: auto;
    background: #f4f4f4;
  }
  .wk-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f4f4f4;
  }
  .wk-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ================= the grid folds; the rhythm does not =================
     --r never changes, so the vertical rhythm is the same at every width.
     Below 900px the three columns become one and the two axes merge. */
  @media (max-width: 900px) {
    .wk-head,
    .wk-flow,
    .wk-out,
    .wk-strip {
      grid-template-columns: 1fr;
    }
    .wk-title,
    .wk-facts,
    .wk-prose,
    .wk-plate,
    .wk-out > a,
    .wk-itch,
    .wk-strip-inner {
      grid-column: 1;
    }
    .wk-hero.portrait { width: 100%; }
    .wk-flow { margin-top: calc(var(--r) * 3); }
    .wk-plate { margin-top: calc(var(--r) * 2.5); }
    .wk-plate + .wk-prose { margin-top: calc(var(--r) * 2.5); }
    .wk-strip { margin-top: calc(var(--r) * 4); }
    .wk-strip-inner { gap: calc(var(--r) * 2); }
  }
</style>
