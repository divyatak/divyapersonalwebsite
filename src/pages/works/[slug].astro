    width: 100%;
    height: auto;
    background: #f4f4f4;
  }
  .wk-embed {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #f4f4f4;
  }
  .wk-embed iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ================= the grid folds; the rhythm does not =================
     --r never changes, so the vertical rhythm is the same at every width.
     Below 900px the three columns become one and the two axes merge. */
  @media (max-width: 900px) {
    .wk-head,
    .wk-flow,
    .wk-out,
    .wk-strip {
      grid-template-columns: 1fr;
    }
    .wk-title,
    .wk-facts,
    .wk-prose,
    .wk-plate,
    .wk-out > a,
    .wk-itch,
    .wk-strip-inner {
      grid-column: 1;
    }
    /* the couplets fold back into one column — text above its media, still
       adjacent, still one beat. The position classes outrank the plain stack
       rule, so they are named here explicitly. */
    .wk-flow .wk-prose.ph-l,
    .wk-flow .wk-prose.ph-r,
    .wk-flow .wk-prose.pw-l,
    .wk-flow .wk-prose.pw-r,
    .wk-flow .wk-prose.p-f,
    .wk-flow .wk-plate.mh-l,
    .wk-flow .wk-plate.mh-r,
    .wk-flow .wk-plate.m-s,
    .wk-flow .wk-plate.m-f {
      grid-column: 1;
      justify-self: stretch;
    }
    .wk-flow { row-gap: calc(var(--r) * 2); }
    .wk-flow { margin-top: calc(var(--r) * 3); }
    .wk-plate { margin-top: calc(var(--r) * 2.5); }
    .wk-plate + .wk-prose { margin-top: calc(var(--r) * 2.5); }
    .wk-strip { margin-top: calc(var(--r) * 4); }
    .wk-strip-inner { gap: calc(var(--r) * 2); }
  }
