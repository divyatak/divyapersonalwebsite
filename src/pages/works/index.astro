---
// The works index lives on the landing folio. This stub forwards straight
// there — one hop, no prototype interstitial.
const target = '/#works'
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <title>works — divya tak</title>
  <script is:inline define:vars={{ target }}>window.location.replace(target)</script>
</head>
<body>
  <p style="font-family: 'Sora', system-ui, sans-serif; padding: 2rem;">
    <a href={target}>works have moved &#8594;</a>
  </p>
</body>
</html>
