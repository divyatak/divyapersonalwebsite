---
import Layout from '../layouts/Layout.astro'
import friendsData from '../data/generated-friends.json'
import works from '../data/generated-projects.json'

const { collaborators, mentions } = friendsData

// Map project titles to slugs so friend project tags can link to them
const titleToSlug = new Map<string, string>()
works.flatMap(y => y.projects).forEach(p => titleToSlug.set(p.title, p.slug))
const base = import.meta.env.BASE_URL.replace(/\/$/, '')
---

<Layout title="Friends — Divya" description="Friends and collaborators of Divya.">
  <div class="page">
    <h1 class="chapter">Friends</h1>

    <section class="block" aria-labelledby="lbl-collaborators">
      <h2 class="label" id="lbl-collaborators">Collaborators</h2>

      <div class="mates">
        {collaborators.map((f) => (
          <article class="mate">
            {f.photo ? (
              <img
                class="mate-photo"
                src={`${base}${f.photo}`}
                alt={`Photo of ${f.name}`}
                width="800"
                height="1000"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="mate-photo mate-photo--empty"></div>
            )}

            <h3 class="mate-name">
              {f.url ? (
                <a href={f.url} target="_blank" rel="noopener noreferrer">
                  {f.name}<span class="ext" aria-hidden="true">&#8599;</span>
                </a>
              ) : f.name}
            </h3>

            {f.role && <p class="mate-role">{f.role}</p>}
            {f.description && <p class="mate-desc">{f.description}</p>}

            {f.projects.length > 0 && (
              <p class="tags">
                {f.projects.map((p) => {
                  const slug = titleToSlug.get(p)
                  return slug ? (
                    <a href={`${base}/works/${slug}/`} class="tag">{p}</a>
                  ) : (
                    <span class="tag">{p}</span>
                  )
                })}
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    {mentions.length > 0 && (
      <section class="block" aria-labelledby="lbl-mentions">
        <h2 class="label" id="lbl-mentions">Cool friends who do cool things</h2>

        <ul class="pals">
          {mentions.map((f) => (
            <li class="pal">
              <div class="pal-who">
                <h3 class="pal-name">
                  {f.url ? (
                    <a href={f.url} target="_blank" rel="noopener noreferrer">
                      {f.name}<span class="ext" aria-hidden="true">&#8599;</span>
                    </a>
                  ) : f.name}
                </h3>
                {f.role && <p class="pal-role">{f.role}</p>}
                {f.projects.length > 0 && (
                  <p class="tags">
                    {f.projects.map((p) => {
                      const slug = titleToSlug.get(p)
                      return slug ? (
                        <a href={`${base}/works/${slug}/`} class="tag">{p}</a>
                      ) : (
                        <span class="tag">{p}</span>
                      )
                    })}
                  </p>
                )}
              </div>
              {f.description && <p class="pal-desc">{f.description}</p>}
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

<style>
  /* =====================================================================
     FRIENDS — the landing's language, page-scoped.

     One seed: --r = 24px. It is the column gutter, the body line box, and
     the unit every vertical space on this page is a multiple of.

     One grid: three columns inside the Layout's .content box, so column 1's
     left line is the same line the top bar's wordmark hangs on.

     Two runs of people. Collaborators get pictures and take a column each.
     Mentions have no pictures, so they become an index instead of a grid:
     who on column 1, what they do on columns 2-3, air between.
     ===================================================================== */

  .page {
    --r: 1.5rem;
    --gutter: var(--r);

    --ink: #222;
    --mid: #636363;
    --quiet: #999;
    --hair: #eee;

    /* body sits on the module: one line = one rhythm unit */
    --t-body: 0.9375rem;   /* 15px */
    --lh-body: var(--r);
    --measure: 52ch;

    font-family: 'Sora', system-ui, -apple-system, sans-serif;
    font-weight: 400;
    color: var(--ink);
    padding-top: calc(var(--r) * 4);
    padding-bottom: calc(var(--r) * 4);
  }

  /* ---------- the chapter word ---------- */
  .chapter {
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 700;
    line-height: 0.86;
    letter-spacing: -0.045em;
    color: var(--ink);
    margin-bottom: calc(var(--r) * 4);
  }

  /* ---------- a section: a quiet label on a hairline, then the run ---------- */
  .block + .block { margin-top: calc(var(--r) * 5); }

  .label {
    font-size: 0.75rem;      /* 12px */
    font-weight: 600;
    /* sentence case now, so the tracking comes back in a little — 0.18em was
       set for an all-lowercase run and gaps a capital badly */
    letter-spacing: 0.12em;
    color: var(--quiet);
    border-top: 1px solid var(--hair);
    padding-top: calc(var(--r) * 0.75);
    margin-bottom: calc(var(--r) * 2.5);
  }

  /* ---------- collaborators: one to a column ---------- */
  .mates {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    row-gap: calc(var(--r) * 3.5);
    align-items: start;
  }

  /* a consistent aspect for every face, so the row reads as one band */
  .mate-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: #f4f4f4;
    margin-bottom: calc(var(--r) * 1.25);
  }
  .mate-photo--empty { height: auto; }

  .mate-name {
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--lh-body);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .mate-role {
    font-size: 0.75rem;
    font-weight: 400;
    line-height: calc(var(--r) * 0.75);
    letter-spacing: 0.06em;
    color: var(--quiet);
    margin-top: calc(var(--r) * 0.25);
  }

  .mate-desc {
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--mid);
    max-width: var(--measure);
    margin-top: var(--r);
  }

  /* ---------- mentions: no pictures, so an index instead of a grid ----------
     NO RULE BETWEEN THEM. A hairline under every friend turned a warm list into
     a ledger; these are people, and they are separated by air. The one rule
     left in the section is the one that opens its label. */
  .pals { list-style: none; }

  .pal {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    column-gap: var(--gutter);
    align-items: baseline;
  }
  .pal + .pal { margin-top: calc(var(--r) * 2.5); }

  .pal-who { grid-column: 1; }

  .pal-name {
    font-size: 1rem;
    font-weight: 600;
    line-height: var(--lh-body);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .pal-role {
    font-size: 0.75rem;
    line-height: calc(var(--r) * 0.75);
    letter-spacing: 0.06em;
    color: var(--quiet);
    margin-top: calc(var(--r) * 0.25);
  }

  .pal-desc {
    grid-column: 2 / -1;
    font-size: var(--t-body);
    line-height: var(--lh-body);
    color: var(--mid);
    max-width: var(--measure);
  }

  /* ---------- whisper metadata: the projects a friend is on ---------- */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: calc(var(--r) * 0.25) var(--r);
    margin-top: var(--r);
    font-size: 0.75rem;
    line-height: calc(var(--r) * 0.75);
    letter-spacing: 0.04em;
    color: var(--quiet);
  }
  .tag { color: var(--quiet); }
  a.tag {
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: color var(--hover-on, 0.2s) ease, border-color var(--hover-on, 0.2s) ease;
  }
  a.tag:hover { color: var(--ink); border-bottom-color: var(--ink); }

  /* ---------- links ---------- */
  .page a { color: inherit; text-decoration: none; }
  .page a:visited { color: inherit; }

  .mate-name a,
  .pal-name a {
    border-bottom: 1px solid var(--hair);
    transition: border-color var(--hover-on, 0.2s) ease;
  }
  .mate-name a:hover,
  .pal-name a:hover { border-bottom-color: var(--ink); }

  .ext {
    display: inline-block;
    margin-left: 0.3em;
    font-size: 0.7em;
    color: #bbb;
    vertical-align: 0.15em;
  }

  .page a:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }

  /* ================= the grid narrows; the rhythm does not =================
     --r never changes, so the page keeps its air at every width; only the
     number of columns redraws. */
  @media (max-width: 1000px) {
    .mates { grid-template-columns: repeat(2, 1fr); }
    .pal { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 700px) {
    .page {
      padding-top: calc(var(--r) * 2.5);
      padding-bottom: calc(var(--r) * 2.5);
    }
    .chapter { margin-bottom: calc(var(--r) * 2.5); }
    .block + .block { margin-top: calc(var(--r) * 3.5); }
    .label { margin-bottom: calc(var(--r) * 1.75); }

    .mates { grid-template-columns: 1fr; row-gap: calc(var(--r) * 2.5); }
    .mate-photo { aspect-ratio: 3 / 2; }

    .pal { grid-template-columns: 1fr; row-gap: var(--r); }
    .pal-who,
    .pal-desc { grid-column: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .page a,
    a.tag { transition: none; }
  }
</style>
