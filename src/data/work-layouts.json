  "e-motion": {
    "flow": [
      {
        "kind": "para",
        "body": "Puppet a video with your hand. Gather your fingers to a bud, then open like petals. An ongoing series of sketches that explore movement and emotion in connection to each other.\n\nMediaPipe HandLandmarker reads the hand live; how far the fingers spread scrubs a pre-rendered frame sequence, smoothed through a One Euro filter so the bloom follows the hand without jitter. The stage is phone-shaped, with the raw mirrored self-view kept in the corner.",
        "pos": "pw-l"
      },
      {
        "kind": "plate",
        "pos": "m-s",
        "media": {
          "type": "video",
          "src": "/clips/cut-9b.mp4"
        }
      }
    ]
  },
