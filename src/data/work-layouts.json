  "ai-quit": {
    "flow": [
      {
        "kind": "para",
        "body": "The great harrowing escape from the capitalistic grasp of the toaster factory — you're a tiny robot, the guards are watching, and the exit is very far away. \nMade in unity as a part of 6 games in 6 months series.",
